# Cloudflare Pages / Netlify response headers for the static pages (Functions
# under /api set their own). No full CSP on purpose: pages load Leaflet, Chart.js
# and fonts from CDNs plus inline scripts, so a strict policy would need a
# per-page audit. frame-ancestors / X-Frame-Options stop clickjacking framing.
/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)
