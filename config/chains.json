{
  "_comment": "Brands for the stats Chains card: name -> case-insensitive regex on the venue name (metrics/explore.py). Anchored at the start so a word inside another name (Via Sparano, Subway Qianmen station) does not match.",
  "McDonald's": "^(mcdonald['’]?s|макдоналдс)",
  "KFC": "^kfc\\b",
  "Burger King": "^burger king",
  "Starbucks": "^starbucks",
  "Costa Coffee": "^costa coffee",
  "Pizza Hut": "^pizza hut",
  "Dodo Pizza": "^(dodo pizza|додо пицца)",
  "Hard Rock Cafe": "^hard rock caf",
  "Lido": "^(lido \\(лидо\\)|лидо)",
  "Puzata Hata": "^(puzata hata|пузата хата)",
  "Vkusno i tochka": "^vkusno i tochka",
  "IKEA": "^ikea\\b",
  "Decathlon": "^decathlon",
  "Lidl": "^lidl\\b",
  "Aldi": "^aldi\\b",
  "Carrefour": "^carrefour",
  "Auchan": "^(auchan|ашан)",
  "Kaufland": "^kaufland",
  "Spar": "^(spar|eurospar|interspar)\\b",
  "Żabka": "^(żabka|zabka)\\b",
  "Biedronka": "^biedronka",
  "7-Eleven": "^7[- ]?eleven",
  "Rossmann": "^rossmann",
  "Linella": "^linella",
  "Евроопт": "^(евроопт|evroopt)"
}
