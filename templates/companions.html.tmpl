<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Companions — Check-in Journal</title>
<meta name="description" content="Travel companions ranked by shared check-ins, with country breakdown and yearly social mix analytics. Solo vs together trends over time.">
<link rel="canonical" href="https://4sq.pages.dev/companions.html">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Check-in Journal">
<meta property="og:title" content="Companions — Check-in Journal">
<meta property="og:description" content="Travel companions ranked by shared check-ins, with country breakdown and yearly social mix analytics. Solo vs together trends over time.">
<meta property="og:url" content="https://4sq.pages.dev/companions.html">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Companions — Check-in Journal">
<meta name="twitter:description" content="Travel companions ranked by shared check-ins, with country breakdown and yearly social mix analytics. Solo vs together trends over time.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&family=DM+Sans:wght@400;600&family=DM+Mono&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/6.6.6/css/flag-icons.min.css" integrity="sha512-uvXdJud8WaOlQFjlz9B15Yy2Au/bMAvz79F7Xa6OakCl2jvQPdHD0hb3dEqZRdSwG4/sknePXlE7GiarwA/9Wg==" crossorigin="anonymous">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js" integrity="sha512-CQBWl4fJHWbryGE+Pc7UAxWMUMNMWzWxF4SQo9CgkJIN1kx6djDQZjh3Y8SZ1d+6I+1zze6Z7kHXO7q3UyZAWw==" crossorigin="anonymous"></script>
<link rel="stylesheet" href="{{SITE_CSS_LINK}}">
<style>
:root{--bg:#0c0e14;--card:#12141c;--card2:#181a24;--border:#222738;--text:#e0e2ec;--muted:#8b93a8;--gold:#e8b86d;--teal:#4ec9b0;}
body.light{--bg:#ddd8cf;--card:#f0ece3;--card2:#e5e0d7;--border:#aaa49a;--gold:#7a3e00;--teal:#155c58;--muted:#54576a;--text:#15172a;--text2:#373b58;}
body.light header{background:linear-gradient(160deg,#d6d1c8 0%,#dedad1 70%);}
body.light .side-nav{background:rgba(220,215,208,0.97);}
body.light .side-nav a:hover,body.light .side-nav button:hover{background:rgba(0,0,0,.08);}
body.light .heatmap-tooltip,body.light .map-status{background:rgba(220,215,208,0.97);}
body.light .card{box-shadow:0 2px 8px rgba(0,0,0,.10);}
body.light a{color:var(--teal);}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;}
.topnav{display:flex;align-items:center;gap:20px;padding:18px 56px;border-bottom:1px solid var(--border);background:var(--card);}
.topnav-logo{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--gold);text-decoration:none;}
.topnav a{font-family:'DM Mono',monospace;font-size:0.62rem;text-transform:uppercase;letter-spacing:0.14em;color:var(--muted);text-decoration:none;transition:color .2s;}
.topnav a:hover{color:var(--gold);}
.topnav-current{font-family:'DM Mono',monospace;font-size:0.62rem;text-transform:uppercase;letter-spacing:0.14em;color:var(--text);}
.gs-btn{font-family:'DM Mono',monospace;font-size:.60rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:7px 14px;cursor:pointer;display:flex;align-items:center;gap:7px;transition:all .2s;white-space:nowrap;}
.gs-btn:hover{border-color:var(--gold);color:var(--gold);}
.gs-btn kbd{font-family:'DM Mono',monospace;font-size:.52rem;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:3px;padding:1px 5px;letter-spacing:0;}
@media(max-width:520px){.gs-btn kbd{display:none;}}
.gs-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10000;backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding-top:16vh;}.gs-overlay.open{display:flex;}
.gs-modal{background:var(--card);border:1px solid var(--border);border-radius:14px;width:min(560px,92vw);overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.7);}
.gs-input-wrap{display:flex;align-items:center;gap:10px;padding:14px 18px;}
.gs-icon{font-size:1rem;color:var(--muted);}
.gs-input{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-family:'DM Sans',sans-serif;font-size:.95rem;}
.gs-input::placeholder{color:var(--muted);}
.gs-esc-hint{font-family:'DM Mono',monospace;font-size:.52rem;color:var(--muted);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:3px;padding:2px 6px;cursor:pointer;flex-shrink:0;}
.topnav a:visited{color:#4a5270;}
.topnav-logo:visited{color:#e8b86d;}
/* ── People strip (replaces the sticky sidebar that covered the log on phones) ── */
/* desktop: the avatars wrap onto a second row; phones: a swipeable row with no scrollbar */
.people{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 8px;padding:18px 40px 14px;border-bottom:1px solid var(--border);}
.more-btn{display:block;margin:12px auto 0;background:var(--card2);border:1px solid var(--border);border-radius:999px;padding:8px 18px;font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.08em;color:var(--text);cursor:pointer;}
.more-btn:hover{border-color:var(--gold);color:var(--gold);}
.si{display:flex;flex-direction:column;align-items:center;gap:6px;min-width:76px;max-width:76px;cursor:pointer;padding:6px 2px;border-radius:14px;transition:background .15s;}
.si:hover{background:var(--card2);}
.si-av{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;font-family:'Playfair Display',serif;font-weight:900;font-size:1.15rem;color:#1a1206;position:relative;}
.si-av .si-flag{position:absolute;right:-3px;bottom:-3px;font-size:.8rem;line-height:1;font-family:'Noto Color Emoji','Apple Color Emoji','Segoe UI Emoji',sans-serif;}
.si.active .si-av{box-shadow:0 0 0 3px var(--bg),0 0 0 5px var(--gold);}
.si-name{font-size:.68rem;font-weight:600;color:var(--text);max-width:72px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.si-cnt{font-size:.58rem;font-family:'DM Mono',monospace;color:var(--muted);}
.main{padding:28px 40px 20px;max-width:1300px;margin:0 auto;}
/* ── Profile ── */
.pf-hero{display:flex;gap:20px;align-items:center;margin-bottom:22px;}
.pf-av{width:92px;height:92px;border-radius:50%;display:grid;place-items:center;font-family:'Playfair Display',serif;font-weight:900;font-size:2.5rem;color:#1a1206;flex-shrink:0;box-shadow:0 0 0 6px rgba(255,154,107,.12),0 18px 50px rgba(255,111,174,.22);}
.pf-eyebrow{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);}
.person-name{font-family:'Playfair Display',serif;font-size:clamp(2.2rem,5vw,3.6rem);font-weight:900;line-height:1;color:var(--text);text-decoration:none;display:inline-block;margin-top:6px;}
a.person-name:hover{color:var(--gold);}
.person-meta{font-size:0.8rem;color:var(--muted);margin-top:8px;}
.pf-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:14px;}
.pf-kpi{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:16px 18px;}
.pf-kpi b{display:block;font-family:'Playfair Display',serif;font-size:2rem;font-weight:900;line-height:1;background:linear-gradient(135deg,#f6d38b,#ff9a6b 55%,#ff6fae);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.pf-kpi:nth-child(2) b{background:linear-gradient(135deg,#4cb8ff,#9b7bff);-webkit-background-clip:text;background-clip:text;}
.pf-kpi:nth-child(3) b{background:linear-gradient(135deg,#2fd6b5,#4cb8ff);-webkit-background-clip:text;background-clip:text;}
.pf-kpi span{display:block;font-family:'DM Mono',monospace;font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:8px;}
.bento{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;}
.box{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:20px;min-width:0;}
.box h3{font-family:'DM Mono',monospace;font-weight:400;font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:14px;}
.s2{grid-column:span 2}.s3{grid-column:span 3}.s4{grid-column:span 4}.s6{grid-column:span 6}
.pf-bars{display:flex;align-items:flex-end;gap:5px;height:150px;}
.pf-bar{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:5px;min-width:0;}
.pf-bar i{display:block;width:100%;max-width:34px;border-radius:7px 7px 3px 3px;background:linear-gradient(180deg,#f6d38b,#ff9a6b 60%,#ff6fae);}
.pf-bar .v{font-family:'DM Mono',monospace;font-size:.5rem;color:var(--muted);}
.pf-bar .l{font-family:'DM Mono',monospace;font-size:.54rem;color:var(--muted);text-align:center;line-height:1.2;}
.pf-date{font-family:'Playfair Display',serif;font-weight:900;font-size:2.3rem;line-height:1;background:linear-gradient(135deg,#4cb8ff,#9b7bff);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.pf-date.l{background:linear-gradient(135deg,#f6d38b,#ff9a6b 55%,#ff6fae);-webkit-background-clip:text;background-clip:text;}
.pf-where{font-size:.8rem;color:var(--muted);margin:6px 0 18px;}
.pf-where a{color:var(--text);text-decoration:none;}.pf-where a:hover{color:var(--gold);}
.tv{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:12px;align-items:center;padding:7px 0;color:var(--text);text-decoration:none;}
.tv+.tv{border-top:1px solid var(--border);}
.tv img,.tv .ph0{width:44px;height:44px;border-radius:12px;object-fit:cover;background:var(--card2);}
.tv:hover .tvn{color:var(--gold);}
.tvn{font-size:.86rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.tvc{font-size:.7rem;color:var(--muted);}
.tv b{font-family:'DM Mono',monospace;font-weight:400;font-size:.72rem;color:var(--gold);}
.heat .hr{display:grid;grid-template-columns:14px repeat(24,minmax(0,1fr));gap:2px;margin-bottom:2px;align-items:center;}
.heat .hr span,.hx span{font-family:'DM Mono',monospace;font-size:.5rem;color:var(--muted);}
.heat i{display:block;aspect-ratio:1;border-radius:3px;background:#9b7bff;}
.hx{display:grid;grid-template-columns:14px repeat(24,minmax(0,1fr));gap:2px;}
.pf-cities{display:flex;flex-wrap:wrap;gap:6px;}
.pf-chip{display:inline-flex;align-items:center;gap:6px;font-family:'DM Mono',monospace;font-size:.6rem;padding:4px 9px;border-radius:999px;background:var(--card2);color:var(--text);white-space:nowrap;}
.pf-chip b{font-weight:400;color:var(--gold);}
.tgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;}
.tt{position:relative;display:block;border-radius:16px;overflow:hidden;aspect-ratio:16/10;background:linear-gradient(135deg,#4cb8ff,#9b7bff);text-decoration:none;color:#fff;}
.tt img{width:100%;height:100%;object-fit:cover;transition:transform .5s;}
.tt:hover img{transform:scale(1.05);}
.tts{position:absolute;left:0;right:0;bottom:0;padding:12px;background:linear-gradient(transparent,rgba(9,11,16,.92));}
.ttn{font-family:'Playfair Display',serif;font-weight:900;font-size:1rem;color:#fff;}
.ttd{font-family:'DM Mono',monospace;font-size:.55rem;color:#f0c27a;letter-spacing:.08em;margin-top:3px;}
.strip{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;}
.strip img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:12px;cursor:pointer;background:var(--card2);transition:opacity .2s;}
.strip img:hover{opacity:.85;}
.log-btn{display:flex;justify-content:space-between;align-items:center;width:100%;background:var(--card2);border:1px solid var(--border);border-radius:16px;padding:14px 18px;font-size:.86rem;color:var(--text);cursor:pointer;font-family:'DM Sans',sans-serif;}
.log-btn b{font-family:'DM Mono',monospace;font-weight:400;font-size:.62rem;color:var(--gold);letter-spacing:.12em;}
.log{display:none;margin-top:14px;}.log.open{display:block;}
#pfLight{display:none;position:fixed;inset:0;background:rgba(0,0,0,.93);z-index:9999;align-items:center;justify-content:center;}
#pfLight.open{display:flex;}
#pfLight img{max-width:92vw;max-height:84vh;object-fit:contain;border-radius:6px;}
#pfLight .cap{position:absolute;bottom:22px;left:0;right:0;text-align:center;font-size:.78rem;color:rgba(255,255,255,.75);padding:0 60px;}
#pfLight button{position:absolute;background:none;border:none;color:#fff;font-size:2rem;cursor:pointer;opacity:.6;padding:16px 22px;}
#pfLight button:hover{opacity:1;}
body.light .si.active .si-av{box-shadow:0 0 0 3px var(--bg),0 0 0 5px var(--gold);}
@media(max-width:900px){.bento{grid-template-columns:repeat(2,minmax(0,1fr));}.s2,.s3,.s4,.s6{grid-column:span 2;}.tgrid{grid-template-columns:repeat(2,minmax(0,1fr));}.strip{grid-template-columns:repeat(4,minmax(0,1fr));}.pf-kpis{grid-template-columns:repeat(2,minmax(0,1fr));}}
.search-row{display:flex;gap:10px;align-items:center;margin:18px 0;}
.search-box{background:var(--card2);border:1px solid var(--border);border-radius:8px;padding:8px 14px;color:var(--text);font-size:0.82rem;outline:none;width:260px;}
.search-box:focus{border-color:var(--gold);}
.shown-count{font-size:.75rem;color:var(--muted);}
table{width:100%;border-collapse:collapse;}
th{font-size:0.65rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:0 12px 10px;text-align:left;border-bottom:1px solid var(--border);}
td{padding:9px 12px;font-size:0.80rem;border-bottom:1px solid rgba(34,39,56,.45);vertical-align:middle;}
tr:hover td{background:rgba(255,255,255,.02);}
.ci-date{font-family:'DM Mono',monospace;font-size:0.72rem;color:var(--muted);white-space:nowrap;}
.ci-time{font-family:'DM Mono',monospace;font-size:0.67rem;color:var(--muted);opacity:.65;}
.ci-venue a{color:var(--text);text-decoration:none;font-weight:600;}
.ci-venue a:hover{color:var(--gold);}
.ci-cat{font-size:0.68rem;color:var(--teal);text-transform:uppercase;letter-spacing:.04em;margin-top:2px;}
.person-name[href]{text-decoration:none;color:var(--gold);}.person-name[href]:hover{opacity:.8;}.ci-loc{font-size:0.72rem;color:var(--muted);font-family:"Noto Color Emoji","Apple Color Emoji","Segoe UI Emoji",'DM Sans',sans-serif;}
@media(max-width:700px){
  header{padding:16px 16px 12px;}
  .people{flex-wrap:nowrap;justify-content:flex-start;overflow-x:auto;scrollbar-width:none;scroll-snap-type:x proximity;padding:14px 12px 10px;
          -webkit-mask-image:linear-gradient(90deg,#000 85%,transparent);mask-image:linear-gradient(90deg,#000 85%,transparent);}
  .people::-webkit-scrollbar{display:none;}
  .si{scroll-snap-align:start;}
  .main{padding:16px 14px;}
  .search-box{width:100%;max-width:100%;}
  .pf-av{width:68px;height:68px;font-size:1.9rem;}
  .pf-hero{gap:14px;}
  .tgrid{grid-template-columns:1fr;}
  .strip{grid-template-columns:repeat(3,minmax(0,1fr));}
  .pf-bars{gap:2px;}.pf-bar .v{display:none;}
  .heat .hr,.hx{gap:1px;}
  td,th{padding:7px 8px;font-size:.76rem;}
  .ci-date,.ci-time{font-size:.64rem;}
}
@media(max-width:480px){
  table{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch;}
  td,th{padding:6px 8px;font-size:.72rem;}
  .ci-loc{display:none;}
}

/* ── SOCIAL ANALYTICS SECTION ── */
.sa-section{padding:32px 40px 72px;}
.sa-section h2{font-family:'Playfair Display',serif;font-size:clamp(1.6rem,3vw,2.4rem);font-weight:900;background:linear-gradient(130deg,#f5d48a 0%,#e8b86d 45%,#b97c30 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:24px;}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:1500px;}
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:26px 30px;position:relative;overflow:hidden;}
.card::after{content:'';position:absolute;top:0;left:24px;right:24px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0.35;}
.card.full{grid-column:1/-1;}
.card-title{font-family:'DM Mono',monospace;font-size:0.62rem;text-transform:uppercase;letter-spacing:0.2em;color:var(--gold);margin-bottom:18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.card-title em{opacity:0.5;font-style:normal;}
.section-insight{display:block;font-family:'DM Sans',sans-serif;font-size:0.82rem;color:var(--muted);font-style:italic;margin-top:-10px;margin-bottom:14px;line-height:1.5;}
.social-kpi-row{display:flex;gap:10px;margin-bottom:16px;}
.social-kpi{flex:1;background:var(--card2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;}
.social-kpi .sk-num{font-family:'DM Mono',monospace;font-size:1.2rem;}
.social-kpi .sk-lbl{font-size:.58rem;color:var(--muted);margin-top:2px;}
.cc-list{display:flex;flex-direction:column;gap:5px;}
.cc-row{display:grid;grid-template-columns:1fr auto;align-items:center;gap:12px;padding:8px 12px;background:var(--card2);border:1px solid var(--border);border-radius:7px;}
.cc-name{font-size:.78rem;color:var(--text);}
.cc-flags{display:flex;gap:5px;align-items:center;flex-wrap:wrap;justify-content:flex-end;}
@media(max-width:900px){
  .sa-section{padding:20px 16px 48px;}
  .grid{grid-template-columns:1fr;gap:14px;}
  .card{padding:18px 18px;}
  .card.full{grid-column:1;}
  .social-kpi-row{gap:8px;}
  .cc-row{gap:8px;}
}
@media(max-width:520px){
  .social-kpi-row{flex-wrap:wrap;}
  .social-kpi{min-width:calc(50% - 5px);}
  .social-kpi .sk-num{font-size:1rem;}
  .cc-row{grid-template-columns:1fr;gap:5px;}
  .cc-flags{justify-content:flex-start;}
}
</style>
</head>
<body>
<nav class="topnav">
  <a href="index.html" class="topnav-logo">Check-in Journal</a>
  <span class="topnav-current">Companions</span>
  <a href="#social-analytics" style="margin-left:auto;">Social Analytics ↓</a>
  <button class="gs-btn" onclick="gsOpen()"><span>⌕</span> Search<kbd>⌘K</kbd></button>
</nav>
<div class="gs-overlay" id="gsOverlay" onclick="if(event.target===this)gsClose()">
  <div class="gs-modal"><div class="gs-input-wrap"><span class="gs-icon">⌕</span><input class="gs-input" id="gsInput" type="text" placeholder="Search venues, cities, trips…" autocomplete="off" spellcheck="false"><span class="gs-esc-hint" onclick="gsClose()">esc</span></div></div>
</div>
<h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">Companions</h1>
<div class="people" id="sidebar"></div>
<div class="main" id="main"></div>
<div id="pfLight" onclick="if(event.target===this)pfClose()">
  <img id="pfImg" src="" alt="">
  <button style="left:0;top:50%;transform:translateY(-50%)" aria-label="Previous" onclick="pfStep(-1)">&#8592;</button>
  <button style="right:0;top:50%;transform:translateY(-50%)" aria-label="Next" onclick="pfStep(1)">&#8594;</button>
  <button style="top:8px;right:8px;font-size:1.4rem" aria-label="Close" onclick="pfClose()">&#10005;</button>
  <div class="cap" id="pfCap"></div>
</div>
<script>
const COMP=COMP_DATA_PLACEHOLDER;
const TRIPS_LITE=TRIPS_LITE_PLACEHOLDER;   // [id, name, start_ts, end_ts, cover]
const PIX=PIX_URL_PLACEHOLDER;

// Country → flag emoji map (inline, no fetch needed)
const F={
  'Albania':'🇦🇱','Andorra':'🇦🇩','Armenia':'🇦🇲','Australia':'🇦🇺','Austria':'🇦🇹',
  'Azerbaijan':'🇦🇿','Bahrain':'🇧🇭','Bangladesh':'🇧🇩','Belarus':'🇧🇾','Belgium':'🇧🇪',
  'Bolivia':'🇧🇴','Bosnia and Herzegovina':'🇧🇦','Brazil':'🇧🇷','Brunei':'🇧🇳',
  'Bulgaria':'🇧🇬','Cambodia':'🇰🇭','Canada':'🇨🇦','Chile':'🇨🇱','China':'🇨🇳',
  'Colombia':'🇨🇴','Costa Rica':'🇨🇷','Croatia':'🇭🇷','Cuba':'🇨🇺','Cyprus':'🇨🇾',
  'Czechia':'🇨🇿','Czech Republic':'🇨🇿','Denmark':'🇩🇰','Ecuador':'🇪🇨','Egypt':'🇪🇬',
  'El Salvador':'🇸🇻','Estonia':'🇪🇪','Ethiopia':'🇪🇹','Finland':'🇫🇮','France':'🇫🇷',
