// flag-icons, not emoji flags: Windows renders regional-indicator emoji as two letters
const ISO2F={{CTRY_CODE_JSON}};
function flag(c){const k=ISO2F[(c||'').trim()];return k?`<span class="fi fi-${k}" style="border-radius:2px"></span>`:(F[c]||'🌍');}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
let cur=0;

// c[4] = home country: config/companion_countries.json, else the country most
// shared check-ins are in (computed in gen_companions.companion_country).
const compFlag=COMP.map(c=>c[4]?flag(c[4]):'🌍');
const GRAD=['linear-gradient(135deg,#f6d38b,#ff9a6b 55%,#ff6fae)','linear-gradient(135deg,#4cb8ff,#9b7bff)','linear-gradient(135deg,#2fd6b5,#4cb8ff)',
            'linear-gradient(135deg,#ff6fae,#9b7bff)','linear-gradient(135deg,#b8e65c,#2fd6b5)','linear-gradient(135deg,#ff7a6b,#f6c25b)'];
const initial=n=>[...String(n).trim()][0]||'?';
document.getElementById('sidebar').innerHTML=COMP.map((c,i)=>
  `<div class="si" id="si${i}" onclick="show(${i})" title="${esc(c[0])} · ${c[1].toLocaleString()} check-ins together">`+
  `<span class="si-av" style="background:${GRAD[i%GRAD.length]}">${esc(initial(c[0]))}<span class="si-flag">${compFlag[i]}</span></span>`+
  `<span class="si-name">${esc(c[0])}</span><span class="si-cnt">${c[1].toLocaleString()}</span></div>`
).join('');

function buildRows(ci){
  return ci.map(r=>{
    const [ts,date,time,venue,city,country,cat,vid]=r;
    const loc=[city,country].filter(Boolean);
    const locHtml=loc.length?`${flag(country)} ${esc(loc.join(', '))}`:'';
    const vname=vid?`<a href="/venue.html#${vid}">${esc(venue||'—')}</a>`:esc(venue||'—');
    return `<tr><td><div class="ci-date">${date}</div><div class="ci-time">${time}</div></td>`+
      `<td><div class="ci-venue">${vname}</div><div class="ci-cat">${esc(cat)}</div></td>`+
      `<td class="ci-loc">${locHtml}</td></tr>`;
  }).join('')||'<tr><td colspan="3" style="text-align:center;padding:40px;color:var(--muted)">No results</td></tr>';
}

function filterRows(q){
  const [,,all]=COMP[cur];
  const ql=(q||'').toLowerCase();
  const ci=ql?all.filter(r=>(r[3]||'').toLowerCase().includes(ql)||(r[4]||'').toLowerCase().includes(ql)||(r[5]||'').toLowerCase().includes(ql)||(r[6]||'').toLowerCase().includes(ql)):all;
  const bodyEl=document.getElementById('compBody');
  if(bodyEl)bodyEl.innerHTML=buildRows(ci);
  const shownEl=document.getElementById('compShown');
  if(shownEl)shownEl.textContent=ci.length.toLocaleString()+' shown';
}

// ── Photo lightbox for the profile's photo strip ──
let PF_GAL=[], pfIdx=0;
function pfShow(){const g=PF_GAL[pfIdx];if(!g)return;document.getElementById('pfImg').src=g.src;document.getElementById('pfCap').textContent=(pfIdx+1)+' / '+PF_GAL.length+' · '+g.cap;}
function pfOpen(k){pfIdx=k;pfShow();document.getElementById('pfLight').classList.add('open');}
function pfClose(){document.getElementById('pfLight').classList.remove('open');document.getElementById('pfImg').src='';}
function pfStep(d){if(PF_GAL.length){pfIdx=(pfIdx+d+PF_GAL.length)%PF_GAL.length;pfShow();}}
document.addEventListener('keydown',e=>{if(!document.getElementById('pfLight').classList.contains('open'))return;if(e.key==='ArrowLeft')pfStep(-1);else if(e.key==='ArrowRight')pfStep(1);else if(e.key==='Escape')pfClose();});
function toggleLog(){const l=document.getElementById('compLog');l.classList.toggle('open');document.getElementById('logLbl').textContent=l.classList.contains('open')?'HIDE THE LOG ▴':'OPEN THE LOG ▾';}

let TOGETHER=[];
const tripTile=([t,k])=>`<a class="tt" href="/trips.html#trip-${t[0]}">${t[4]&&PIX?`<img loading="lazy" src="${esc(PIX+'/'+t[4])}" alt="">`:''}<div class="tts"><div class="ttn">${esc(t[1])}</div><div class="ttd">${dUTC(t[2]).toISOString().slice(0,7)} · ${k} check-ins together</div></div></a>`;
const photoTile=(g,k)=>`<img loading="lazy" src="${esc(g.src)}" alt="" onclick="pfOpen(${k})">`;
function moreTrips(){document.getElementById('pfTrips').innerHTML=TOGETHER.map(tripTile).join('');document.getElementById('pfTripsMore').remove();}
function morePhotos(){
  const s=document.getElementById('pfStrip'),n=s.children.length;
  s.insertAdjacentHTML('beforeend',PF_GAL.slice(n,n+24).map((g,i)=>photoTile(g,n+i)).join(''));
  syncMore();
}
function syncMore(){
  const b=document.getElementById('pfMore');if(!b)return;
  const left=PF_GAL.length-document.getElementById('pfStrip').children.length;
  if(left<=0){b.remove();return;}
  b.textContent='LOAD '+Math.min(24,left)+' MORE · '+left.toLocaleString()+' LEFT ▾';
}
const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const dUTC=ts=>new Date(ts*1000);
const dShort=ts=>{const d=dUTC(ts);return String(d.getUTCDate()).padStart(2,'0')+'.'+String(d.getUTCMonth()+1).padStart(2,'0')+'.'+String(d.getUTCFullYear()).slice(2);};
const topN=(arr,key,n)=>{const m=new Map();arr.forEach(r=>{const k=key(r);if(k==null)return;const e=m.get(k)||{n:0,r};e.n++;m.set(k,e);});return [...m.entries()].sort((a,b)=>b[1].n-a[1].n).slice(0,n);};

// A companion opens as a profile — years, places, rhythm, trips, photos — with
// the full searchable log one tap away (it used to be the whole page).
function show(idx){
  cur=idx;
  document.querySelectorAll('.si').forEach(e=>e.classList.remove('active'));
  const el=document.getElementById('si'+idx);
  el.classList.add('active');
  el.scrollIntoView({block:'nearest',inline:'center'});
  history.replaceState(null,'','?person='+encodeURIComponent(COMP[idx][0]));
  const [name,count,all,uid]=COMP[cur];
  const ts=all.map(r=>r[0]), first=Math.min(...ts), last=Math.max(...ts);
  const firstRow=all.find(r=>r[0]===first), lastRow=all.find(r=>r[0]===last);
  const venueLink=r=>r[7]?`<a href="/venue.html#${esc(r[7])}">${esc(r[3]||'—')}</a>`:esc(r[3]||'—');
  // by year, or by month for a companionship shorter than three calendar years
  const y0=dUTC(first).getUTCFullYear(), y1=dUTC(last).getUTCFullYear();
  let bars='', byLbl;
  if(y1-y0<2){
    byLbl='by month';
    const m0=y0*12+dUTC(first).getUTCMonth(), m1=y1*12+dUTC(last).getUTCMonth(), cnt=new Array(m1-m0+1).fill(0);
    ts.forEach(t=>{const d=dUTC(t);cnt[d.getUTCFullYear()*12+d.getUTCMonth()-m0]++;});
    const mx=Math.max(...cnt);
    bars=cnt.map((v,i)=>{const m=(m0+i)%12,y=Math.floor((m0+i)/12);return `<div class="pf-bar" title="${MON[m]} ${y}: ${v}"><span class="v">${v||''}</span><i style="height:${Math.max(3,Math.round(120*v/mx))}px"></i><span class="l">${MON[m][0]}${m===0||i===0?'<br>'+String(y).slice(2):''}</span></div>`;}).join('');
  }else{
    byLbl='by year';
    const cnt={};ts.forEach(t=>{const y=dUTC(t).getUTCFullYear();cnt[y]=(cnt[y]||0)+1;});
    const mx=Math.max(...Object.values(cnt));
    for(let y=y0;y<=y1;y++){const v=cnt[y]||0;bars+=`<div class="pf-bar" title="${y}: ${v}"><span class="v">${v||''}</span><i style="height:${Math.max(3,Math.round(120*v/mx))}px"></i><span class="l">${String(y).slice(2)}</span></div>`;}
  }
  // places with a thumbnail from a shared check-in there
  const places=topN(all,r=>r[7]||r[3],6).map(([k,e])=>{
    const ph=(all.find(r=>(r[7]||r[3])===k&&r[8])||[])[8];
    const inner=`${ph&&PIX?`<img loading="lazy" src="${esc(PIX+'/'+ph)}" alt="">`:'<span class="ph0"></span>'}<div><div class="tvn">${esc(e.r[3]||'—')}</div><div class="tvc">${esc(e.r[4]||e.r[5]||'')}</div></div><b>${e.n}×</b>`;
    return e.r[7]?`<a class="tv" href="/venue.html#${esc(e.r[7])}">${inner}</a>`:`<div class="tv">${inner}</div>`;
  }).join('');
  // weekday × hour in the venue's local time (r[9] = weekday*24 + hour, Monday = 0)
  const heat=[...Array(7)].map(()=>new Array(24).fill(0));
  all.forEach(r=>{const k=r[9];if(k>=0&&k<168)heat[Math.floor(k/24)][k%24]++;});
  const hmax=Math.max(1,...heat.flat());
  const heatHtml=heat.map((row,d)=>`<div class="hr"><span>${'MTWTFSS'[d]}</span>${row.map(v=>`<i style="opacity:${(0.08+0.92*Math.pow(v/hmax,.6)).toFixed(2)}" title="${v}"></i>`).join('')}</div>`).join('')+
    `<div class="hx"><span></span>${[...Array(24)].map((_,h)=>`<span>${h%6===0?h:''}</span>`).join('')}</div>`;
  const cities=topN(all,r=>r[4]?r[4]+'|'+r[5]:null,10).map(([k,e])=>`<span class="pf-chip">${flag(e.r[5])} ${esc(e.r[4])} <b>${e.n}</b></span>`).join('');
  const nCities=new Set(all.map(r=>r[4]).filter(Boolean)).size, nCtry=new Set(all.map(r=>r[5]).filter(Boolean)).size;
  // a trip counts as "together" only when the companion was really on it: at least 30% of the
  // trip's check-ins, and on 2+ different days of a multi-day trip — seeing someone off at the
  // bus station is a few shared check-ins on the first day, not a trip together
  const together=TRIPS_LITE.map(t=>{
    const inT=ts.filter(x=>x>=t[2]&&x<t[3]+43200), days=new Set(inT.map(x=>Math.floor(x/86400))).size;
    return [t,inT.length,days];
  }).filter(([t,k,days])=>k>=3&&k>=0.3*(t[5]||k)&&(t[6]<=1||days>=2)).sort((a,b)=>b[0][2]-a[0][2]);
  TOGETHER=together;
  const tripsHtml=together.slice(0,6).map(tripTile).join('');
  // every shared photo goes into the lightbox; the strip shows 12 and loads more in steps of 24
  PF_GAL=PIX?all.filter(r=>r[8]).map(r=>({src:PIX+'/'+r[8],cap:r[1]+' · '+(r[3]||'')})):[];
  const strip=PF_GAL.slice(0,12).map(photoTile).join('');
  const yrs=(last-first)/86400/365.25;
  const since=MON[dUTC(first).getUTCMonth()]+' '+dUTC(first).getUTCFullYear();
  document.getElementById('main').innerHTML=`
    <div class="pf-hero"><div class="pf-av" style="background:${GRAD[idx%GRAD.length]}">${esc(initial(name))}</div><div>
      <div class="pf-eyebrow">Companion · since ${since}</div>
      ${uid?`<a class="person-name" href="https://foursquare.com/user/${uid}" target="_blank" rel="noopener">${esc(name)}</a>`:`<div class="person-name">${esc(name)}</div>`}
    </div></div>
    <div class="pf-kpis">
      <div class="pf-kpi"><b>${count.toLocaleString()}</b><span>check-ins together</span></div>
      <div class="pf-kpi"><b>${yrs<1?Math.max(1,Math.round(yrs*12))+' mo':Math.round(yrs)+' yr'+(Math.round(yrs)===1?'':'s')}</b><span>since the first one</span></div>
      <div class="pf-kpi"><b>${nCities}</b><span>cities · ${nCtry} countr${nCtry===1?'y':'ies'}</span></div>
      <div class="pf-kpi"><b>${together.length}</b><span>trips together</span></div>
    </div>
    <div class="bento">
      <div class="box s4"><h3>Check-ins together ${byLbl}</h3><div class="pf-bars">${bars}</div></div>
      <div class="box s2"><h3>First &amp; latest</h3><div class="pf-date">${dShort(first)}</div><div class="pf-where">${venueLink(firstRow)}</div>
        <div class="pf-date l">${dShort(last)}</div><div class="pf-where" style="margin-bottom:0">${venueLink(lastRow)}</div></div>
      <div class="box s3"><h3>Your places</h3>${places}</div>
      <div class="box s3"><h3>When you meet · weekday × hour</h3><div class="heat">${heatHtml}</div><h3 style="margin-top:20px">Cities</h3><div class="pf-cities">${cities}</div></div>
      ${tripsHtml?`<div class="box s6"><h3>Trips together · ${together.length}</h3><div class="tgrid" id="pfTrips">${tripsHtml}</div>
        ${together.length>6?`<button class="more-btn" id="pfTripsMore" onclick="moreTrips()">SHOW ALL ${together.length} TRIPS ▾</button>`:''}</div>`:''}
      ${strip?`<div class="box s6"><h3>Photos from your check-ins together · ${PF_GAL.length.toLocaleString()}</h3><div class="strip" id="pfStrip">${strip}</div>
        ${PF_GAL.length>12?`<button class="more-btn" id="pfMore" onclick="morePhotos()"></button>`:''}</div>`:''}
      <div class="box s6" style="padding:12px"><button class="log-btn" onclick="toggleLog()"><span>All ${all.length.toLocaleString()} check-ins together, searchable</span><b id="logLbl">OPEN THE LOG ▾</b></button>
        <div class="log" id="compLog">
          <div class="search-row">
            <input class="search-box" type="text" placeholder="Search venues, cities…" oninput="filterRows(this.value)">
            <span class="shown-count" id="compShown">${all.length.toLocaleString()} shown</span>
          </div>
          <table><thead><tr><th>Date</th><th>Venue</th><th>Location</th></tr></thead>
          <tbody id="compBody">${buildRows(all)}</tbody></table>
        </div></div>
    </div>`;
  syncMore();
}
const p=new URLSearchParams(location.search).get('person');
let idx=0;
if(p){
  idx=COMP.findIndex(c=>c[0]===p);                                  // exact
  if(idx<0){                                                        // combined "A, B" string from one check-in — match first known person
    for(const part of p.split(',')){const t=part.trim();const j=COMP.findIndex(c=>c[0]===t);if(j>=0){idx=j;break;}}
  }
  if(idx<0){const pl=p.toLowerCase();idx=COMP.findIndex(c=>(c[0]||'').toLowerCase().includes(pl));}  // substring fallback
}
show(idx>=0?idx:0);
(function(){const _q=new URLSearchParams(location.search).get('q');if(_q&&!p){const ql=_q.toLowerCase();const fi=COMP.findIndex(c=>(c[0]||'').toLowerCase().includes(ql));if(fi>=0)show(fi);}})();
</script>

<!-- ── SOCIAL ANALYTICS ── -->
<div class="sa-section" id="social-analytics">
  <h2>Social Analytics</h2>
  <div class="grid">
    <div class="card">
      <div class="card-title">Solo vs Together</div>
      <span class="section-insight" id="insight-solo"></span>
      <div class="social-kpi-row" id="socialKpiRow"></div>
      <canvas id="soloGroupChart" height="200"></canvas>
    </div>

    <div class="card">
      <div class="card-title">Social Mix by Year <em>&middot; solo vs with others</em></div>
      <canvas id="socialYearChart" height="200"></canvas>
    </div>

    <div class="card full">
      <div class="card-title">Companion Countries <em>&middot; top countries visited with each person</em></div>
      <span class="section-insight" id="insight-companions"></span>
      <div class="cc-list" id="companionCountriesList"></div>
    </div>
  </div>
</div>

<script>
(function(){
  const SDATA=SOCIAL_STATS_PLACEHOLDER;
  if(!SDATA) return;

  // ── Section insight lines ─────────────────────────────────────────────────
  (function(){
    var svt = SDATA.solo_vs_group_totals || [0,0];
    var total = svt[0] + svt[1];
    var soloPct = total > 0 ? Math.round(svt[0] / total * 100) : 77;
    var withPct = 100 - soloPct;
    var el1 = document.getElementById('insight-solo');
    if (el1) el1.textContent = soloPct + '% of all check-ins were solo — '
      + withPct + '% had company. '
      + (soloPct > 70 ? 'An explorer who moves best alone.' : 'Equally at home solo or social.');

    var comp = SDATA.companions || [];
    var el2 = document.getElementById('insight-companions');
    if (el2 && comp.length) {
      var topName = comp[0][0] || '';
      var topCnt  = comp[0][1] || 0;
      el2.textContent = comp.length + ' companions tracked. '
        + (topName ? topName + ' leads with ' + topCnt.toLocaleString() + ' shared check-ins. ' : '')
        + 'Every name here is a shared memory.';
    }
  })();

  // ISO2 for flag icons
  const ISO2={{CTRY_CODE_JSON}};
  function flagHtml(country,size){
    const c=(country||'').trim();
    const code=ISO2[c];
    if(!code) return '';
    const sz=size||'1em';
    return `<span class="fi fi-${code}" style="font-size:${sz};border-radius:2px;vertical-align:middle;flex-shrink:0"></span>`;
  }

  Chart.defaults.color='#7a85a8';Chart.defaults.borderColor='#1e2335';
  Chart.defaults.font.family="'DM Mono',monospace";Chart.defaults.font.size=11;

  // ── Social Analytics ──────────────────────────────────────────────────────
  const tot=SDATA.solo_vs_group_totals;
  if(tot&&tot.length){
    const [solo,group]=tot, total=solo+group;
    if(total){
      const kpiRow=document.getElementById('socialKpiRow');
      if(kpiRow) kpiRow.innerHTML=[
        ['Solo check-ins',  solo.toLocaleString(),  'color:var(--gold)'],
        ['With others',     group.toLocaleString(), 'color:var(--teal)'],
        ['Together rate',   (group/total*100).toFixed(1)+'%', 'color:var(--teal)'],
      ].map(([lbl,num,style])=>`<div class="social-kpi"><div class="sk-num" style="${style}">${num}</div><div class="sk-lbl">${lbl}</div></div>`).join('');

      new Chart(document.getElementById('soloGroupChart'),{type:'doughnut',data:{
        labels:['Solo','With others'],
        datasets:[{data:[solo,group],backgroundColor:['rgba(232,184,109,.8)','rgba(78,205,196,.8)'],borderWidth:0,hoverOffset:6}]
      },options:{responsive:true,cutout:'68%',plugins:{legend:{position:'bottom',labels:{font:{size:11},boxWidth:12,padding:10}},tooltip:{callbacks:{label:ctx=>{const v=ctx.parsed;const pct=(v/(solo+group)*100).toFixed(1);return ` ${ctx.label}: ${v.toLocaleString()} (${pct}%)`;}}}}}});

      if(SDATA.solo_vs_group_by_year&&SDATA.solo_vs_group_by_year.length){
        const yrs=SDATA.solo_vs_group_by_year;
        const totals=yrs.map(([,s,g])=>s+g);
        new Chart(document.getElementById('socialYearChart'),{type:'bar',data:{
          labels:yrs.map(d=>d[0]),
          datasets:[
            {label:'Solo',       data:yrs.map(([,s,g],i)=>totals[i]?+(s/totals[i]*100).toFixed(1):0), backgroundColor:'rgba(232,184,109,.75)',borderWidth:0},
            {label:'With others',data:yrs.map(([,s,g],i)=>totals[i]?+(g/totals[i]*100).toFixed(1):0), backgroundColor:'rgba(78,205,196,.75)', borderWidth:0},
          ]
        },options:{responsive:true,plugins:{legend:{position:'bottom',labels:{font:{size:10},boxWidth:10,padding:8}},tooltip:{callbacks:{label:ctx=>` ${ctx.dataset.label}: ${ctx.parsed.y}%`}}},scales:{x:{stacked:true,grid:{display:false}},y:{stacked:true,grid:{color:'#1a1e2e'},ticks:{callback:v=>v+'%'},max:100}}}});
      }
    }
  }

  // ── Companion Countries ───────────────────────────────────────────────────
  const el=document.getElementById('companionCountriesList');
  if(el&&SDATA.companion_countries&&SDATA.companion_countries.length){
    el.innerHTML=SDATA.companion_countries.map(([name,cos])=>{
      const items=cos.map(([co,cnt])=>{
        const f=flagHtml(co,'1.05em');
        return `<span style="display:inline-flex;align-items:center;gap:3px;white-space:nowrap;font-size:.68rem;color:var(--muted)">${f}<span>${esc(co)}</span><span style="font-family:'DM Mono',monospace;color:var(--teal);font-size:.62rem">${cnt}</span></span>`;
      }).join('');
      return `<div class="cc-row" style="grid-template-columns:120px 1fr">
        <div class="cc-name">${esc(name)}</div>
        <div class="cc-flags" style="justify-content:flex-start;gap:8px;flex-wrap:wrap">${items}</div>
      </div>`;
    }).join('');
  }
})();
</script>
<script>
function gsOpen(){document.getElementById('gsOverlay').classList.add('open');document.getElementById('gsInput').focus();}
function gsClose(){document.getElementById('gsOverlay').classList.remove('open');}
document.getElementById('gsInput').addEventListener('keydown',function(e){if(e.key==='Enter'&&this.value.trim()){location.href='search.html?q='+encodeURIComponent(this.value.trim());}if(e.key==='Escape')gsClose();});
document.addEventListener('keydown',function(e){if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();gsOpen();}if(e.key==='Escape'&&document.getElementById('gsOverlay').classList.contains('open'))gsClose();});
</script>
