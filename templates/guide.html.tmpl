// ── Nearby For You: Overpass OSM + Leaflet map ──────────────────────────────
function initNearby() {
  const box = document.getElementById('nearbyBox');
  if (!LATEST_LL) {
    box.innerHTML = '<div class="empty-state"><h3>No location data</h3><p>Check in somewhere to see nearby suggestions</p></div>';
    return;
  }
  const lat = +LATEST.lat, lng = +LATEST.lng;
  let RADIUS = +(localStorage.getItem('guide-radius') || 1500);
  let _unvisitedOnly = localStorage.getItem('guide-unvisited') === '1';

  // Anchor header
  const anchorRow = document.getElementById('nearbyAnchorRow');
  const anchorText = document.getElementById('nearbyAnchorText');
  anchorRow.style.display = '';
  const gAnchorUrl = `https://www.google.com/maps/@${lat},${lng},15z`;
  const yAnchorUrl = `https://yandex.com/maps/?ll=${lng},${lat}&z=15`;
  anchorText.innerHTML = `Near <strong>${esc(LATEST.venue)}</strong>, ${esc(LATEST.city)}`
    + ` &mdash; <a href="${gAnchorUrl}" target="_blank" rel="noopener" style="color:var(--teal)">Google Maps ↗</a>`
    + `&nbsp; <a href="${yAnchorUrl}" target="_blank" rel="noopener" style="color:var(--teal)">Yandex Maps ↗</a>`;

  // Radius buttons
  document.getElementById('nearbyRadiusGroup').addEventListener('click', e => {
    const btn = e.target.closest('[data-r]');
    if (!btn) return;
    RADIUS = +btn.dataset.r;
    localStorage.setItem('guide-radius', RADIUS);
    document.querySelectorAll('.nearby-radius-btn').forEach(b => b.classList.toggle('active', b === btn));
    document.getElementById('nearbySubtitle').textContent = `· ${RADIUS >= 1000 ? RADIUS/1000+' km' : RADIUS+' m'} radius · live OSM`;
    updateRadiusCircle();
    if (_activeCat) { _activeCat = null; selectCat(document.querySelector('.nearby-cat-pill.active')?.dataset.cat || _lastCat); }
  });

  // Unvisited toggle
  const uvBtn = document.getElementById('nearbyUnvisited');
  uvBtn.addEventListener('click', () => {
    _unvisitedOnly = !_unvisitedOnly;
    localStorage.setItem('guide-unvisited', _unvisitedOnly ? '1' : '0');
    uvBtn.classList.toggle('active', _unvisitedOnly);
    uvBtn.textContent = _unvisitedOnly ? '★ Unvisited only' : '☆ Unvisited only';
    if (_lastItems) applyFiltersAndRender(_lastItems, _lastCat);
  });
  // Restore persisted state visually
  if (_unvisitedOnly) { uvBtn.classList.add('active'); uvBtn.textContent = '★ Unvisited only'; }
  const savedRadiusBtn = document.querySelector(`.nearby-radius-btn[data-r="${RADIUS}"]`);
  if (savedRadiusBtn) {
    document.querySelectorAll('.nearby-radius-btn').forEach(b => b.classList.remove('active'));
    savedRadiusBtn.classList.add('active');
    document.getElementById('nearbySubtitle').textContent = `· ${RADIUS >= 1000 ? RADIUS/1000+' km' : RADIUS+' m'} radius · live OSM`;
  }

  // Haversine distance
  function distM(la1, lo1, la2, lo2) {
    const R = 6371000, r = Math.PI / 180;
    const dLa = (la2-la1)*r, dLo = (lo2-lo1)*r;
    const a = Math.sin(dLa/2)**2 + Math.cos(la1*r)*Math.cos(la2*r)*Math.sin(dLo/2)**2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  }
  function fmtDist(m) {
    if (m < 50) return '<50 m';
    if (m < 1000) return Math.round(m/10)*10 + ' m';
    return (m/1000).toFixed(2) + ' km';
  }

  const visitedNames = new Set((D.visited_names_in_city||[]).map(s=>s.toLowerCase()));

  function getOsmTags(cat) {
    const entry = D.osm_cat_map && D.osm_cat_map[cat];
    if (entry && Array.isArray(entry.osm) && entry.osm.length) return entry.osm;
    return null;
  }

  function buildOverpassQuery(tags) {
    const stanzas = tags.map(tag => {
      const i = tag.indexOf('=');
      const k = tag.slice(0, i), v = tag.slice(i+1);
      return `nwr["${k}"="${v}"](around:${RADIUS},${lat},${lng});`;
    }).join('');
    return `[out:json][timeout:25];(${stanzas});out center 100;`;
  }

  // Leaflet map
  let _map = null, _resultLayer = null, _radiusCircle = null;
  const youIcon = L.divIcon({
    className: '',
    html: '<div style="width:16px;height:16px;border-radius:50%;background:#e8b86d;border:3px solid #fff;box-shadow:0 0 6px rgba(0,0,0,.5)"></div>',
    iconSize: [16, 16], iconAnchor: [8, 8],
  });

  function ensureMap() {
    if (_map) return;
    _map = L.map('nearbyMapEl', { zoomControl: true, attributionControl: false }).setView([lat, lng], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(_map);
    L.marker([lat, lng], { icon: youIcon }).addTo(_map)
      .bindPopup(`<strong>${esc(LATEST.venue)}</strong><br><small>You are here</small>`);
    _radiusCircle = L.circle([lat, lng], { radius: RADIUS, color: '#4ec9b0', fill: false, weight: 1.5, dashArray: '4 4', opacity: 0.5 }).addTo(_map);
    _resultLayer = L.layerGroup().addTo(_map);
  }

  function updateRadiusCircle() {
    if (_radiusCircle) _radiusCircle.setRadius(RADIUS);
  }

  function updateMapMarkers(items) {
    ensureMap();
    _resultLayer.clearLayers();
    items.slice(0, 20).forEach(item => {
      const isVis = visitedNames.has(item.name.toLowerCase());
      // Name + coords → Google/Yandex resolve to the exact branch, not all places with this name
      const gUrl = `https://www.google.com/maps/search/${encodeURIComponent(item.name)}/@${item.lat},${item.lng},17z`;
      const yUrl = `https://yandex.com/maps/?text=${encodeURIComponent(item.name)}&ll=${item.lng},${item.lat}&z=17&sll=${item.lng},${item.lat}&sspn=0.01,0.005`;
      const osmUrl = `https://www.openstreetmap.org/${item.osm_type}/${item.osm_id}`;
      const marker = L.circleMarker([item.lat, item.lng], {
        radius: isVis ? 9 : 7,
        fillColor: isVis ? '#e8b86d' : '#4ec9b0',
        color: '#fff', weight: isVis ? 2.5 : 1.5, fillOpacity: 0.9,
      }).addTo(_resultLayer);
      marker.bindPopup(
        `<strong>${esc(item.name)}</strong>`
        + (isVis ? `&nbsp;<span style="font-size:.7em;color:#e8b86d">✓ visited</span>` : '')
        + (item.addr ? `<br><small>📍 ${esc(item.addr)}</small>` : '')
        + `<br><small>${fmtDist(item.d)}</small>`
        + `<br><a href="${gUrl}" target="_blank" rel="noopener" style="color:#4285f4">Google</a>`
        + `&nbsp;<a href="${yUrl}" target="_blank" rel="noopener" style="color:#ff4444">Yandex</a>`
        + `&nbsp;<a href="${osmUrl}" target="_blank" rel="noopener" style="color:#888">OSM</a>`
      );
    });
    const pts = [[lat, lng], ...items.slice(0, 20).map(i => [i.lat, i.lng])];
    if (pts.length > 1) _map.fitBounds(L.latLngBounds(pts), { padding: [30, 30], maxZoom: 16 });
  }

  // ── Category accordion ──────────────────────────────────────────────────────
  const CAT_GROUPS = [
    { icon: '☕', label: 'Coffee & Tea', cats: ['Coffee Shop','Café','Cafe, Coffee, and Tea House','Corporate Coffee Shop','Coffee Roaster','Tea Room','Bubble Tea Shop','Juice Bar','Smoothie Shop'] },
    { icon: '🥐', label: 'Bakery & Sweets', cats: ['Bakery','Pastry Shop','Donut Shop','Bagel Shop','Creperie','Blini House','Dessert Shop','Ice Cream Parlor','Gelato Shop','Candy Store','Pie Shop'] },
    { icon: '🍽️', label: 'Restaurants', cats: ['Restaurant','Bistro','Diner','Buffet','Cafeteria','Food Court','Breakfast Spot','Snack Place','BBQ Joint','Pizzeria','Pizza Place','Italian Restaurant','Japanese Restaurant','Sushi Restaurant','Ramen Restaurant','Noodle Restaurant','Dumpling Restaurant','Chinese Restaurant','Vietnamese Restaurant','Korean Restaurant','Thai Restaurant','Indian Restaurant','South Indian Restaurant','Asian Restaurant','Cambodian Restaurant','Tibetan Restaurant','Turkish Restaurant','Kebab Restaurant','Doner Restaurant','Shawarma Restaurant','Falafel Restaurant','Middle Eastern Restaurant','Greek Restaurant','Lebanese Restaurant','Syrian Restaurant','Israeli Restaurant','Egyptian Restaurant','Georgian Restaurant','Armenian Restaurant','Caucasian Restaurant','Eastern European Restaurant','Russian Restaurant','Ukrainian Restaurant','Belarusian Restaurant','Romanian Restaurant','Polish Restaurant','German Restaurant','French Restaurant','Spanish Restaurant','Portuguese Restaurant','Modern European Restaurant','Mexican Restaurant','Latin American Restaurant','Argentinian Restaurant','American Restaurant','Steakhouse','Steak House','Seafood Restaurant','Paella Restaurant','Tapas Restaurant','Vegan and Vegetarian Restaurant','Halal Restaurant','Kosher Restaurant','Comfort Food Restaurant','Tatar Restaurant','Yemeni Restaurant','Ethiopian Restaurant','African Restaurant','Scottish Restaurant','Shaanxi Restaurant'] },
    { icon: '🍔', label: 'Fast Food', cats: ['Fast Food Restaurant','Burger Joint','Sandwich Spot','Food Truck','Food Stand','Fried Chicken Joint','Fish and Chips Shop','Souvlaki Shop'] },
    { icon: '🍺', label: 'Bars & Nightlife', cats: ['Bar','Beer Bar','Beer Garden','Beach Bar','Pub','Irish Pub','Cocktail Bar','Wine Bar','Hotel Bar','Hookah Bar','Lounge','Dive Bar','Sports Bar','Gastropub','Karaoke Bar','Whisky Bar','Speakeasy','Rock Club','Brewery','Nightclub','Night Club','Wine Store','Liquor Store','Beer Store'] },
    { icon: '🛍️', label: 'Shopping', cats: ['Shopping Mall','Department Store','Clothing Store','Shoe Store','Electronics Store','Mobile Phone Store','Bookstore','Furniture and Home Store','Hardware Store','Bicycle Store','Cosmetics Store','Big Box Store','Sporting Goods Retail','Health Food Store','Flea Market','Vintage and Thrift Store','Grocery Store','Supermarket','Convenience Store','Gourmet Store','Farmers Market','Market','Food and Beverage Retail','Flower Store','Butcher','Currency Exchange','Eyecare Store','Tailor'] },
    { icon: '🚉', label: 'Transport', cats: ['Airport','International Airport','Airport Terminal','Metro Station','Rail Station','Tram Station','Light Rail Station','Bus Station','Bus Stop','Taxi','Parking','Fuel Station','Bike Rental','Boat or Ferry','Border Crossing','Cable Car'] },
    { icon: '🏨', label: 'Accommodation', cats: ['Hotel','Hostel','Bed and Breakfast','Inn','Apartment or Condo','Travel Lounge'] },
    { icon: '🌿', label: 'Outdoors', cats: ['Park','Plaza','Pedestrian Plaza','Beach','Mountain','Hiking Trail','Garden','Botanical Garden','Scenic Lookout','Waterfront','Lake','Forest','National Park','Nature Preserve','Campground','Ski Area','Sculpture Garden','Playground','Cemetery','Fountain','Lighthouse','Pier','Harbor or Marina'] },
    { icon: '🎭', label: 'Culture & Arts', cats: ['Museum','Art Museum','History Museum','Science Museum','Art Gallery','Monument','Historic and Protected Site','Castle','Palace','Theater','Concert Hall','Movie Theater','Cultural Center','Arts and Entertainment','Event Space','Amusement Park','Library','Memorial Site','Dance Studio','Exhibit'] },
    { icon: '⛪', label: 'Religious', cats: ['Church','Cathedral','Mosque','Synagogue','Temple','Monastery','Buddhist Temple','Hindu Temple','Shrine'] },
    { icon: '💪', label: 'Sports & Fitness', cats: ['Gym','Gym and Studio','Sports and Recreation','Spa','Bath House','Swimming Pool','Pool Hall','College Gym'] },
    { icon: '🏥', label: 'Health', cats: ['Medical Center','Pharmacy'] },
    { icon: '🏛️', label: 'Services', cats: ['Bank','Post Office','Police Station','City Hall','Government Building','University','Embassy or Consulate','Hair Salon','Education','College Library','College Arts Building','College Academic Building','Port'] },
  ];

  const pillsEl = document.getElementById('nearbyCatPills');
  const likedSet = new Set((D.top_liked_cats||[]).map(([c])=>c));
  const visitedCatSet = new Set();
  // Build visited set from user history
  (D.top_liked_cats||[]).forEach(([c]) => visitedCatSet.add(c));
  (D.all_categories||D.top_categories||[]).forEach(c => visitedCatSet.add(Array.isArray(c) ? c[0] : c));

  // Build accordion: ALL CAT_GROUPS shown — all children visible, visited ones highlighted
  // Remaining user-visited cats (not in any group) go to an "Other" group
  const assignedCats = new Set();
  let firstSelectCat = null;

  CAT_GROUPS.forEach(group => {
    const allCats = group.cats;
    if (!allCats.length) return;
    const visitedInGroup = allCats.filter(c => visitedCatSet.has(c));
    const hasLiked = allCats.some(c => likedSet.has(c));
    const autoOpen = hasLiked && !firstSelectCat;

    const groupEl = document.createElement('div');
    groupEl.className = 'cat-group' + (autoOpen ? ' open' : '');

    // Google/Yandex category browse links for this group
    const gCatUrl = `https://www.google.com/maps/search/${encodeURIComponent(group.label)}/@${lat},${lng},15z`;
    const yCatUrl = `https://yandex.com/maps/?text=${encodeURIComponent(group.label)}&ll=${lng},${lat}&z=15`;

    const header = document.createElement('button');
    header.className = 'cat-group-header';
    header.innerHTML = `<span class="cat-group-icon">${group.icon}</span>`
      + `<span class="cat-group-name">`
      + (hasLiked ? `<span class="cat-group-liked">❤</span>` : '')
      + esc(group.label)
      + `</span>`
      + (visitedInGroup.length
        ? `<span class="cat-group-visits">${visitedInGroup.length} visited</span>` : '')
      + `<span class="cat-group-count">${allCats.length}</span>`
      + `<span class="cat-group-arrow">▾</span>`;
    header.onclick = () => groupEl.classList.toggle('open');

    const body = document.createElement('div');
    body.className = 'cat-group-body';

    // Liked first → visited next → rest alphabetical
    const sorted = [...allCats].sort((a, b) => {
      const al = likedSet.has(a) ? 0 : visitedCatSet.has(a) ? 1 : 2;
      const bl = likedSet.has(b) ? 0 : visitedCatSet.has(b) ? 1 : 2;
      return al - bl || a.localeCompare(b);
    });
    sorted.forEach(cat => {
      const isLiked = likedSet.has(cat);
      const isVis = visitedCatSet.has(cat);
      const btn = document.createElement('button');
      btn.className = 'nearby-cat-pill'
        + (isLiked ? ' pill-liked-cat' : isVis ? ' pill-was-visited' : '');
      btn.dataset.cat = cat;
      btn.innerHTML = (isLiked ? '<span class="pill-liked">❤</span>' : '')
        + esc(cat)
        + (isVis && !isLiked ? '<span class="pill-dot" title="visited"></span>' : '');
      btn.onclick = () => selectCat(cat);
      body.appendChild(btn);
      assignedCats.add(cat);
      if (!firstSelectCat && (isLiked || autoOpen)) firstSelectCat = cat;
    });
    if (!firstSelectCat && sorted.length) firstSelectCat = sorted[0];

    // Category browse row at bottom of group body
    const browseRow = document.createElement('div');
    browseRow.style.cssText = 'width:100%;margin-top:6px;padding-top:6px;border-top:1px solid var(--border);display:flex;gap:6px;align-items:center;';
    browseRow.innerHTML = `<span style="font-size:.6rem;color:var(--muted);flex:1">Browse all ${esc(group.label)}:</span>`
      + `<a href="${gCatUrl}" target="_blank" rel="noopener" style="font-size:.62rem;padding:2px 7px;border-radius:4px;border:1px solid rgba(66,133,244,.35);color:#4285f4;text-decoration:none;">Google ↗</a>`
      + `<a href="${yCatUrl}" target="_blank" rel="noopener" style="font-size:.62rem;padding:2px 7px;border-radius:4px;border:1px solid rgba(255,80,80,.35);color:#ff6060;text-decoration:none;">Yandex ↗</a>`;
    body.appendChild(browseRow);

    groupEl.appendChild(header);
    groupEl.appendChild(body);
    pillsEl.appendChild(groupEl);
  });

  // "Other" group for user-visited categories not covered by any group above
  const otherCats = [...visitedCatSet].filter(c => !assignedCats.has(c));
  if (otherCats.length) {
    const groupEl = document.createElement('div');
    groupEl.className = 'cat-group';
    const header = document.createElement('button');
    header.className = 'cat-group-header';
    header.innerHTML = `<span class="cat-group-icon">📌</span>`
      + `<span class="cat-group-name">${esc('Other visited')}</span>`
      + `<span class="cat-group-count">${otherCats.length}</span>`
      + `<span class="cat-group-arrow">▾</span>`;
    header.onclick = () => groupEl.classList.toggle('open');
    const body = document.createElement('div');
    body.className = 'cat-group-body';
    otherCats.forEach(cat => {
      const btn = document.createElement('button');
      btn.className = 'nearby-cat-pill pill-was-visited';
      btn.dataset.cat = cat;
      btn.innerHTML = (likedSet.has(cat) ? '<span class="pill-liked">❤</span>' : '') + esc(cat);
      btn.onclick = () => selectCat(cat);
      body.appendChild(btn);
    });
    groupEl.appendChild(header); groupEl.appendChild(body);
    pillsEl.appendChild(groupEl);
  }

  // ── Overpass fetch ──────────────────────────────────────────────────────────
  const ENDPOINTS = [
    'https://overpass-api.de/api/interpreter',
    'https://overpass.kumi.systems/api/interpreter',
    'https://overpass.openstreetmap.fr/api/interpreter',
  ];
  let _activeCat = null, _lastCat = null, _lastItems = null, _busy = false;

  async function fetchNearby(cat) {
    if (_busy) return;
    _busy = true;
    _lastCat = cat;
    box.innerHTML = '<div class="nearby-loading">⏳ Fetching from OpenStreetMap…</div>';
    document.getElementById('nearbyResultCount').textContent = '';
    const tags = getOsmTags(cat);
    let q;
    if (tags) {
      q = buildOverpassQuery(tags);
    } else {
      const kw = cat.replace(/['"<>&]/g,'').split(/[\s/]/)[0].trim();
      q = `[out:json][timeout:25];(nwr["name"~"${kw}",i](around:${RADIUS},${lat},${lng}););out center 100;`;
    }
    let lastErr;
    for (const ep of ENDPOINTS) {
      try {
        const r = await fetch(ep, { method:'POST', body:'data='+encodeURIComponent(q) });
        if (!r.ok) { lastErr = new Error(`HTTP ${r.status}`); continue; }
        const d = await r.json();
        _lastItems = parseElements(d.elements||[]);
        applyFiltersAndRender(_lastItems, cat);
        _busy = false;
        return;
      } catch(e) { lastErr = e; }
    }
    box.innerHTML = `<div class="empty-state"><h3>Fetch error</h3>`
      + `<p>OSM Overpass unavailable &mdash; <a href="${yAnchorUrl}" target="_blank" rel="noopener" style="color:var(--teal)">open Yandex Maps ↗</a></p></div>`;
    _busy = false;
  }

  function parseElements(els) {
    const items = [];
    for (const el of els) {
      const elLat = el.lat ?? el.center?.lat;
      const elLng = el.lon ?? el.center?.lon;
      const name = el.tags?.name;
      if (!elLat || !elLng || !name) continue;
      const d = distM(lat, lng, elLat, elLng);
      const street = el.tags?.['addr:street'] || '';
      const num = el.tags?.['addr:housenumber'] || '';
      const addr = (street + (num ? ' '+num : '')).trim() || el.tags?.['addr:full'] || '';
      const opening = el.tags?.opening_hours || '';
      const website = el.tags?.website || el.tags?.['contact:website'] || '';
      const isVis = visitedNames.has(name.toLowerCase());
      items.push({ name, addr, opening, website, d, lat: elLat, lng: elLng, isVis,
        osm_type: el.type, osm_id: el.id });
    }
    items.sort((a,b) => a.d - b.d);
    return items;
  }

  function applyFiltersAndRender(items, cat) {
    const filtered = _unvisitedOnly ? items.filter(i => !i.isVis) : items;
    const countEl = document.getElementById('nearbyResultCount');
    countEl.textContent = filtered.length
      ? `${filtered.length} found · ${RADIUS >= 1000 ? RADIUS/1000+' km' : RADIUS+' m'}`
      : '';
    if (!filtered.length) {
      ensureMap();
      const radiusLabel = RADIUS >= 1000 ? (RADIUS/1000)+' km' : RADIUS+' m';
      box.innerHTML = `<div class="empty-state"><h3>Nothing found</h3>`
        + `<p>No <em>${esc(cat)}</em>${_unvisitedOnly ? ' (unvisited)' : ''} mapped within ${radiusLabel} in OSM.<br>`
        + `<a href="https://yandex.com/maps/?ll=${lng},${lat}&z=14&text=${encodeURIComponent(cat)}" `
        + `target="_blank" rel="noopener" style="color:var(--teal)">Search on Yandex Maps ↗</a></p></div>`;
      return;
    }
    updateMapMarkers(filtered);
    const visItems = filtered.slice(0, 20);
    box.innerHTML = '<div class="nearby-result-list">' + visItems.map(item => {
      // Name + coords → Google/Yandex resolve to the exact branch; OSM ID is a direct permalink
      const gUrl = `https://www.google.com/maps/search/${encodeURIComponent(item.name)}/@${item.lat},${item.lng},17z`;
      const yUrl = `https://yandex.com/maps/?text=${encodeURIComponent(item.name)}&ll=${item.lng},${item.lat}&z=17&sll=${item.lng},${item.lat}&sspn=0.01,0.005`;
      const osmUrl = `https://www.openstreetmap.org/${item.osm_type}/${item.osm_id}`;
      return `<div class="nearby-item${item.isVis ? ' visited' : ''}">`
        + `<div class="nearby-item-dist">${fmtDist(item.d)}</div>`
        + `<div class="nearby-item-body">`
        + `<div class="nearby-item-name">${esc(item.name)}`
        + (item.isVis ? `<span class="nearby-visited-badge">✓ visited</span>` : '')
        + `</div>`
        + (item.addr ? `<div class="nearby-item-addr">📍 ${esc(item.addr)}</div>` : '')
        + (item.opening ? `<div class="nearby-item-addr">🕐 ${esc(item.opening)}</div>` : '')
        + `<div class="nearby-item-links">`
        + `<a href="${gUrl}" class="nearby-item-link glink" target="_blank" rel="noopener">Google</a>`
        + `<a href="${yUrl}" class="nearby-item-link ylink" target="_blank" rel="noopener">Yandex</a>`
        + `<a href="${osmUrl}" class="nearby-item-link osmlink" target="_blank" rel="noopener">OSM</a>`
        + (item.website ? `<a href="${esc(item.website)}" class="nearby-item-link" target="_blank" rel="noopener">🌐</a>` : '')
        + `</div></div></div>`;
    }).join('') + '</div>';
  }

  function selectCat(cat) {
    if (!cat) return;
    if (cat === _activeCat && !_busy) return;
    _activeCat = cat;
    document.querySelectorAll('.nearby-cat-pill').forEach(p =>
      p.classList.toggle('active', p.dataset.cat === cat));
    fetchNearby(cat);
  }

  if (firstSelectCat) selectCat(firstSelectCat);
}

// ── Init ─────────────────────────────────────────────────────────────────────
try {
  renderTopCats();
  renderTopCities();
  renderTopCountries();
  renderLikedCats();
  renderVenueLinks();
  renderLatest();
  render48h();
  renderSuggestions();
  initNearby();
} catch(e) { console.error('Guide init error:', e); }
</script>
</body>
</html>
