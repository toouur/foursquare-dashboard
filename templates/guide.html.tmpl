<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Guide — What's around me right now</title>
<meta name="description" content="Live nearby venue suggestions tailored to your taste history, day-part, and current location.">
<link rel="canonical" href="https://4sq.pages.dev/guide.html">
<meta property="og:type" content="website">
<meta property="og:title" content="Guide — What's around me right now">
<meta property="og:description" content="Live nearby venue suggestions tailored to your taste history.">
<meta property="og:url" content="https://4sq.pages.dev/guide.html">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link rel="preconnect" href="https://unpkg.com" crossorigin>
<link rel="preconnect" href="https://overpass-api.de" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&family=DM+Sans:wght@400;600&family=DM+Mono&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/6.6.6/css/flag-icons.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="{{SITE_CSS_LINK}}">
<style>
:root{--bg:#0c0e14;--card:#12141c;--card2:#181a24;--border:#222738;--text:#e0e2ec;--muted:#8b93a8;--gold:#e8b86d;--teal:#4ec9b0;--rose:#e8778a;}
body.light{--bg:#ddd8cf;--card:#f0ece3;--card2:#e5e0d7;--border:#aaa49a;--gold:#7a3e00;--teal:#155c58;--muted:#54576a;--text:#15172a;--rose:#a83e5a;}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;}
a{color:var(--teal);}

/* ── Layout ── */
.page{padding:18px 28px 80px;max-width:1280px;margin:0 auto;}
@media(max-width:600px){.page{padding:12px 14px 60px;}}

/* ── Header ── */
header{padding:18px 0 14px;border-bottom:1px solid var(--border);margin-bottom:18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
header h1{font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:900;background:linear-gradient(130deg,#f5d48a,#e8b86d 50%,#b97c30);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1.05;}
.h-sub{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-left:auto;}
@media(max-width:600px){header h1{font-size:1.3rem;} .h-sub{display:none;}}

/* ── Hero (anchor) ── */
.hero{background:linear-gradient(135deg,rgba(232,184,109,.10) 0%,rgba(78,201,176,.05) 100%);border:1px solid rgba(232,184,109,.25);border-radius:14px;padding:18px 22px;margin-bottom:16px;}
.hero-row1{display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap;}
.hero-anchor{flex:1 1 280px;min-width:0;}
.hero-anchor-lbl{font-family:'DM Mono',monospace;font-size:.55rem;text-transform:uppercase;letter-spacing:.14em;color:var(--gold);margin-bottom:4px;}
.hero-venue{font-size:1.15rem;font-weight:600;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.hero-meta{font-size:.78rem;color:var(--muted);margin-top:3px;display:flex;gap:10px;flex-wrap:wrap;}
.hero-meta strong{color:var(--text);font-weight:600;}
.hero-context{font-family:'DM Mono',monospace;font-size:.62rem;color:var(--teal);margin-top:7px;letter-spacing:.05em;}
.hero-context .ctx-badge{display:inline-block;background:rgba(78,201,176,.12);border:1px solid rgba(78,201,176,.35);border-radius:10px;padding:1px 8px;margin-right:5px;font-size:.58rem;}
.hero-context .ctx-badge.alert{background:rgba(232,184,109,.10);border-color:rgba(232,184,109,.35);color:var(--gold);}
.hero-actions{display:flex;gap:6px;flex-wrap:wrap;}
.hero-btn{padding:6px 11px;border-radius:8px;background:var(--card);border:1px solid var(--border);color:var(--text);font-size:.7rem;font-family:'DM Mono',monospace;text-decoration:none;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .15s;letter-spacing:.04em;}
.hero-btn:hover{border-color:var(--gold);color:var(--gold);}
.hero-btn.gps{background:rgba(78,201,176,.10);border-color:rgba(78,201,176,.35);color:var(--teal);}
.hero-btn.gps.active{background:rgba(78,201,176,.20);border-color:var(--teal);}
.hero-btn.gps.locating{opacity:.7;animation:gpspulse 1s ease-in-out infinite;}
@keyframes gpspulse{0%,100%{opacity:.55;}50%{opacity:1;}}
.hero-hint{font-size:.72rem;color:var(--muted);margin-top:8px;line-height:1.4;}
.hero-hint b{color:var(--teal);font-weight:600;}

/* ── Filter panel + map two-pane ── */
.discover-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.dc-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.dc-head h2{font-family:'DM Mono',monospace;font-size:.66rem;text-transform:uppercase;letter-spacing:.18em;color:var(--gold);font-weight:600;}
.dc-head .count{font-family:'DM Mono',monospace;font-size:.62rem;color:var(--muted);margin-left:auto;}
.dc-head .count strong{color:var(--teal);}

.layout{display:grid;grid-template-columns:340px 1fr;gap:0;min-height:540px;}
@media(max-width:900px){.layout{grid-template-columns:1fr;}}

/* Left rail */
.rail{border-right:1px solid var(--border);padding:14px 14px 18px;display:flex;flex-direction:column;gap:14px;max-height:calc(100vh - 240px);overflow-y:auto;}
@media(max-width:900px){.rail{border-right:none;border-bottom:1px solid var(--border);max-height:none;overflow-y:visible;}}
.rail::-webkit-scrollbar{width:3px;}
.rail::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}

.rail-block{display:flex;flex-direction:column;gap:8px;}
.rail-label{font-family:'DM Mono',monospace;font-size:.55rem;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);}

.rec-pills{display:flex;flex-wrap:wrap;gap:5px;}
.rec-pill{padding:5px 11px;border-radius:14px;font-size:.72rem;cursor:pointer;border:1px solid rgba(232,184,109,.4);background:rgba(232,184,109,.08);color:var(--gold);font-family:inherit;display:inline-flex;align-items:center;gap:4px;transition:all .15s;}
.rec-pill:hover{background:rgba(232,184,109,.16);}
.rec-pill.active{background:rgba(232,184,109,.22);border-color:var(--gold);color:var(--gold);}
.rec-pill .star{font-size:.55rem;}

.cat-acc{display:flex;flex-direction:column;gap:3px;}
.cat-group{border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--card2);}
.cat-group-h{width:100%;display:flex;align-items:center;gap:7px;padding:6px 10px;background:transparent;cursor:pointer;border:none;color:var(--text);font-family:inherit;text-align:left;transition:background .12s;}
.cat-group-h:hover{background:rgba(78,201,196,.08);}
.cat-group.open .cat-group-h{background:rgba(78,201,196,.10);border-bottom:1px solid var(--border);}
.cgi{font-size:.85rem;width:18px;text-align:center;flex-shrink:0;}
.cgn{flex:1;font-size:.74rem;font-weight:500;}
.cgliked{font-size:.55rem;color:var(--rose);margin-right:2px;}
.cgcount{font-family:'DM Mono',monospace;font-size:.55rem;color:var(--teal);background:rgba(78,201,196,.10);border-radius:9px;padding:1px 6px;flex-shrink:0;}
.cgarrow{font-size:.55rem;color:var(--muted);transition:transform .15s;flex-shrink:0;}
.cat-group.open .cgarrow{transform:rotate(180deg);}
.cgbody{display:none;padding:8px;flex-wrap:wrap;gap:4px;}
.cat-group.open .cgbody{display:flex;}
.cat-pill{padding:3px 9px;border-radius:14px;font-size:.66rem;cursor:pointer;background:transparent;border:1px solid var(--border);color:var(--muted);transition:all .12s;font-family:inherit;white-space:nowrap;}
.cat-pill:hover{background:rgba(78,201,196,.08);border-color:rgba(78,201,196,.35);color:var(--text);}
.cat-pill.active{background:rgba(78,201,196,.18);border-color:var(--teal);color:var(--teal);}
.cat-pill.liked{border-color:rgba(232,119,138,.35);color:var(--rose);}
.cat-pill.liked .heart{font-size:.5rem;margin-right:2px;}
.cat-pill.visited::after{content:'';display:inline-block;width:4px;height:4px;border-radius:50%;background:var(--teal);margin-left:5px;opacity:.6;vertical-align:middle;}
.cat-pill-count{font-family:'DM Mono',monospace;font-size:.5rem;opacity:.6;margin-left:3px;}

.toggle-row{display:flex;flex-wrap:wrap;gap:5px;}
.toggle-btn{padding:4px 9px;border-radius:14px;font-size:.65rem;cursor:pointer;background:var(--card2);border:1px solid var(--border);color:var(--muted);font-family:'DM Mono',monospace;letter-spacing:.04em;text-transform:none;transition:all .12s;}
.toggle-btn:hover{border-color:var(--teal);color:var(--text);}
.toggle-btn.active{background:rgba(78,201,176,.15);border-color:var(--teal);color:var(--teal);}
.toggle-btn.gold.active{background:rgba(232,184,109,.12);border-color:var(--gold);color:var(--gold);}

.radius-slider{width:100%;}
.radius-slider input{width:100%;accent-color:var(--teal);}
.radius-display{font-family:'DM Mono',monospace;font-size:.6rem;color:var(--teal);margin-top:2px;text-align:center;}

/* Right pane: map + list */
.right{display:flex;flex-direction:column;min-width:0;}
.map-pane{position:relative;height:340px;border-bottom:1px solid var(--border);}
#nbMap{width:100%;height:100%;background:#0c0e14;}
.map-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(12,14,20,0.78);color:var(--muted);font-size:.78rem;z-index:500;pointer-events:none;}
.map-loading.hidden{display:none;}
.leaflet-popup-content-wrapper{background:var(--card2);border:1px solid var(--border);color:var(--text);font-family:'DM Sans',sans-serif;}
.leaflet-popup-tip{background:var(--card2);}

.list-pane{flex:1;overflow-y:auto;padding:8px 14px 14px;max-height:480px;}
.list-pane::-webkit-scrollbar{width:3px;}
.list-pane::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}

.nb-item{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;background:var(--card2);border:1px solid var(--border);border-radius:8px;margin-bottom:5px;cursor:pointer;transition:all .12s;}
.nb-item:hover, .nb-item.hover{border-color:rgba(78,201,196,.5);background:rgba(78,201,196,.05);}
.nb-item.visited{border-color:rgba(232,184,109,.4);background:rgba(232,184,109,.06);}
.nb-item .dist{font-family:'DM Mono',monospace;font-size:.68rem;font-weight:600;color:var(--teal);white-space:nowrap;min-width:48px;text-align:right;padding-top:1px;}
.nb-item .body{flex:1;min-width:0;}
.nb-item .name{font-size:.85rem;font-weight:500;line-height:1.25;}
.nb-item.visited .name::after{content:' ✓';color:var(--gold);}
.nb-item .meta{font-size:.65rem;color:var(--muted);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.nb-item .meta .sep{margin:0 4px;opacity:.5;}
.nb-item .meta .opening{color:var(--teal);}
.nb-item .meta .opening.closed{color:var(--rose);}
.nb-item .links{display:flex;gap:5px;margin-top:6px;flex-wrap:wrap;}
.nb-link{font-size:.6rem;padding:2px 7px;border-radius:4px;text-decoration:none;border:1px solid rgba(255,255,255,.12);color:var(--text);}
.nb-link.g{border-color:rgba(66,133,244,.4);color:#5995ff;}
.nb-link.y{border-color:rgba(255,80,80,.4);color:#ff6060;}
.nb-link.o{border-color:rgba(120,200,100,.35);color:#78c864;}
.nb-link.w{border-color:rgba(232,184,109,.35);color:var(--gold);}
.nb-link:hover{background:rgba(255,255,255,.05);}
.nb-item.mine .name::after{content:none;}
.mine-badge{display:inline-block;margin-left:6px;font-size:.55rem;font-weight:600;color:var(--gold);border:1px solid rgba(232,184,109,.4);border-radius:4px;padding:1px 5px;vertical-align:middle;}
.nb-banner{margin:8px 0 4px;padding:8px 11px;font-size:.72rem;line-height:1.4;color:var(--gold);background:rgba(232,184,109,.08);border:1px solid rgba(232,184,109,.3);border-radius:7px;}
.nb-banner.hidden{display:none;}
.nb-banner .fb-ico{margin-right:4px;}
.nb-banner b{color:var(--text);font-weight:600;}
.nb-empty{text-align:center;padding:30px 16px;color:var(--muted);font-size:.82rem;}
.nb-empty h3{font-size:.95rem;margin-bottom:6px;color:var(--text);}
.nb-empty a{color:var(--teal);}

/* Side nav */

/* Empty state when no anchor */
.no-anchor{padding:60px 20px;text-align:center;color:var(--muted);background:var(--card);border:1px solid var(--border);border-radius:14px;}
.no-anchor h2{font-size:1.2rem;color:var(--text);margin-bottom:10px;}
.no-anchor p{font-size:.82rem;line-height:1.6;}
.no-anchor button{margin-top:18px;padding:9px 18px;border-radius:8px;background:rgba(78,201,196,.10);border:1px solid var(--teal);color:var(--teal);font-size:.78rem;cursor:pointer;font-family:inherit;}
</style>
</head>
<body>
<div class="page">

<header>
