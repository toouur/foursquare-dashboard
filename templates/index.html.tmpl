// ── Recent Check-ins + Weather ─────────────────────────────────
(function(){
  const recent=S.recent;
  const WMO={
    0:['☀️','Clear'],1:['🌤️','Mainly clear'],2:['⛅','Partly cloudy'],3:['☁️','Overcast'],
    45:['🌫️','Fog'],48:['🌫️','Icy fog'],51:['🌦️','Light drizzle'],53:['🌦️','Drizzle'],55:['🌧️','Heavy drizzle'],
    61:['🌧️','Light rain'],63:['🌧️','Rain'],65:['🌧️','Heavy rain'],
    71:['🌨️','Light snow'],73:['❄️','Snow'],75:['❄️','Heavy snow'],77:['🌨️','Snow grains'],
    80:['🌦️','Rain showers'],81:['🌧️','Rain showers'],82:['⛈️','Violent showers'],
    85:['🌨️','Snow showers'],86:['❄️','Heavy snow showers'],
    95:['⛈️','Thunderstorm'],96:['⛈️','Thunderstorm+hail'],99:['⛈️','Thunderstorm+hail'],
  };
  function wmoByTime(code,hour){
    const[em,desc]=WMO[code]||['🌡️',''];
    if(code===0||code===1){
      if(hour<6||hour>=22) return['🌙',desc];
      if(hour<9) return[code===0?'🌅':'🌤️',desc];
      if(hour>=18) return[code===0?'🌇':'🌤️',desc];
    }
    return[em,desc];
  }
  const scrollEl=document.getElementById('recentScroll');

  // ── Streak: count each venue_id in the recent 30 ──
  const venueCounts={};
  recent.forEach(r=>{if(r.venue_id)venueCounts[r.venue_id]=(venueCounts[r.venue_id]||0)+1;});

  // ── OSM tile mini-map helper ──
  function tileBlock(lat,lng){
    if(!lat||!lng) return '';
    const z=14,n=1<<z;
    const xf=(lng+180)/360*n,latr=lat*Math.PI/180;
    const yf=(1-Math.log(Math.tan(latr)+1/Math.cos(latr))/Math.PI)/2*n;
    const xt=Math.floor(xf),yt=Math.floor(yf);
    const L0=Math.round(110-(xf-xt)*256),T0=Math.round(43-(yf-yt)*256);
    const u=(dx,dy)=>`https://tile.openstreetmap.org/${z}/${xt+dx}/${yt+dy}.png`;
    const im=(dx,dy,l,t)=>`<img src="${u(dx,dy)}" width="256" height="256" style="left:${l}px;top:${t}px;" loading="lazy">`;
    const nR=L0+256<220,nL=L0>0,nT=T0>0,nB=T0+256<90;
    let t=im(0,0,L0,T0);
    if(nR)t+=im(1,0,L0+256,T0);   if(nL)t+=im(-1,0,L0-256,T0);
    if(nT)t+=im(0,-1,L0,T0-256);  if(nB)t+=im(0,1,L0,T0+256);
    if(nR&&nT)t+=im(1,-1,L0+256,T0-256); if(nL&&nT)t+=im(-1,-1,L0-256,T0-256);
    if(nR&&nB)t+=im(1,1,L0+256,T0+256);  if(nL&&nB)t+=im(-1,1,L0-256,T0+256);
    return `<div class="rc-map">${t}<div class="rc-map-fade"></div><div class="rc-map-pin">📍</div></div>`;
  }

  // ── Foursquare app URL ──
  function fsUrl(r){
    if(!r.venue_id) return null;
    return `https://app.foursquare.com/v/${encodeURIComponent(r.venue.toLowerCase().replace(/\s+/g,'-'))}/${r.venue_id}`;
  }

  // ── Category icons: emoji + vivid colour, 100% self-contained, no CDN ──
  // Each entry: [emoji, background-colour]
  const CAT_ICON = {{CAT_ICON_JSON}};
  function catIcon(category){
    const entry=CAT_ICON[category];
    if(!entry) return '';
    const [emoji,bg]=entry;
    return `<div class="rc-cat-icon" style="background:${bg}22;border:1px solid ${bg}66" title="${category}">${emoji}</div>`;
  }


  scrollEl.innerHTML=recent.map((r,i)=>{
    const swarmUrl=r.checkin_id?`https://www.swarmapp.com/user/{{SWARM_USER_ID}}/checkin/${r.checkin_id}`:null;
    const vUrl=fsUrl(r);
    // Use div+onclick to avoid nested <a> (card link + venue link both being <a>)
    const cardClick=swarmUrl?` onclick="window.open('${swarmUrl}','_blank')"`:' onclick=""';
    const venueLink=vUrl?`<a href="${vUrl}" target="_blank" rel="noopener" onclick="event.stopPropagation()" style="color:inherit;text-decoration:none;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='inherit'">${esc(r.venue)||'Unknown venue'}</a>`:esc(r.venue)||'Unknown venue';
    const streak=r.venue_id&&venueCounts[r.venue_id]>1
      ? `<div class="rc-streak">🔁 ${venueCounts[r.venue_id]}×</div>` : '';
    const f=r.country?flagHtml(r.country,'1em'):'';
    const loc=[r.city,r.country].filter(Boolean);
    const locStr=loc.join(', ');
    const withLine=(r.companions&&r.companions.length)?`<div class="rc-with">with ${esc(r.companions.join(', '))}</div>`:'';
    // Flight info from FR24 match (set in build.py from data/flights.csv)
    let flightLine='';
    if(r.flight){
      const f2=r.flight;
      const route=(f2.from_iata&&f2.to_iata)?`${esc(f2.from_iata)} → ${esc(f2.to_iata)}`:'';
      const fno=f2.flight?esc(f2.flight):'';
      const ac=f2.aircraft?esc(f2.aircraft):'';
      const dur=f2.dur_min?` · ${Math.floor(f2.dur_min/60)}h ${f2.dur_min%60}m`:'';
      const km =f2.km?` · ${(+f2.km).toLocaleString()} km`:'';
      flightLine=`<div class="rc-flight">✈ ${fno?fno+' ':''}${route}${ac?' · '+ac:''}${dur}${km}</div>`;
    }
    return `<div${cardClick} class="recent-card" id="rc_${i}" style="${swarmUrl?'cursor:pointer;':''}">
      ${tileBlock(r.lat,r.lng)}
      <div class="rc-venue-row"><div class="rc-venue">${venueLink}</div>${catIcon(r.category)}</div>
      <div class="rc-cat-row"><div class="rc-cat">${esc(r.category||'')}</div>${streak}</div>
      <div class="rc-location">${f} ${esc(locStr)}</div>
      ${withLine}
      ${flightLine}
      <div class="rc-weather" id="rcw_${i}"><span class="rc-weather-loading">fetching weather…</span></div>
      <div class="rc-date">${r.datetime}</div>
    </div>`;
  }).join('');

  // ── Weather fetch (throttled) ──
  async function fetchWeather(r,i){
    if(!r.lat||!r.lng){document.getElementById('rcw_'+i).innerHTML='';return;}
    try{
      const utcDate=new Date(r.ts*1000).toISOString().slice(0,10);
      const url=`https://archive-api.open-meteo.com/v1/archive?latitude=${r.lat}&longitude=${r.lng}`+
        `&start_date=${utcDate}&end_date=${utcDate}&hourly=temperature_2m,weather_code&timezone=auto`;
      const res=await fetch(url); const d=await res.json();
      const hour=parseInt(r.time.split(':')[0]);
      const temp=d.hourly?.temperature_2m?.[hour], code=d.hourly?.weather_code?.[hour];
      const [icon,desc]=wmoByTime(code,hour);
      const el=document.getElementById('rcw_'+i);
      if(el){if(temp==null&&code==null){el.innerHTML='';}else{el.innerHTML=`<span class="rc-weather-icon">${icon}</span><span class="rc-weather-temp">${temp!=null?Math.round(temp)+'°C':'—'}</span><span class="rc-weather-desc">${desc}</span>`;}}
    }catch(e){const el=document.getElementById('rcw_'+i);if(el)el.innerHTML='';}
  }
  recent.forEach((r,i)=>setTimeout(()=>fetchWeather(r,i),i*120));
  // Expose for tips section
  window._catIcon=catIcon;
})();

