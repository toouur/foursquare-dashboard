// ── Recent flights section ────────────────────────────────────────────────────
// Airline logos via a multi-CDN fallback chain.  Different CDNs cover
// different airlines (Kiwi has best coverage, Google Flights covers majors,
// Airhex covers everything but sometimes blocks hotlinking).  We try them
// in order via onerror.
window._setAirlineLogo = function(img, iata) {
  if (!iata) { img.style.display='none'; const fb=img.nextElementSibling; if(fb)fb.style.display='inline-flex'; return; }
  const cdns = [
    `https://images.kiwi.com/airlines/64/${iata}.png`,
    `https://www.gstatic.com/flights/airline_logos/70px/${iata}.png`,
    `https://content.airhex.com/content/logos/airlines_${iata}_70_70_s.png`,
  ];
  let i = 0;
  img.onerror = () => { i++; if (i < cdns.length) img.src = cdns[i]; else { img.style.display='none'; const fb=img.nextElementSibling; if(fb)fb.style.display='inline-flex'; } };
  img.src = cdns[0];
};
(function(){
