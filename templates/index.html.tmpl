    {id:'s-timeline',btn:'sn-timeline'},
    {id:'s-countries',btn:'sn-countries'},
    {id:'s-cities',btn:'sn-cities'},
    {id:'s-venues',btn:'sn-venues'},
    {id:'s-map',btn:'sn-map'}
  ];
  function updateActive(){
    var scrollY=window.scrollY||window.pageYOffset;
    var best=-1;
    for(var i=0;i<sections.length;i++){
      var el=document.getElementById(sections[i].id);
      if(el&&el.getBoundingClientRect().top+scrollY<=scrollY+window.innerHeight*0.5) best=i;
    }
    var homeBtn=document.getElementById('sn-home');
    if(homeBtn) homeBtn.classList.toggle('active',best===-1);
    for(var j=0;j<sections.length;j++){
      var btn=document.getElementById(sections[j].btn);
      if(btn) btn.classList.toggle('active',j===best);
    }
  }
  window.addEventListener('scroll',updateActive,{passive:true});
  updateActive();
})();
(function(){
  var btn=document.getElementById('snThemeToggle');
  var ico=document.getElementById('snThemeIcon');
  var lbl=document.getElementById('snThemeLbl');
  function apply(light){
    document.body.classList.toggle('light',light);
    ico.textContent=light?'🌙':'☀️';
    lbl.textContent=light?'DARK':'LIGHT';
  }
  apply(localStorage.getItem('fsq-theme')==='light');
  btn.addEventListener('click',function(){
    var isLight=document.body.classList.toggle('light');
    localStorage.setItem('fsq-theme',isLight?'light':'dark');
    apply(isLight);
  });
})();
</script>
