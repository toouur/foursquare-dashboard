// ── Check-in drilldown drawer ────────────────────────────────────────────────
(function(){
  let _filter=null, _cursor=null, _cursorId=null, _loading=false, _done=false;

  function ciRenderRows(items){
    const body=document.getElementById('ciDrawerBody');
    items.forEach(it=>{
      // it: [ts, dateStr, timeStr, venue, city, country, category, venue_id, lat, lng, id]
      const row=document.createElement('div');
      row.className='ci-row';
      const cityCountry=[it[4],it[5]].filter(Boolean).join(', ');
      row.innerHTML=
        `<div class="ci-row-top">`+
          `<span class="ci-row-venue">${esc(it[3])}</span>`+
          `<span class="ci-row-date">${it[1]}</span>`+
        `</div>`+
        `<div class="ci-row-bot">`+
          `<span class="ci-row-city">${esc(cityCountry)}</span>`+
          (it[6]?`<span class="ci-row-cat">${esc(it[6])}</span>`:'')+
        `</div>`;
      body.appendChild(row);
    });
  }

  async function ciFetch(){
    if(_loading||_done||!_filter) return;
    _loading=true;
    const btn=document.getElementById('ciLoadMoreBtn');
    if(btn) btn.disabled=true;
    try{
      const p=new URLSearchParams({limit:'50'});
      if(_filter.country) p.set('country',_filter.country);
      else if(_filter.city) p.set('city',_filter.city);
      if(_cursor!=null){p.set('cursor',_cursor);if(_cursorId)p.set('cursor_id',_cursorId);}
      const res=await fetch('/api/feed?_v=companions&'+p);
      if(!res.ok) throw new Error(res.status);
      const data=await res.json();
      ciRenderRows(data.items||[]);
      if(data.has_more){_cursor=data.next_cursor;_cursorId=data.next_cursor_id;}
      else{_done=true;}
    }catch(e){console.error('ciDrilldown',e);}
    finally{
      _loading=false;
      const foot=document.getElementById('ciDrawerFoot');
      if(_done){if(foot)foot.style.display='none';}
      else{if(foot)foot.style.display='';if(btn)btn.disabled=false;}
    }
  }

  window.ciOpen=function(filter){
    _filter=filter;_cursor=null;_cursorId=null;_loading=false;_done=false;
    document.getElementById('ciDrawerBody').innerHTML='';
    document.getElementById('ciDrawerTitle').textContent=filter.label||'';
    const initCount=filter.count||null;
    document.getElementById('ciDrawerCount').textContent=initCount?initCount.toLocaleString()+' check-ins':'';
    document.getElementById('ciDrawerFoot').style.display='none';
    document.getElementById('ciDrawer').classList.add('open');
    document.getElementById('ciDrawerScrim').classList.add('open');
    document.body.style.overflow='hidden';
    ciFetch();
  };
  window.ciClose=function(){
    document.getElementById('ciDrawer').classList.remove('open');
    document.getElementById('ciDrawerScrim').classList.remove('open');
    document.body.style.overflow='';
    _filter=null;
  };
  window.ciLoadMore=function(){ciFetch();};
  window.ciOnScroll=function(){
    const body=document.getElementById('ciDrawerBody');
    if(!_done&&!_loading&&body.scrollTop+body.clientHeight>=body.scrollHeight-120) ciFetch();
  };
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.getElementById('ciDrawer').classList.contains('open'))ciClose();});
})();

// ── City pane initialisation ─────────────────────────────────────────────────
(function(){
  // panels are shown/hidden by switchCityTab; default is checkins so nothing needed
  // Patch switchCityTab for correct pane IDs
  window.switchCityTab=function(tab,el){
    document.getElementById('paneCityCheckins').style.display=tab==='checkins'?'':'none';
    document.getElementById('paneCityPlaces').style.display=tab==='places'?'':'none';
    document.getElementById('paneCityCountry').style.display=tab==='country'?'':'none';
    document.getElementById('paneCityWorld').style.display=tab==='world'?'':'none';
    document.querySelectorAll('#tabCityCheckins,#tabCityPlaces,#tabCityCountry,#tabCityWorld').forEach(t=>t.classList.remove('active'));
    el.classList.add('active');
    if(tab==='country' && !document.getElementById('byCountryList').innerHTML) buildByCountry(_byCountrySort);
    if(tab==='world' && !document.getElementById('worldCitiesList').innerHTML) buildWorldCities('ALL');
  };
})();
