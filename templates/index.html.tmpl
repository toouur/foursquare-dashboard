// ── Main Map (heatmap / dots) ─────────────────────────────────────
const map=L.map('map',{preferCanvas:true}).setView([30,15],2);
L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',{
  attribution:'&copy; OpenStreetMap &copy; CARTO',subdomains:'abcd',maxZoom:19}).addTo(map);
const status=document.getElementById('mapStatus');
let heatLayer=null,dotLayerFull=null,dotLayerFilt=null,cityDotLayer=null,currentMode='heat';
let mfYear='all',mfCat='all';

// Heatmap: pre-computed p75-capped weights from Python (one point per ~330m cell).
// radius=14, blur=10 keeps individual cities distinct at world zoom.
// minOpacity=0.3 ensures even single-visit places show up on the map.
heatLayer=L.heatLayer(S.venues_heatmap,{
  radius:14, blur:10, maxZoom:18, max:1.0, minOpacity:0.3,
  gradient:{'0.0':'#0a1628','0.2':'#0d3b6e','0.4':'#1a6b9a','0.65':'#e8b86d','0.85':'#ff7700','1.0':'#ff2200'}
}).addTo(map);
status.textContent='Heatmap · '+S.unique_places.length.toLocaleString()+' unique places';
setTimeout(()=>status.style.opacity='0',2800);

function _dotMarker(p){
  // p = [lat, lng, name, count, years[], cat, city]
  const nm=esc(p[2]||''),cnt=p[3]||1,yrs=Array.isArray(p[4])?p[4]:[],cat=esc(p[5]||''),city=esc(p[6]||'');
  const yrLabel=yrs.length>1?yrs[0]+'\u2013'+yrs[yrs.length-1]:yrs.length===1?String(yrs[0]):'';
  const popup='<div style="font-family:\'DM Sans\',sans-serif;min-width:130px;max-width:200px">'
    +'<div style="font-weight:600;font-size:.84rem;line-height:1.3;margin-bottom:3px">'+nm+'</div>'
    +(city?'<div style="font-size:.71rem;color:#a0a8c0;margin-bottom:1px">'+city+'</div>':'')
    +(cat?'<div style="font-size:.71rem;color:#a0a8c0;margin-bottom:4px">'+cat+'</div>':'')
    +'<div style="display:flex;gap:10px;font-size:.72rem">'
    +'<span style="color:#e8b86d;font-weight:600">'+cnt.toLocaleString()+' visit'+(cnt===1?'':'s')+'</span>'
    +(yrLabel?'<span style="color:#a0a8c0">'+yrLabel+'</span>':'')
    +'</div></div>';
  return L.circleMarker([p[0],p[1]],{radius:3,color:'#e8b86d',fillColor:'#e8b86d',fillOpacity:0.65,weight:0})
    .bindPopup(popup,{maxWidth:220,className:'map-dot-popup'});
}

function buildDots(){
  if(dotLayerFull){_showDotLayer();return;}
  status.style.opacity='1';
  const pts=S.unique_places; let i=0; dotLayerFull=L.layerGroup();
  function chunk(){
    const end=Math.min(i+3000,pts.length);
    for(;i<end;i++) _dotMarker(pts[i]).addTo(dotLayerFull);
    status.textContent='Plotting '+i.toLocaleString()+' / '+pts.length.toLocaleString()+'...';
    if(i<pts.length)requestAnimationFrame(chunk);
    else{_showDotLayer();status.style.opacity='0';}
  }
  requestAnimationFrame(chunk);
}

function _showDotLayer(){
  if(currentMode!=='dots')return;
  if(mfYear==='all'&&mfCat==='all'){
    if(dotLayerFilt){try{map.removeLayer(dotLayerFilt);}catch(e){}}
    dotLayerFull.addTo(map);
  } else {
    _applyDotFilter();
  }
}

let _explorerCatSets=null;
function _getExplorerCatSets(){
  if(_explorerCatSets)return _explorerCatSets;
  _explorerCatSets={};
  const eg=S.explorer_groups||{};
  for(const[k,v]of Object.entries(eg))_explorerCatSets[k]=new Set(v);
  return _explorerCatSets;
}
function _applyDotFilter(){
  if(dotLayerFull)try{map.removeLayer(dotLayerFull);}catch(e){}
  if(dotLayerFilt)try{map.removeLayer(dotLayerFilt);}catch(e){}
  const catSets=_getExplorerCatSets();
  const pts=S.unique_places.filter(p=>{
    const yrOk=mfYear==='all'||(Array.isArray(p[4])&&p[4].includes(+mfYear));
    const catOk=mfCat==='all'||(catSets[mfCat]&&catSets[mfCat].has(p[5]));
    return yrOk&&catOk;
  });
  dotLayerFilt=L.layerGroup();
  pts.forEach(p=>_dotMarker(p).addTo(dotLayerFilt));
  if(currentMode==='dots')dotLayerFilt.addTo(map);
  const parts=[];
  if(mfCat!=='all')parts.push(mfCat);
  if(mfYear!=='all')parts.push('visited in '+mfYear);
  status.textContent=pts.length.toLocaleString()+' places'+(parts.length?' · '+parts.join(' · '):'');
  status.style.opacity='1';setTimeout(()=>status.style.opacity='0',3000);
}

// ── Map dots filters (year / category) ────────────────────────────────────────
function _setPillActive(container,val){
  container.querySelectorAll('.mf-pill').forEach(el=>el.classList.toggle('active',el.dataset.val===val));
}

function buildMapFilters(){
  const yc=document.getElementById('mapYearPills');
  if(yc&&!yc.childNodes.length){
    const years=(S.by_year||[]).map(r=>r[0]).sort((a,b)=>a-b);
    [['all','All'],...years.map(y=>[String(y),String(y)])].forEach(([v,l])=>{
      const b=document.createElement('button');
      b.className='mf-pill'+(v==='all'?' active':'');
      b.textContent=l;b.dataset.val=v;
      b.onclick=function(){if(mfYear===v)return;mfYear=v;_setPillActive(yc,v);_showDotLayer();};
      yc.appendChild(b);
    });
  }
  const cc=document.getElementById('mapCatPills');
  if(cc&&!cc.childNodes.length){
    const cats=S.explorer_cats||[];
    [['all','All'],...cats.map(c=>[c,c])].forEach(([v,l])=>{
      const b=document.createElement('button');
      b.className='mf-pill'+(v==='all'?' active':'');
      b.textContent=l;b.dataset.val=v;
      b.onclick=function(){if(mfCat===v)return;mfCat=v;_setPillActive(cc,v);_showDotLayer();};
      cc.appendChild(b);
    });
  }
}

// ── Countries flag map ─────────────────────────────────────────────────────
let countriesMapInst=null;
function buildCountriesMap(){
  if(countriesMapInst) return;
  countriesMapInst=L.map('countriesMap',{preferCanvas:false,zoomControl:true}).setView([25,20],2);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png',{
    attribution:'&copy; OpenStreetMap &copy; CARTO',subdomains:'abcd',maxZoom:10}).addTo(countriesMapInst);

  const centroids=S.country_centroids;
  const counts=Object.values(centroids).map(v=>v[2]);
  const maxC=Math.max(...counts);

  // Sort by count ascending so high-traffic countries render on top
  const sorted=Object.entries(centroids).sort((a,b)=>a[1][2]-b[1][2]);

  sorted.forEach(([country,[lat,lng,count]])=>{
    const code=ISO2[country];

    // Scale: min 18px, max 42px based on sqrt(count/max)
    const size=Math.round(18+Math.sqrt(count/maxC)*24);
    const half=Math.round(size/2);

    // Flag width = size * 4/3 (flag-icons are 4:3 ratio)
    const fw=Math.round(size*1.33);

    // Build inner HTML: flag + count badge
    const flagEl=code
      ? `<span class="fi fi-${code}" style="width:${fw}px;height:${size}px;display:block;border-radius:3px;box-shadow:0 1px 4px rgba(0,0,0,.7)"></span>`
      : `<div style="width:${fw}px;height:${size}px;background:#2a2f45;border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:${Math.round(size*.55)}px;box-shadow:0 1px 4px rgba(0,0,0,.7)">🌐</div>`;

    const badge=count>=100
      ? `<div style="position:absolute;top:-7px;right:-7px;background:#e8b86d;color:#0b0d13;font-family:'DM Mono',monospace;font-size:${Math.max(8,Math.round(size*.22))}px;font-weight:700;padding:1px 4px;border-radius:10px;white-space:nowrap;line-height:1.4">${count>=10000?(count/1000).toFixed(0)+'k':count>=1000?(count/1000).toFixed(1)+'k':count}</div>`
      : '';

    const icon=L.divIcon({
      className:'',
      html:`<div style="position:relative;cursor:pointer;transition:transform .15s" onmouseenter="this.style.transform='scale(1.25)'" onmouseleave="this.style.transform=''">${flagEl}${badge}</div>`,
      iconSize:[fw,size],
      iconAnchor:[half,half],
      popupAnchor:[0,-half],
    });

    L.marker([lat,lng],{icon})
      .bindTooltip(`<b>${esc(country)}</b> &nbsp;${count.toLocaleString()} check-ins`,{
        direction:'top',opacity:0.97,offset:[0,-half]})
      .addTo(countriesMapInst);
  });
}

function switchMap(mode){
  currentMode=mode;
  ['Heat','Dots','CityMap','Countries'].forEach(m=>
    document.getElementById('tab'+m) && document.getElementById('tab'+m).classList.toggle('active',mode===m.toLowerCase().replace('citymap','citymap')));
  // actually handle manually
  ['tabHeat','tabDots','tabCityMap','tabCountries'].forEach(id=>{
    const el=document.getElementById(id); if(el) el.classList.remove('active');
  });
  const active={heat:'tabHeat',dots:'tabDots',citymap:'tabCityMap',countries:'tabCountries'}[mode];
  if(active){const el=document.getElementById(active);if(el)el.classList.add('active');}

  document.getElementById('map').style.display=        (mode==='heat'||mode==='dots')?'block':'none';
  document.getElementById('cityMap').style.display=    mode==='citymap'?'block':'none';
  document.getElementById('countriesMap').style.display=mode==='countries'?'block':'none';
  const mf=document.getElementById('mapFilters');
  if(mf)mf.style.display=mode==='dots'?'flex':'none';

  if(mode==='heat'){
    if(dotLayerFull)try{map.removeLayer(dotLayerFull);}catch(e){}
    if(dotLayerFilt)try{map.removeLayer(dotLayerFilt);}catch(e){}
    if(cityDotLayer)map.removeLayer(cityDotLayer);
    heatLayer.addTo(map);
    status.textContent='Heatmap · '+S.unique_places.length.toLocaleString()+' unique places';
    status.style.opacity='1';setTimeout(()=>status.style.opacity='0',2500);
  } else if(mode==='dots'){
    try{map.removeLayer(heatLayer);}catch(e){}
    if(cityDotLayer)map.removeLayer(cityDotLayer);
    buildMapFilters();
    buildDots();
  } else if(mode==='citymap'){
    setTimeout(()=>{buildCityMap();cityMapInst.invalidateSize();},50);
  } else {
    setTimeout(()=>{buildCountriesMap();countriesMapInst.invalidateSize();},50);
  }
}


