function makeCountryGrid(data,id,drilldown){
  // DOM emit is row-major (rank 1..n) so mobile's 1-col layout reads
  // naturally.  Desktop / tablet restore the original column-major
  // visual via CSS:
  //   grid-auto-flow:column + grid-template-rows:repeat(N, auto)
  // where N is the row count for the current breakpoint.  Setting
  // --rows-3 and --rows-2 here lets the same DOM render correctly at
  // every breakpoint.
  const n = data.length;
  const el = document.getElementById(id);
  el.style.setProperty('--rows-3', Math.ceil(n / 3));
  el.style.setProperty('--rows-2', Math.ceil(n / 2));
  const vis = data.map((d, i) => [d, i + 1]);
  el.innerHTML=vis.map(([[name,count],rank])=>{
    const f=flagHtml(name,'1.1em');
    const countEl=drilldown
      ? `<a class="ci-count" href="#" data-filter-country="${esc(name)}" data-filter-count="${count}" title="Show check-ins for ${esc(name)}">${count.toLocaleString()}</a>`
      : `<span class="ci-count">${count.toLocaleString()}</span>`;
    return `<div class="country-item"><span class="ci-rank">#${rank}</span>`+
      `<span class="ci-name" title="${esc(name)}">${f} ${esc(name)}</span>`+
      countEl+`</div>`;
  }).join('');
}
