        ${f.airline?`<div class="fl-rc-airline">${esc(f.airline)}</div>`:''}
        <div class="fl-rc-row"><span class="fl-rc-lbl">Date</span><span>${esc(f.date||'')}</span></div>
        ${ac?`<div class="fl-rc-row"><span class="fl-rc-lbl">Plane</span><span>${ac}</span></div>`:''}
