(function(){
  const photos={{PHOTOS_RECENT_JSON}};
  if(!photos||!photos.length)return;
  document.getElementById('photosFeedSection').style.display='';
  document.getElementById('photosSub').textContent=photos.length+' most recent';

  let rcgCard=0,rcgPhoto=0;
  function rcgShow(){
    const p=photos[rcgCard];
    document.getElementById('rcGallery-img').src=p.srcs[rcgPhoto];
    const total=p.srcs.length;
    document.getElementById('rcg-counter').textContent=total>1?(rcgPhoto+1)+' / '+total:'';
    document.getElementById('rcg-caption').textContent=p.venue+(p.date?' · '+p.date:'');
    document.getElementById('rcg-prev').style.display=total>1?'':'none';
    document.getElementById('rcg-next').style.display=total>1?'':'none';
  }
  window.rcgOpen=function(i){rcgCard=i;rcgPhoto=0;rcgShow();document.getElementById('rcGallery').classList.add('open');};
  window.rcgClose=function(){document.getElementById('rcGallery').classList.remove('open');document.getElementById('rcGallery-img').src='';};
  window.rcgPrev=function(){const n=photos[rcgCard].srcs.length;rcgPhoto=(rcgPhoto-1+n)%n;rcgShow();};
  window.rcgNext=function(){const n=photos[rcgCard].srcs.length;rcgPhoto=(rcgPhoto+1)%n;rcgShow();};
