      </div>
      <div class="fl-rc-route-names">${esc(f.from_name||'')} → ${esc(f.to_name||'')}</div>
    </div>`;
  }).join('');
  // Trigger logo loads after innerHTML is set
  fl.forEach((f,i)=>{ if(f.airline_iata){ const el=document.getElementById(`flrc_logo_${i}`); if(el) window._setAirlineLogo(el, f.airline_iata); } });
})();

