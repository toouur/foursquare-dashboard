    const ac=esc(f.aircraft_code||f.aircraft||'');
    const logoId=`flrc_logo_${i}`;
    return `<div class="recent-card flight-rc-card">
      <div class="fl-rc-head">
        ${f.airline_iata?`<img class="fl-rc-logo" id="${logoId}" alt=""/><span class="fl-rc-logo-fallback" style="display:none;">✈</span>`:`<span class="fl-rc-logo-fallback">✈</span>`}
