<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tips — Check-in Journal</title>
<meta name="description" content="1,900+ personal Foursquare tips for venues across {{COUNTRIES}} countries, with agree counts and venue status. Sorted by date, popularity or venue type.">
<link rel="canonical" href="https://4sq.pages.dev/tips.html">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Check-in Journal">
<meta property="og:title" content="Tips — Check-in Journal">
<meta property="og:description" content="1,900+ personal Foursquare tips for venues across {{COUNTRIES}} countries, with agree counts and venue status. Sorted by date, popularity or venue type.">
<meta property="og:url" content="https://4sq.pages.dev/tips.html">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Tips — Check-in Journal">
<meta name="twitter:description" content="1,900+ personal Foursquare tips for venues across {{COUNTRIES}} countries, with agree counts and venue status. Sorted by date, popularity or venue type.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link rel="preconnect" href="https://unpkg.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&family=DM+Sans:wght@400;600&family=DM+Mono&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/6.6.6/css/flag-icons.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root{--bg:#0c0e14;--card:#12141c;--card2:#181a24;--border:#222738;--text:#e0e2ec;--muted:#6b7280;--gold:#e8b86d;--teal:#4ec9b0;}
body.light{--bg:#ddd8cf;--card:#f0ece3;--card2:#e5e0d7;--border:#aaa49a;--gold:#7a3e00;--teal:#155c58;--muted:#54576a;--text:#15172a;--text2:#373b58;}
body.light header{background:linear-gradient(160deg,#d6d1c8 0%,#dedad1 70%);}
body.light .side-nav{background:rgba(220,215,208,0.97);}
body.light .side-nav a:hover,body.light .side-nav button:hover{background:rgba(0,0,0,.08);}
body.light .heatmap-tooltip,body.light .map-status{background:rgba(220,215,208,0.97);}
body.light .card{box-shadow:0 2px 8px rgba(0,0,0,.10);}
body.light a{color:var(--teal);}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;}
.page{display:flex;flex-direction:column;height:100vh;}

/* ── Top bar ── */
.topbar{display:flex;align-items:center;gap:8px;padding:8px 16px;border-bottom:1px solid var(--border);background:var(--card);flex-shrink:0;z-index:200;flex-wrap:wrap;min-height:48px;}
.topbar h1{font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:900;background:linear-gradient(130deg,#f5d48a,#e8b86d 50%,#b97c30);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;padding:.05em 0 .12em;display:inline-block;white-space:nowrap;}
.back-link{color:var(--gold);text-decoration:none;font-size:.72rem;font-weight:600;opacity:.8;white-space:nowrap;}
.back-link:hover{opacity:1;}
.page-insight{padding:7px 16px;font-family:'DM Sans',sans-serif;font-size:.78rem;color:var(--muted);font-style:italic;border-bottom:1px solid var(--border);background:var(--card);line-height:1.5;flex-shrink:0;}
.topnav{display:flex;align-items:center;gap:20px;padding:14px 16px;border-bottom:1px solid var(--border);background:var(--card);flex-shrink:0;}
.topnav-logo{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--gold);text-decoration:none;margin-right:4px;white-space:nowrap;}
.topnav-logo:hover{opacity:.85;}
.topnav a{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);text-decoration:none;transition:color .2s;}
.topnav a:hover{color:var(--gold);}
.topnav-current{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--text);}
.gs-btn{font-family:'DM Mono',monospace;font-size:.60rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:7px 14px;cursor:pointer;display:flex;align-items:center;gap:7px;transition:all .2s;white-space:nowrap;}
.gs-btn:hover{border-color:var(--gold);color:var(--gold);}
.gs-btn kbd{font-family:'DM Mono',monospace;font-size:.52rem;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:3px;padding:1px 5px;letter-spacing:0;}
@media(max-width:520px){.gs-btn kbd{display:none;}}
.gs-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10000;backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding-top:16vh;}.gs-overlay.open{display:flex;}
.gs-modal{background:var(--card);border:1px solid var(--border);border-radius:14px;width:min(560px,92vw);overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.7);}
.gs-input-wrap{display:flex;align-items:center;gap:10px;padding:14px 18px;}
.gs-icon{font-size:1rem;color:var(--muted);}
.gs-input{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-family:'DM Sans',sans-serif;font-size:.95rem;}
.gs-input::placeholder{color:var(--muted);}
.gs-esc-hint{font-family:'DM Mono',monospace;font-size:.52rem;color:var(--muted);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:3px;padding:2px 6px;cursor:pointer;flex-shrink:0;}
.side-nav{position:fixed;right:0;top:50%;transform:translateY(-50%);z-index:4000;display:flex;flex-direction:column;gap:0;background:rgba(18,21,31,0.92);border:1px solid var(--border);border-right:none;border-radius:10px 0 0 10px;backdrop-filter:blur(10px);overflow:hidden;}
.side-nav a,.side-nav button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;width:52px;padding:6px 4px;border:none;background:none;cursor:pointer;color:var(--muted);text-decoration:none;transition:color .15s,background .15s;-webkit-tap-highlight-color:transparent;}
.side-nav a:hover,.side-nav button:hover{background:rgba(255,255,255,.06);color:var(--text);}
.side-nav a.active,.side-nav button.active{color:var(--gold);}
.side-nav .sn-icon{font-size:.82rem;line-height:1;display:inline-block;transition:transform .15s;}
.side-nav a:hover .sn-icon,.side-nav button:hover .sn-icon{transform:scale(1.28);}
.side-nav .sn-lbl{font-family:'DM Mono',monospace;font-size:.42rem;text-transform:uppercase;letter-spacing:.05em;line-height:1;white-space:nowrap;}
.side-nav .sn-sep{width:32px;height:1px;background:var(--border);margin:1px auto;}
.side-nav .sn-sep--pages{width:36px;height:2px;background:var(--border);margin:2px auto;border-radius:1px;}
@media(max-width:900px){.side-nav{display:none;}}
.tb-right{margin-left:auto;display:flex;align-items:center;gap:8px;}
.srch{background:var(--card2);border:1px solid var(--border);border-radius:7px;padding:5px 10px;color:var(--text);font-size:.73rem;outline:none;width:185px;}
.srch:focus{border-color:var(--gold);}
.badge{font-size:.63rem;color:var(--muted);font-family:'DM Mono',monospace;white-space:nowrap;}
.sbtn{background:var(--card2);border:1px solid var(--border);border-radius:7px;color:var(--muted);padding:4px 9px;cursor:pointer;font-size:.70rem;transition:all .12s;font-family:'DM Sans',sans-serif;}
.sbtn:hover{border-color:var(--gold);color:var(--gold);}
.sbtn.act{border-color:var(--gold);color:var(--gold);background:rgba(232,184,109,.08);}
.nav-btn{background:var(--card2);border:1px solid var(--border);border-radius:7px;color:var(--muted);padding:4px 9px;cursor:pointer;font-size:.70rem;transition:all .12s;white-space:nowrap;font-family:'DM Sans',sans-serif;}
.nav-btn:hover{border-color:var(--gold);color:var(--gold);}

/* ── Tab bars ── */
.tabs-wrap{display:flex;align-items:center;border-bottom:1px solid var(--border);background:var(--card);flex-shrink:0;}
.tabs-arrow{background:transparent;border:none;color:var(--muted);padding:0 6px;cursor:pointer;font-size:.8rem;flex-shrink:0;line-height:28px;transition:color .12s;}
.tabs-arrow:hover{color:var(--gold);}
.tabs-row{display:flex;align-items:center;gap:4px;padding:4px 2px;flex:1;overflow-x:auto;flex-wrap:nowrap;scrollbar-width:none;}
.tabs-row::-webkit-scrollbar{display:none;}
.tab-btn{background:transparent;border:1px solid transparent;border-radius:6px;color:var(--muted);padding:3px 9px;cursor:pointer;font-size:.68rem;white-space:nowrap;font-family:'DM Sans',sans-serif;transition:all .12s;flex-shrink:0;}
.tab-btn:hover{border-color:var(--border);color:var(--text);}
.tab-btn.act{border-color:var(--gold);color:var(--gold);background:rgba(232,184,109,.08);}
.tab-count{font-family:'DM Mono',monospace;font-size:.60rem;opacity:.55;}
.cities-wrap{display:none;}
.cities-wrap.vis{display:flex;}

/* ── Layout ── */
.content{display:flex;flex:1;overflow:hidden;}
.feed-col{width:420px;flex-shrink:0;overflow:hidden;display:flex;flex-direction:column;border-right:1px solid var(--border);}
.feed-scroll{flex:1;overflow-y:auto;padding:8px;}
.feed-scroll::-webkit-scrollbar{width:3px;}
.feed-scroll::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:2px;}
.map-col{flex:1;position:relative;min-width:0;}
#map{position:absolute;inset:0;}
.leaflet-container{background:#0c0e14;}

/* ── Tip card ── */
.tcard{background:var(--card);border:1px solid var(--border);border-radius:11px;padding:13px 16px 11px;margin-bottom:8px;cursor:pointer;transition:border-color .15s;position:relative;overflow:hidden;}
.tcard::after{content:'';position:absolute;top:0;left:16px;right:16px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.25;}
.tcard:hover{border-color:rgba(232,184,109,.35);}
.tcard.sel{border-color:var(--gold);}
.tc-venue-row{display:flex;align-items:flex-start;gap:7px;margin-bottom:7px;}
.tc-cat-icon{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;}
.tc-venue{font-size:.86rem;font-weight:700;line-height:1.28;flex:1;}
.tc-venue a{color:var(--text);text-decoration:none;}
.tc-venue a:hover{color:var(--gold);}
.tc-text{font-size:.83rem;color:var(--text);line-height:1.55;margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;}
.tc-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:5px;}
.tc-cat{font-family:'DM Mono',monospace;font-size:.56rem;text-transform:uppercase;letter-spacing:.06em;color:var(--teal);white-space:nowrap;}
.tc-loc{font-size:.70rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;}
.tc-agree{font-family:'DM Mono',monospace;font-size:.62rem;color:var(--gold);white-space:nowrap;}
.tc-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;}
.tc-date{font-family:'DM Mono',monospace;font-size:.60rem;color:var(--muted);}
.tc-fsq{font-family:'DM Mono',monospace;font-size:.58rem;color:var(--muted);text-decoration:none;}
.tc-fsq:hover{color:var(--gold);}
.tc-closed{font-family:'DM Mono',monospace;font-size:.50rem;color:#ef4444;border:1px solid rgba(239,68,68,.45);border-radius:3px;padding:1px 4px;margin-left:5px;vertical-align:middle;white-space:nowrap;line-height:1.4;}
.tc-deleted{font-family:'DM Mono',monospace;font-size:.50rem;color:#a78bfa;border:1px solid rgba(167,139,250,.45);border-radius:3px;padding:1px 4px;margin-left:5px;vertical-align:middle;white-space:nowrap;line-height:1.4;}
.tc-loc{display:inline-flex;align-items:center;gap:3px;}
.tc-views{font-family:'DM Mono',monospace;font-size:.60rem;color:var(--muted);white-space:nowrap;}
.tc-photo{width:100%;height:120px;object-fit:cover;border-radius:6px;margin-bottom:8px;display:block;cursor:zoom-in;}
#tipLightbox{display:none;position:fixed;inset:0;background:rgba(0,0,0,.94);z-index:9999;align-items:center;justify-content:center;}
#tipLightbox.open{display:flex;}
#tipLightbox img{max-width:90vw;max-height:90vh;object-fit:contain;border-radius:6px;}
#tipLightbox-close{position:absolute;top:16px;right:20px;font-size:1.8rem;color:#fff;cursor:pointer;background:none;border:none;line-height:1;}

/* ── Map popup ── */
.leaflet-popup-content-wrapper{background:var(--card2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:.80rem;}
.leaflet-popup-tip{background:var(--card2);}
.leaflet-popup-content{margin:10px 14px;}

@media(max-width:700px){.feed-col{width:100%;border-right:none;}.map-col{display:none;}}
@media(max-width:480px){
  .topbar{padding:6px 10px;gap:5px;min-height:auto;}
  .topbar h1{font-size:1rem;}
  .srch{width:100%;order:10;margin-top:4px;}
  .tb-right{flex-wrap:wrap;gap:5px;}
  .sbtn,.nav-btn{font-size:.64rem;padding:3px 7px;}
  .badge{display:none;}
  .tabs-wrap .tabs-row{gap:2px;}
  .tab-btn{font-size:.62rem;padding:2px 7px;}
  .tcard{padding:10px 12px 9px;}
  .tc-text{font-size:.79rem;-webkit-line-clamp:3;}
  .tc-venue{font-size:.82rem;}
  .tc-views{display:none;}
}
</style>
</head>
<body>
<div class="page">
  <nav class="topnav">
    <a href="index.html" class="topnav-logo">Check-in Journal</a>
    <span class="topnav-current">Tips</span>
    <button class="gs-btn" style="margin-left:auto" onclick="gsOpen()"><span>⌕</span> Search<kbd>⌘K</kbd></button>
  </nav>
<div class="gs-overlay" id="gsOverlay" onclick="if(event.target===this)gsClose()">
  <div class="gs-modal"><div class="gs-input-wrap"><span class="gs-icon">⌕</span><input class="gs-input" id="gsInput" type="text" placeholder="Search venues, cities, trips…" autocomplete="off" spellcheck="false"><span class="gs-esc-hint" onclick="gsClose()">esc</span></div></div>
</div>
  <div class="topbar">
    <h1>Tips</h1>
    <button class="sbtn act" id="sDate" onclick="sortBy('date',this)">By Date ↓</button>
    <button class="sbtn" id="sAgree" onclick="sortBy('agree',this)">👍 By Agree ↓</button>
    <button class="sbtn" id="sViews" onclick="sortBy('views',this)">👁 By Views ↓</button>
    <button class="sbtn" id="sClosed" onclick="toggleClosed(this)">Closed only</button>
    <button class="sbtn" id="sDeleted" onclick="toggleDeleted(this)">Deleted only</button>
    <div class="tb-right">
      <input class="srch" id="srch" type="text" placeholder="Search tips, venues, cities…" oninput="onSearch(this.value)">
      <span class="badge" id="badge"></span>
    </div>
  </div>
  <div class="page-insight" id="page-insight"></div>
  <div class="tabs-wrap" id="ctryWrap">
    <button class="tabs-arrow" onclick="scrollTabs('ctryTabs',-160)">◀</button>
    <div class="tabs-row" id="ctryTabs"></div>
    <button class="tabs-arrow" onclick="scrollTabs('ctryTabs',160)">▶</button>
  </div>
  <div class="tabs-wrap cities-wrap" id="cityWrap">
    <button class="tabs-arrow" onclick="scrollTabs('cityTabs',-160)">◀</button>
    <div class="tabs-row" id="cityTabs"></div>
    <button class="tabs-arrow" onclick="scrollTabs('cityTabs',160)">▶</button>
  </div>
  <div class="content">
    <div class="feed-col">
      <div class="feed-scroll" id="feedScroll"></div>
    </div>
    <div class="map-col">
      <div id="map"></div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const ALL = TIPS_DATA_PLACEHOLDER;
const TABS_DATA = TABS_DATA_PLACEHOLDER;

// ── Page insight ───────────────────────────────────────────────────────────
(function(){
  if (!ALL.length) return;
  var ctrSet = new Set(ALL.map(function(t){return t.country;}).filter(Boolean));
  var oldest = ALL[ALL.length - 1];
  var newest = ALL[0];
  var oldYr  = oldest && oldest.ts ? new Date(oldest.ts * 1000).getFullYear() : '';
  var newYr  = newest && newest.ts ? new Date(newest.ts * 1000).getFullYear() : '';
  var yearSpan = (oldYr && newYr && oldYr !== newYr) ? oldYr + '–' + newYr : (oldYr || '');
  var txt = ALL.length.toLocaleString() + ' tips written across ' + ctrSet.size + ' countries'
    + (yearSpan ? ', ' + yearSpan : '') + '. '
    + 'Every note is a recommendation that no algorithm asked for.';
  var el = document.getElementById('page-insight');
  if (el) el.textContent = txt;
})();

const CTRY_CODE = {{CTRY_CODE_JSON}};

function flagHtml(c){const code=(CTRY_CODE[c]||'').toLowerCase();return code?`<span class="fi fi-${code}" style="border-radius:2px;font-size:.85em;vertical-align:middle;"></span> `:''}
const esc=s=>(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

const CAT_ICON = {{CAT_ICON_JSON}};
function catIcon(cat){
  const entry=CAT_ICON[cat||''];
  if(!entry) return{em:'📍',bg:'#4a5270'};
  return{em:entry[0],bg:entry[1]};
}

// ── Map ──────────────────────────────────────────────────────────────────────
const map=L.map('map',{preferCanvas:true}).setView([30,15],2);
L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',{attribution:'&copy; OpenStreetMap &copy; CARTO',subdomains:'abcd',maxZoom:19}).addTo(map);

const markers={};
let selMarker=null;
ALL.forEach((t,i)=>{
  if(t.lat==null||t.lng==null)return;
  const{em,bg}=catIcon(t.category||'');
  const m=L.circleMarker([t.lat,t.lng],{radius:6,fillColor:bg,fillOpacity:.75,color:bg,weight:1}).addTo(map);
  const tipPreview=esc((t.text||'').slice(0,90))+(t.text&&t.text.length>90?'…':'');
  m.bindPopup(`<b>${esc(t.venue||'')}</b><br><span style="font-size:.75rem;color:#9ca3af;">${esc(t.city||'')}${t.country?', '+esc(t.nc||t.country):''}</span><br><br><i style="font-size:.78rem;">"${tipPreview}"</i>`,{maxWidth:220});
  markers[i]=m;
});

// ── Tabs ─────────────────────────────────────────────────────────────────────
let selCountry='', selCity='';

function buildCtryTabs(){
  const total=ALL.length;
  let html=`<button class="tab-btn ${!selCountry?'act':''}" onclick="setCountry('')">All <span class="tab-count">${total}</span></button>`;
  for(const[c,d]of Object.entries(TABS_DATA)){
    const f=flagHtml(c);
    html+=`<button class="tab-btn ${selCountry===c?'act':''}" onclick='setCountry(${JSON.stringify(c)})'>${f}${esc(c)} <span class="tab-count">${d.total}</span></button>`;
  }
  document.getElementById('ctryTabs').innerHTML=html;
}

function scrollTabs(id,dx){document.getElementById(id).scrollBy({left:dx,behavior:'smooth'});}

function buildCityTabs(){
  const row=document.getElementById('cityTabs');
  const wrap=document.getElementById('cityWrap');
  if(!selCountry){wrap.classList.remove('vis');return;}
  const d=TABS_DATA[selCountry];
  if(!d){wrap.classList.remove('vis');return;}
  wrap.classList.add('vis');
  let html=`<button class="tab-btn ${!selCity?'act':''}" onclick="setCity('')">All cities <span class="tab-count">${d.total}</span></button>`;
  for(const[c,n]of d.cities){
    if(!c)continue;
    html+=`<button class="tab-btn ${selCity===c?'act':''}" onclick='setCity(${JSON.stringify(c)})'>${esc(c)} <span class="tab-count">${n}</span></button>`;
  }
  row.innerHTML=html;
}

function setCountry(c){selCountry=c;selCity='';buildCtryTabs();buildCityTabs();render();}
function setCity(c){selCity=c;buildCityTabs();render();}

// ── Filter & sort ────────────────────────────────────────────────────────────
let sortMode='date', sortDir=1, query='', showClosed=false, showDeleted=false;

function getFiltered(){
  const q=query.toLowerCase();
  return ALL.map((_,i)=>i).filter(i=>{
    const t=ALL[i];
    if(selCountry && t.nc!==selCountry) return false;
    if(selCity && t.nci!==selCity) return false;
    if(showClosed && !t.closed) return false;
    if(showDeleted && !t.deleted) return false;
    if(!q) return true;
    return (t.text||'').toLowerCase().includes(q)||(t.venue||'').toLowerCase().includes(q)||(t.city||'').toLowerCase().includes(q)||(t.country||'').toLowerCase().includes(q)||(t.category||'').toLowerCase().includes(q);
  });
}

function render(){
  let idx=getFiltered();
  if(sortMode==='date' && sortDir===-1) idx.reverse();
  if(sortMode==='agree') idx.sort((a,b)=>sortDir*((ALL[b].agree_count||0)-(ALL[a].agree_count||0)));
  if(sortMode==='views') idx.sort((a,b)=>sortDir*((ALL[b].view_count||0)-(ALL[a].view_count||0)));
  document.getElementById('badge').textContent=idx.length+' / '+ALL.length+' tips';
  document.getElementById('feedScroll').innerHTML=idx.map(i=>{
    const t=ALL[i];
    const{em,bg}=catIcon(t.category||'');
    const vUrl=t.venue_id?`https://foursquare.com/v/${t.venue_id}`:'';
    const tUrl=t.id?`https://foursquare.com/item/${t.id}`:'';
    const f=t.nc?flagHtml(t.nc):'';
    const loc=[t.nci||t.city,t.nc||t.country].filter(Boolean).join(', ');
    const agree=t.agree_count>0?`<span class="tc-agree">👍 ${t.agree_count}</span>`:'';
    const views=t.view_count>0?`<span class="tc-views">👁 ${t.view_count}</span>`:'';
    const closedBadge=t.closed?'<span class="tc-closed">CLOSED</span>':'';
    const deletedBadge=t.deleted?'<span class="tc-deleted">DELETED</span>':'';
    const venueLabel=vUrl?`<a href="${vUrl}" target="_blank" rel="noopener" onclick="event.stopPropagation()">${esc(t.venue||'Unknown venue')}</a>`:esc(t.venue||'Unknown venue');
    const photoEl=t.photo_url?`<img class="tc-photo" src="${t.photo_url}" loading="lazy" alt="" onclick="event.stopPropagation();openTipPhoto('${t.photo_url}')">`:'';
    return `<div class="tcard" id="tc_${i}" onclick="selectTip(${i})">
      ${photoEl}
      <div class="tc-venue-row">
        <div class="tc-cat-icon" style="background:${bg}22;border:1px solid ${bg}55">${em}</div>
        <div class="tc-venue">${venueLabel}${closedBadge}${deletedBadge}</div>
      </div>
      <div class="tc-text">${esc(t.text||'')}</div>
      <div class="tc-meta">
        <span class="tc-cat">${esc(t.category||'')}</span>
        <span class="tc-loc">${f}${esc(loc)}</span>
        ${agree}
      </div>
      <div class="tc-foot">
        <span class="tc-date">${t.date}</span>
        ${views}
        ${tUrl?`<a class="tc-fsq" href="${tUrl}" target="_blank" rel="noopener" onclick="event.stopPropagation()">↗ foursquare</a>`:''}
      </div>
    </div>`;
  }).join('');
}

function selectTip(i){
  if(selMarker)selMarker.setStyle({radius:6,weight:1});
  document.querySelectorAll('.tcard.sel').forEach(el=>el.classList.remove('sel'));
  const el=document.getElementById('tc_'+i);
  if(el){el.classList.add('sel');el.scrollIntoView({block:'nearest',behavior:'smooth'});}
  if(markers[i]){
    markers[i].setStyle({radius:10,weight:2});
    selMarker=markers[i];
    map.panTo([ALL[i].lat,ALL[i].lng],{animate:true});
    markers[i].openPopup();
  }
}

function onSearch(v){query=v;render();}
function toggleClosed(el){showClosed=!showClosed;el.classList.toggle('act');render();}
function toggleDeleted(el){showDeleted=!showDeleted;el.classList.toggle('act');render();}
const SORT_LABELS={'date':'By Date','agree':'👍 By Agree','views':'👁 By Views'};
function sortBy(mode,el){
  if(sortMode===mode) sortDir*=-1; else{sortMode=mode;sortDir=1;}
  document.querySelectorAll('.sbtn:not(#sClosed):not(#sDeleted)').forEach(b=>{
    const m=b.id==='sDate'?'date':b.id==='sAgree'?'agree':'views';
    b.textContent=SORT_LABELS[m]+(b===el?(sortDir===1?' ↓':' ↑'):'  ↓');
    b.classList.toggle('act',b===el);
  });
  render();
}

buildCtryTabs();
render();

function openTipPhoto(url){
  document.getElementById('tipLightbox-img').src=url;
  document.getElementById('tipLightbox').classList.add('open');
}
function closeTipPhoto(){
  document.getElementById('tipLightbox').classList.remove('open');
  document.getElementById('tipLightbox-img').src='';
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeTipPhoto();});
(function(){const _q=new URLSearchParams(location.search).get('q');if(_q){const _inp=document.getElementById('srch');if(_inp){_inp.value=_q;onSearch(_q);}}})();
</script>
<div id="tipLightbox" onclick="closeTipPhoto()">
  <img id="tipLightbox-img" src="" alt="" onclick="event.stopPropagation()">
  <button id="tipLightbox-close" onclick="closeTipPhoto()">&#10005;</button>
</div>
<script>
function gsOpen(){document.getElementById('gsOverlay').classList.add('open');document.getElementById('gsInput').focus();}
function gsClose(){document.getElementById('gsOverlay').classList.remove('open');}
document.getElementById('gsInput').addEventListener('keydown',function(e){if(e.key==='Enter'&&this.value.trim()){location.href='search.html?q='+encodeURIComponent(this.value.trim());}if(e.key==='Escape')gsClose();});
document.addEventListener('keydown',function(e){if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();gsOpen();}if(e.key==='Escape'&&document.getElementById('gsOverlay').classList.contains('open'))gsClose();});
</script>
