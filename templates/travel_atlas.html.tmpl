  let h=btn(page-1,'‹',page===1);const set=new Set([1,pages,page-1,page,page+1].filter(p=>p>=1&&p<=pages));let last=0;
  [...set].sort((a,b)=>a-b).forEach(p=>{if(p-last>1)h+='<span class="gap">…</span>';h+=btn(p,fmt(p),false,p===page);last=p});
