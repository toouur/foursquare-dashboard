  const many=L.length>3000;
  for(const i of L){const xy=plProj([P[i][4],P[i][3]]);if(!xy)continue;const r=many?1.4:Math.min(7,1.8+Math.sqrt(P[i][5])/2);ctx.beginPath();ctx.arc(xy[0],xy[1],r,0,6.283);ctx.fill()}
  ctx.globalAlpha=1;
  if(plState.sel!=null&&P[plState.sel][3]!=null){const xy=plProj([P[plState.sel][4],P[plState.sel][3]]);if(xy){ctx.fillStyle=hot;ctx.strokeStyle=cs.getPropertyValue('--paper').trim();ctx.lineWidth=2;ctx.beginPath();ctx.arc(xy[0],xy[1],7,0,6.283);ctx.fill();ctx.stroke()}}
  $('#plNote').textContent=`${fmt(L.length)} ${plural(L.length,'точка','точки','точек')} на карте`+(WORLD?'':' · контуры стран недоступны офлайн');
}
function plPick(e){if(!plProj)return;const r=plCanvas.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;let best=-1,bd=196;for(const i of plFiltered){if(P[i][3]==null)continue;const xy=plProj([P[i][4],P[i][3]]);if(!xy)continue;const d=(xy[0]-x)**2+(xy[1]-y)**2;if(d<bd||(d===bd&&P[i][5]>P[best][5])){bd=d;best=i}}if(best>=0)plSelect(best)}
function plSideEmpty(){$('#plSide').innerHTML=`<div><div class="kicker">Как искать</div><h3 style="margin-top:6px">Найди место из своей истории</h3></div><p class="muted" style="margin:0">Начни вводить название — кафе, вокзал, площадь — или выбери страну и город. Карта сама приблизится к найденному.</p><div class="mini"><div><strong>${fmt(P.length)}</strong><span>мест</span></div><div><strong>${fmt(P.filter(p=>p[5]>1).length)}</strong><span>с повторами</span></div><div><strong>${fmt(P[0][5])}</strong><span>рекорд визитов</span></div></div>`}
