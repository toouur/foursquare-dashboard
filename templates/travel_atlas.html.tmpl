function drawPlaces(refit){
  if(!plCanvas||!window.d3)return;const box=$('#pmap');const w=box.clientWidth,h=box.clientHeight;if(!w)return;
  const dpr=Math.min(2,devicePixelRatio||1);plCanvas.width=w*dpr;plCanvas.height=h*dpr;const ctx=plCanvas.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);
  const L=plFiltered.filter(i=>P[i][3]!=null);
  if(refit||!plProj||plProj._w!==w||plProj._h!==h){
    const pts=L.length&&L.length<P.length?{type:'MultiPoint',coordinates:L.map(i=>[P[i][4],P[i][3]])}:{type:'Sphere'};
    plProj=d3.geoNaturalEarth1();
    if(pts.type==='Sphere')plProj.fitExtent([[6,6],[w-6,h-6]],pts);else{plProj.fitExtent([[30,30],[w-30,h-30]],pts);const MAX=6e4;if(!isFinite(plProj.scale())||plProj.scale()>MAX||!isFinite(plProj.translate()[0])){plProj.scale(MAX).translate([w/2,h/2]);const xy=plProj(d3.geoCentroid(pts)),t=plProj.translate();plProj.translate([t[0]+w/2-xy[0],t[1]+h/2-xy[1]])}}
    plProj._w=w;plProj._h=h;
  }
  const cs=getComputedStyle(root);ctx.clearRect(0,0,w,h);
  if(WORLD){const path=d3.geoPath(plProj,ctx);ctx.beginPath();WORLD.feats.forEach(f=>path(f));ctx.fillStyle=cs.getPropertyValue('--map-land').trim();ctx.fill();ctx.beginPath();path(WORLD.mesh);ctx.strokeStyle=cs.getPropertyValue('--map-stroke').trim();ctx.lineWidth=.7;ctx.stroke()}
  const acc=cs.getPropertyValue('--accent2').trim(),hot=cs.getPropertyValue('--accent').trim();
