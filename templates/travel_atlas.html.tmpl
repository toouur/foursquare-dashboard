function fillCities(){const s=$('#plCity');const L=plState.c?[...new Set(P.filter(p=>D.C[p[2]]===plState.c).map(p=>p[1]).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ru')):[];s.innerHTML='<option value="">Все города</option>'+L.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');s.disabled=!plState.c;s.value=plState.city}
