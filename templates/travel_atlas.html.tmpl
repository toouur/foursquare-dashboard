function syncPhForm(){$$('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.mode===phState.mode));$('#phQ').value=phState.q;$('#phC').value=phState.c;$('#phY').value=phState.y;$('#phS').value=phState.sort}
