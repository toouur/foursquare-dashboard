/* ================= ATLAS ================= */
let atlasSel=null,mapLayer='countries',routeYear='all',svgSel=null,zoomB=null;
RENDER['world-atlas']=(sec,arg,first)=>{
  if(!first){setWhere(atlasSel?atlasSel.ru:'');return}
  const years=[...new Set(D.routes.map(r=>r[4]))].sort((a,b)=>b-a);
  sec.innerHTML=`<div class="ch-head"><div><div class="kicker">Глава I</div><h2>Атлас</h2><p>Цвет страны — сколько там было чекинов. Нажми на страну, чтобы увидеть сводку, или открой её разворот. Колёсико или щипок — масштаб.</p></div></div>
  <div class="atlas">
    <div class="mapcard" id="mapcard">
      <div class="map-tools"><div class="seg" role="group" aria-label="Слой карты">
        <button type="button" data-layer="countries" aria-pressed="true">Страны</button><button type="button" data-layer="cities" aria-pressed="false">Города</button><button type="button" data-layer="routes" aria-pressed="false">Переезды</button></div>
        <select id="routeYear" aria-label="Год переездов" hidden><option value="all">Все годы</option>${years.map(y=>`<option>${y}</option>`).join('')}</select></div>
      <div id="mapMount" style="aspect-ratio:1.95/1;display:grid;place-items:center" class="muted">Готовим карту…</div>
      <div class="zoom"><button type="button" id="zIn" aria-label="Приблизить">+</button><button type="button" id="zOut" aria-label="Отдалить">−</button><button type="button" id="zReset" aria-label="Сбросить масштаб">⟲</button></div>
      <div class="legend" id="legend"></div>
    </div>
    <aside class="side" id="atlasSide" aria-live="polite"></aside>
  </div>`;
  sec.querySelector('.seg').addEventListener('click',e=>{const b=e.target.closest('[data-layer]');if(!b)return;mapLayer=b.dataset.layer;sec.querySelectorAll('[data-layer]').forEach(x=>x.setAttribute('aria-pressed',x===b));$('#routeYear').hidden=mapLayer!=='routes';paintLayers()});
  $('#routeYear').addEventListener('change',e=>{routeYear=e.target.value;paintLayers()});
  sideSummary();
  world().then(()=>{drawMap();if(arg)selectCountry(byIso.get(arg))}).catch(()=>{$('#mapMount').innerHTML='<div style="padding:30px;text-align:center">Карте нужен интернет (контуры стран грузятся с CDN). Всё остальное в журнале работает без неё.</div>'});
};
function sideSummary(){
  const top=C.slice(0,8),max=top[0].n;
  $('#atlasSide').innerHTML=`<div><div class="kicker">Вся география</div><h3 style="margin-top:6px">${M.countries} ${plural(M.countries,'страна','страны','стран')}</h3><p class="muted" style="margin:6px 0 0">${hd(M.first)} — ${hd(M.last)}</p></div>
  <div class="mini"><div><strong>${fmt(M.checkins)}</strong><span>чекинов</span></div><div><strong>${fmt(M.cities)}</strong><span>городов</span></div><div><strong>${fmt(M.venues)}</strong><span>мест</span></div></div>
  <div><div class="sub-h">Больше всего чекинов</div><div class="bars">${top.map(c=>`<div class="barrow"><span>${flag(c.en)} ${esc(c.ru)}</span><div class="bar"><i style="width:${Math.max(2,100*Math.sqrt(c.n/max))}%"></i></div><b>${fmt(c.n)}</b></div>`).join('')}</div></div>
  <div class="links" style="margin-top:0"><a class="btn" href="#country/${C[0].iso2}">Листать страны →</a></div>`;
}
let colorOf=()=>'';
function drawMap(){
  const W=960,H=492,mount=$('#mapMount');mount.removeAttribute('style');mount.className='';
  mount.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Карта посещённых стран"><g id="zoomg"><path class="grat"/><g id="lands"></g><g id="routesL"></g><g id="citiesL"></g></g></svg>`;
  const svg=d3.select(mount).select('svg');svgSel=svg;
  const proj=d3.geoNaturalEarth1().fitExtent([[6,8],[W-6,H-8]],{type:'Sphere'}),path=d3.geoPath(proj);
  svg.select('.grat').attr('d',path(d3.geoGraticule10()));
  const vis=new Map(C.filter(c=>c.num).map(c=>[c.num,c]));
  svg.select('#lands').selectAll('path').data(WORLD.feats.filter(f=>f.id!=='010')).join('path')
    .attr('d',path).attr('class',f=>vis.has(String(f.id).padStart(3,'0'))?'c-vis':'c-land')
    .attr('tabindex',f=>vis.has(String(f.id).padStart(3,'0'))?0:null)
    .attr('role',f=>vis.has(String(f.id).padStart(3,'0'))?'button':null)
    .attr('aria-label',f=>{const c=vis.get(String(f.id).padStart(3,'0'));return c?`${c.ru}: ${fmt(c.n)} чекинов`:null})
    .on('click',(e,f)=>{const c=vis.get(String(f.id).padStart(3,'0'));if(c)location.hash='world-atlas/'+c.iso2})
    .on('keydown',(e,f)=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();const c=vis.get(String(f.id).padStart(3,'0'));if(c)location.hash='world-atlas/'+c.iso2}})
    .on('mousemove',(e,f)=>{const c=vis.get(String(f.id).padStart(3,'0'));tip(e,c?`<b>${esc(c.ru)}</b> · ${fmt(c.n)} чекинов · ${fmt(c.c)} ${plural(c.c,'город','города','городов')}`:esc(f.properties?.name||''))})
    .on('mouseleave',untip);
  // small visited countries invisible at 110m: draw as dots
  const missing=C.filter(c=>!c.num||!WORLD.feats.some(f=>String(f.id).padStart(3,'0')===c.num));
  svg.select('#lands').selectAll('circle').data(missing.filter(c=>c.cities[0]&&c.cities[0][2]!=null)).join('circle')
    .attr('class','c-vis').attr('r',3.2).attr('cx',c=>proj([c.cities[0][3],c.cities[0][2]])[0]).attr('cy',c=>proj([c.cities[0][3],c.cities[0][2]])[1])
    .on('click',(e,c)=>{location.hash='world-atlas/'+c.iso2}).on('mousemove',(e,c)=>tip(e,`<b>${esc(c.ru)}</b> · ${fmt(c.n)} чекинов`)).on('mouseleave',untip);
  const line=r=>{const a=proj([r[1],r[0]]),b=proj([r[3],r[2]]);const mx=(a[0]+b[0])/2,my=(a[1]+b[1])/2,dx=b[0]-a[0],dy=b[1]-a[1];return `M${a}Q${mx-dy*.18},${my+dx*.18} ${b}`};
  svg.select('#routesL').selectAll('path').data(D.routes).join('path').attr('class','m-route').attr('d',line)
    .on('mousemove',(e,r)=>tip(e,`${esc(r[7])} → ${esc(r[8])}<br>${hd(r[9])} · ~${fmt(r[10])} км`)).on('mouseleave',untip);
  const cmax=D.cities[0][2];
  svg.select('#citiesL').selectAll('circle').data(D.cities).join('circle').attr('class','m-city')
    .attr('cx',d=>proj([d[4],d[3]])[0]).attr('cy',d=>proj([d[4],d[3]])[1]).attr('r',d=>1.6+5*Math.sqrt(d[2]/cmax))
    .on('mousemove',(e,d)=>tip(e,`<b>${esc(d[0])}</b>, ${esc(ruName(D.C[d[1]]))} · ${fmt(d[2])} чекинов`)).on('mouseleave',untip)
    .on('click',(e,d)=>{location.hash='places/'+encodeURIComponent(D.C[d[1]])+'|'+encodeURIComponent(d[0])});
  const g=svg.select('#zoomg');
  zoomB=d3.zoom().scaleExtent([1,12]).translateExtent([[0,0],[W,H]]).on('zoom',e=>{g.attr('transform',e.transform);svg.selectAll('.m-city').attr('r',d=>(1.6+5*Math.sqrt(d[2]/cmax))/Math.sqrt(e.transform.k))});
  zoomB.filter(e=>(!e.ctrlKey||e.type==='wheel')&&!e.button&&!(e.type==='touchstart'&&e.touches.length<2));
  svg.call(zoomB).on('dblclick.zoom',null).style('touch-action','pan-y');
  $('#zIn').onclick=()=>svg.transition().call(zoomB.scaleBy,1.6);$('#zOut').onclick=()=>svg.transition().call(zoomB.scaleBy,1/1.6);$('#zReset').onclick=()=>svg.transition().call(zoomB.transform,d3.zoomIdentity);
  svgSel.proj=proj;svgSel.path=path;
  paintMap();paintLayers();
}
function paintMap(){
  if(!svgSel)return;
  const cs=getComputedStyle(root),a=cs.getPropertyValue('--map-visited').trim(),lo=cs.getPropertyValue('--map-land').trim();
  const sc=d3.scaleLog().domain([10,25000]).range([0,1]).clamp(true);
  const ip=d3.interpolateLab(d3.interpolateLab(lo,a)(.22),a);
  colorOf=n=>ip(sc(Math.max(10,n)));
  const vis=new Map(C.map(c=>[c.num,c]));
  svgSel.selectAll('#lands path.c-vis').attr('fill',f=>colorOf(vis.get(String(f.id).padStart(3,'0')).n));
  svgSel.selectAll('#lands circle.c-vis').attr('fill',c=>colorOf(c.n));
  $('#legend').innerHTML=`чекинов в стране<div class="ramp" style="background:linear-gradient(90deg,${[0,.25,.5,.75,1].map(t=>ip(t)).join(',')})"></div><div class="ends"><span>10</span><span>25k</span></div>`;
}
function paintLayers(){if(!svgSel)return;svgSel.select('#citiesL').style('display',mapLayer==='cities'?'':'none');svgSel.select('#routesL').style('display',mapLayer==='routes'?'':'none');svgSel.selectAll('.m-route').style('display',r=>routeYear==='all'||String(r[4])===routeYear?'':'none')}
function selectCountry(c){
  if(!c)return;atlasSel=c;setWhere(c.ru);
  svgSel&&svgSel.selectAll('#lands .c-vis').classed('sel',f=>(f.id?String(f.id).padStart(3,'0'):f.num)===c.num||f===c);
  const max=c.cities[0]?.[1]||1;
  $('#atlasSide').innerHTML=`<div><span class="fi fi-${c.iso2}"></span><h3>${esc(c.ru)}</h3><p class="muted" style="margin:6px 0 0">${hrange(c.first,c.last)}</p></div>
  <div class="mini"><div><strong>${fmt(c.n)}</strong><span>чекинов</span></div><div><strong>${fmt(c.v)}</strong><span>мест</span></div><div><strong>${fmt(c.d)}</strong><span>${plural(c.d,'день','дня','дней')}</span></div></div>
  <div><div class="sub-h">Города</div><div class="bars">${c.cities.slice(0,5).map(x=>`<div class="barrow"><span>${esc(x[0])}</span><div class="bar"><i style="width:${Math.max(3,100*x[1]/max)}%"></i></div><b>${fmt(x[1])}</b></div>`).join('')}</div></div>
  <div class="links" style="margin-top:0"><a class="btn" href="#country/${c.iso2}">Разворот страны →</a><button class="btn ghost" type="button" id="backAll">Вся карта</button></div>`;
  $('#backAll').onclick=()=>{atlasSel=null;svgSel&&svgSel.selectAll('.c-vis').classed('sel',false);sideSummary();setWhere('');history.replaceState(null,'','#world-atlas')};
}
const tipEl=$('#tip');
function tip(e,h){tipEl.innerHTML=h;tipEl.style.opacity=1;const x=Math.min(e.clientX+14,innerWidth-tipEl.offsetWidth-8);tipEl.style.left=x+'px';tipEl.style.top=(e.clientY+14)+'px'}
function untip(){tipEl.style.opacity=0}
const _atlasR=RENDER['world-atlas'];RENDER['world-atlas']=(sec,arg,first)=>{_atlasR(sec,arg,first);if(!first&&arg&&WORLD)selectCountry(byIso.get(arg));if(!first&&!arg&&atlasSel){atlasSel=null;svgSel&&svgSel.selectAll('.c-vis').classed('sel',false);sideSummary();setWhere('')}};

