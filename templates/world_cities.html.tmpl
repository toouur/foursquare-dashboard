<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>World Cities — Check-in Journal</title>
<meta name="description" content="838 visited cities across {{COUNTRIES}} countries, filterable by continent. Built from personal Foursquare check-in history.">
<link rel="canonical" href="https://4sq.pages.dev/world_cities.html">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Check-in Journal">
<meta property="og:title" content="World Cities — Check-in Journal">
<meta property="og:description" content="838 visited cities across {{COUNTRIES}} countries, filterable by continent. Built from personal Foursquare check-in history.">
<meta property="og:url" content="https://4sq.pages.dev/world_cities.html">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="World Cities — Check-in Journal">
<meta name="twitter:description" content="838 visited cities across {{COUNTRIES}} countries, filterable by continent. Built from personal Foursquare check-in history.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&family=DM+Sans:wght@400;600&family=DM+Mono&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/6.6.6/css/flag-icons.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="{{SITE_CSS_LINK}}">
<style>
:root{--bg:#0c0e14;--card:#12141c;--card2:#181a24;--border:#222738;--text:#e0e2ec;--muted:#8b93a8;--gold:#e8b86d;--teal:#4ec9b0;}
body.light{--bg:#ddd8cf;--card:#f0ece3;--card2:#e5e0d7;--border:#aaa49a;--gold:#7a3e00;--teal:#155c58;--muted:#54576a;--text:#15172a;--text2:#373b58;}
body.light header{background:linear-gradient(160deg,#d6d1c8 0%,#dedad1 70%);}
body.light .side-nav{background:rgba(220,215,208,0.97);}
body.light .side-nav a:hover,body.light .side-nav button:hover{background:rgba(0,0,0,.08);}
body.light .heatmap-tooltip,body.light .map-status{background:rgba(220,215,208,0.97);}
body.light .card{box-shadow:0 2px 8px rgba(0,0,0,.10);}
body.light a{color:var(--teal);}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;}
.topnav{display:flex;align-items:center;gap:20px;padding:18px 36px;border-bottom:1px solid var(--border);background:var(--card);}
.topnav-logo{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--gold);text-decoration:none;}
.topnav a{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);text-decoration:none;transition:color .2s;}
.topnav a:hover{color:var(--gold);}
.topnav-current{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--text);}
.gs-btn{font-family:'DM Mono',monospace;font-size:.60rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:7px 14px;cursor:pointer;display:flex;align-items:center;gap:7px;transition:all .2s;white-space:nowrap;}
.gs-btn:hover{border-color:var(--gold);color:var(--gold);}
.gs-btn kbd{font-family:'DM Mono',monospace;font-size:.52rem;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:3px;padding:1px 5px;letter-spacing:0;}
@media(max-width:520px){.gs-btn kbd{display:none;}}
.gs-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10000;backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding-top:16vh;}.gs-overlay.open{display:flex;}
.gs-modal{background:var(--card);border:1px solid var(--border);border-radius:14px;width:min(560px,92vw);overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.7);}
.gs-input-wrap{display:flex;align-items:center;gap:10px;padding:14px 18px;}
.gs-icon{font-size:1rem;color:var(--muted);}
.gs-input{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-family:'DM Sans',sans-serif;font-size:.95rem;}
.gs-input::placeholder{color:var(--muted);}
.gs-esc-hint{font-family:'DM Mono',monospace;font-size:.52rem;color:var(--muted);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:3px;padding:2px 6px;cursor:pointer;flex-shrink:0;}
.controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:12px 36px;border-bottom:1px solid var(--border);background:var(--card);position:sticky;top:0;z-index:50;}
.pill{background:var(--card2);border:1px solid var(--border);border-radius:20px;padding:5px 13px;font-size:.72rem;font-weight:600;cursor:pointer;transition:all .15s;color:var(--muted);letter-spacing:.04em;}
.pill.active{background:rgba(232,184,109,.12);border-color:var(--gold);color:var(--gold);}
.pill:hover{border-color:rgba(232,184,109,.4);color:var(--text);}
.visited-tog{display:flex;align-items:center;gap:7px;cursor:pointer;font-size:.72rem;font-weight:600;color:var(--muted);padding:5px 13px;border:1px solid var(--border);border-radius:20px;background:var(--card2);transition:all .15s;}
.visited-tog.on{background:rgba(232,184,109,.12);border-color:var(--gold);color:var(--gold);}
.search-box{background:var(--card2);border:1px solid var(--border);border-radius:20px;padding:5px 14px;color:var(--text);font-size:.72rem;outline:none;margin-left:auto;width:180px;}
.search-box:focus{border-color:var(--gold);}
.count-badge{font-size:.68rem;color:var(--muted);font-family:'DM Mono',monospace;white-space:nowrap;}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:6px;padding:16px 36px 40px;max-width:1320px;margin:0 auto;}
.city-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:7px 10px;transition:border-color .15s;}
.city-card.visited{background:linear-gradient(160deg,rgba(255,154,107,.14),var(--card) 70%);border-color:rgba(255,154,107,.35);}
.city-card:hover{border-color:rgba(232,184,109,.5);}
.city-name{font-size:.76rem;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.city-link{color:inherit;text-decoration:none;}.city-link:hover{color:#ff9a6b;text-decoration:underline;text-underline-offset:3px;}
.city-country{font-size:.64rem;color:var(--muted);}
.city-pop{font-size:.60rem;font-family:'DM Mono',monospace;color:var(--muted);margin-top:4px;}
.city-cnt{font-size:.68rem;font-family:'DM Mono',monospace;color:var(--gold);margin-top:2px;}
.cont-header{grid-column:1/-1;font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--gold);padding:8px 0 4px;border-bottom:1px solid var(--border);margin-top:8px;}
.more-cities{grid-column:1/-1;justify-self:center;margin-top:10px;background:var(--card2);border:1px solid var(--border);border-radius:999px;padding:10px 22px;font-family:'DM Mono',monospace;font-size:.64rem;letter-spacing:.06em;color:var(--text);cursor:pointer;}
.more-cities:hover{border-color:var(--gold);color:var(--gold);}
.no-results{grid-column:1/-1;text-align:center;padding:60px;color:var(--muted);font-size:.85rem;}
/* ── overview: progress ring, continents, map, top cities, biggest not yet ── */
.ov{max-width:1320px;margin:0 auto;padding:34px 36px 6px;}
.eyebrow{font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);}
h1.hero{font-family:'Playfair Display',serif;font-weight:900;font-size:clamp(2.2rem,5.2vw,4rem);line-height:1;letter-spacing:-.02em;margin:10px 0 20px;}
h1.hero em,h2.sec em{font-style:normal;background:linear-gradient(135deg,#f6d38b,#ff9a6b 55%,#ff6fae);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.ov-top{display:grid;grid-template-columns:240px minmax(0,1fr);gap:24px;align-items:center;margin-bottom:18px;}
.ring{position:relative;width:220px;height:220px;}
.ring svg{width:100%;height:100%;transform:rotate(-90deg);}
.ring .c{position:absolute;inset:0;display:grid;place-items:center;text-align:center;}
.ring b{display:block;font-family:'Playfair Display',serif;font-weight:900;font-size:3.3rem;line-height:1;background:linear-gradient(135deg,#f6d38b,#ff9a6b 55%,#ff6fae);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.ring span{font-family:'DM Mono',monospace;font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);}
.cts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;}
.ct{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:13px 15px;cursor:pointer;transition:border-color .15s;}
.ct:hover{border-color:var(--gold);}
.cth{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:9px;}
.cth b{font-size:.88rem;}.cth span{font-family:'DM Mono',monospace;font-size:.62rem;color:var(--gold);}
.cb{height:8px;border-radius:4px;background:var(--card2);overflow:hidden;}
.cb i{display:block;height:100%;border-radius:4px;background:linear-gradient(90deg,#f6d38b,#ff9a6b 60%,#ff6fae);}
#wcMap{height:480px;border-radius:22px;border:1px solid var(--border);background:#0c0e14;margin:6px 0 30px;}
.leaflet-container{background:#0c0e14;}
.leaflet-popup-content-wrapper{background:var(--card2);color:var(--text);border:1px solid var(--border);font-family:'DM Sans',sans-serif;}
.leaflet-popup-tip{background:var(--card2);}
h2.sec{font-family:'Playfair Display',serif;font-weight:700;font-size:clamp(1.5rem,3vw,2.2rem);margin:0 0 14px;display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap;}
h2.sec small{font-family:'DM Mono',monospace;font-weight:400;font-size:.58rem;color:var(--muted);background:var(--card2);padding:4px 10px;border-radius:999px;}
.vcs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:30px;}
.vc{background:linear-gradient(160deg,rgba(255,154,107,.12),var(--card) 60%);border:1px solid rgba(255,154,107,.22);border-radius:18px;padding:15px 16px;}
.vc .n{font-weight:700;font-size:.98rem;display:flex;gap:7px;align-items:center;white-space:nowrap;overflow:hidden;}
.vc .n .fi{border-radius:2px;flex-shrink:0;}
.vc .k{font-family:'Playfair Display',serif;font-weight:900;font-size:1.9rem;line-height:1;margin-top:10px;background:linear-gradient(135deg,#f6d38b,#ff9a6b 55%,#ff6fae);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.vc .p{font-family:'DM Mono',monospace;font-size:.56rem;color:var(--muted);margin-top:6px;}
.ncs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:34px;}
.nc{border:1px dashed rgba(155,123,255,.45);border-radius:14px;padding:11px 12px;}
.nc b{display:block;font-size:.86rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.nc span{font-family:'DM Mono',monospace;font-size:.55rem;color:var(--muted);}
.controls{max-width:none;}
@media(max-width:900px){.ov{padding:24px 14px 4px;}.ov-top{grid-template-columns:1fr;}.ring{margin:0 auto;}.cts{grid-template-columns:repeat(2,minmax(0,1fr));}.vcs{grid-template-columns:repeat(2,minmax(0,1fr));}.ncs{grid-template-columns:repeat(3,minmax(0,1fr));}#wcMap{height:340px;}}
@media(max-width:520px){.ncs{grid-template-columns:repeat(2,minmax(0,1fr));}.ring{width:190px;height:190px;}.ring b{font-size:2.8rem;}}
@media(max-width:600px){.grid{padding:12px;gap:6px;}.controls{padding:10px 12px;}.search-box{width:100%;margin-left:0;}}
@media(max-width:480px){.controls{flex-wrap:wrap;}.pill{font-size:.65rem;padding:4px 10px;}.visited-tog{font-size:.65rem;padding:4px 10px;}.search-box{width:100%;order:10;min-width:0;margin-left:0;}.count-badge{order:11;}.grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr));padding:10px 10px 24px;}}
</style>
</head>
<body>
<nav class="topnav">
  <a href="index.html" class="topnav-logo">Check-in Journal</a>
  <span class="topnav-current">World Cities</span>
  <button class="gs-btn" style="margin-left:auto" onclick="gsOpen()"><span>⌕</span> Search<kbd>⌘K</kbd></button>
</nav>
<div class="gs-overlay" id="gsOverlay" onclick="if(event.target===this)gsClose()">
  <div class="gs-modal"><div class="gs-input-wrap"><span class="gs-icon">⌕</span><input class="gs-input" id="gsInput" type="text" placeholder="Search venues, cities, trips…" autocomplete="off" spellcheck="false"><span class="gs-esc-hint" onclick="gsClose()">esc</span></div></div>
</div>
<div class="ov">
  <div class="eyebrow">World cities · every city over ~500k people</div>
  <h1 class="hero" id="wcHero">World cities</h1>
  <div class="ov-top"><div class="ring" id="wcRing"></div><div class="cts" id="wcConts"></div></div>
  <div id="wcMap"></div>
  <h2 class="sec"><span>Where you <em>live</em> it</span><small>most check-ins</small></h2>
  <div class="vcs" id="wcTop"></div>
  <h2 class="sec"><span>The biggest <em>not yet</em></span><small>largest cities still unvisited</small></h2>
  <div class="ncs" id="wcNext"></div>
  <h2 class="sec"><span>All <em>985</em></span><small>filter, search, tap a continent above</small></h2>
</div>
<div class="controls" id="controls">
  <div class="pill active" onclick="filterCont('ALL',this)">All</div>
  <div class="pill" onclick="filterCont('EU',this)">Europe</div>
  <div class="pill" onclick="filterCont('AS',this)">Asia</div>
  <div class="pill" onclick="filterCont('AF',this)">Africa</div>
  <div class="pill" onclick="filterCont('NA',this)">N. America</div>
  <div class="pill" onclick="filterCont('SA',this)">S. America</div>
  <div class="pill" onclick="filterCont('OC',this)">Oceania</div>
  <div class="visited-tog" id="visitedTog" onclick="toggleVisited(this)">✓ Visited</div>
  <input class="search-box" id="srch" type="text" placeholder="Search cities…" oninput="doSearch(this.value)">
  <span class="count-badge" id="countBadge"></span>
</div>
<div class="grid" id="grid"></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const WC=WC_DATA_PLACEHOLDER;
const VISITED=VISITED_DATA_PLACEHOLDER;
const CONT_NAMES={EU:'Europe',AS:'Asia',AF:'Africa',NA:'North America',SA:'South America',OC:'Oceania'};
// Country → continent for disambiguation (same as index.html)
const CTRY_CONT={
  'Belarus':'EU','Moldova':'EU','Poland':'EU','Ukraine':'EU','Italy':'EU','Romania':'EU',
  'Lithuania':'EU','Germany':'EU','Türkiye':'EU','Turkey':'EU','Spain':'EU','France':'EU',
  'Latvia':'EU','Portugal':'EU','United Kingdom':'EU','Czechia':'EU','Czech Republic':'EU',
  'Hungary':'EU','Austria':'EU','Switzerland':'EU','Netherlands':'EU','Belgium':'EU',
  'Slovakia':'EU','Bulgaria':'EU','Greece':'EU','Croatia':'EU','Serbia':'EU',
  'Estonia':'EU','Finland':'EU','Sweden':'EU','Norway':'EU','Denmark':'EU',
  'Iceland':'EU','Ireland':'EU','Slovenia':'EU','North Macedonia':'EU','Albania':'EU',
  'Montenegro':'EU','Bosnia and Herzegovina':'EU','Kosovo':'EU','Malta':'EU',
  'Holy See (Vatican City State)':'EU','San Marino':'EU','Monaco':'EU',
  'Georgia':'AS','China':'AS','India':'AS','Japan':'AS','South Korea':'AS','Taiwan':'AS',
  'Singapore':'AS','Malaysia':'AS','Thailand':'AS','Vietnam':'AS','Indonesia':'AS',
  'Philippines':'AS','Myanmar':'AS','Cambodia':'AS','Bangladesh':'AS','Pakistan':'AS',
  'Nepal':'AS','Sri Lanka':'AS','Kazakhstan':'AS','Uzbekistan':'AS','Tajikistan':'AS',
  'Kyrgyzstan':'AS','Azerbaijan':'AS','Armenia':'AS','Israel':'AS','Jordan':'AS',
  'Lebanon':'AS','Iraq':'AS','Iran':'AS','Oman':'AS','Saudi Arabia':'AS',
  'United Arab Emirates':'AS','Qatar':'AS','Kuwait':'AS','Bahrain':'AS',
  'Cyprus':'EU','Mongolia':'AS','Hong Kong':'AS',
  'Morocco':'AF','Tunisia':'AF','Egypt':'AF','Libya':'AF','Algeria':'AF',
  'Sudan':'AF','Ethiopia':'AF','Kenya':'AF','Tanzania':'AF','South Africa':'AF',
  'Russia':'EU','United States':'NA','Canada':'NA','Mexico':'NA',
  'Cuba':'NA','Jamaica':'NA','Dominican Republic':'NA',
  'Brazil':'SA','Argentina':'SA','Chile':'SA','Colombia':'SA','Peru':'SA',
  'Venezuela':'SA','Ecuador':'SA','Bolivia':'SA','Uruguay':'SA','Paraguay':'SA',
  'New Zealand':'OC','Australia':'OC',
};
const CITY_ALIASES={
  'Salihorsk':['Soligorsk'],'Delhi':['New Delhi'],'Odessa':['Odesa'],
  'Krakow':['Kraków'],'Molodechno':['Maladzyechna'],'Baranavichy':['Baranovichi'],
  'Yangon':['Yangon','Rangoon'],'Mumbai':['Mumbai','Bombay'],
  'Kolkata':['Kolkata','Calcutta'],'Chennai':['Chennai','Madras'],
  'Bangalore':['Bangalore','Bengaluru'],'Grodno':['Hrodna'],
  'Chisinau':['Chișinău','Chisinau'],'Kishinev':['Chișinău'],
  'Wroclaw':['Wrocław'],'Poznan':['Poznań'],'Gdansk':['Gdańsk'],
  'Brest':['Brest','Brest (Брэст)'],
  'Soligorsk':['Salihorsk'],'Novopolotsk':['Navapolatsk'],
};
// VISITED: {cityName: [count, country]} — country enables continent disambiguation
// Returns {cnt, displayName} — displayName is the normalized name from index.html for visited cities
const CITY_PAGES={{CITY_PAGES_JSON}};   // {city: slug} for cities with a city-<slug>.html page
function getVisitInfo(worldName, worldCont){
  function continentOk(country){
    if(!worldCont||!country) return true;
    const vc=CTRY_CONT[country];
    return !vc||vc===worldCont;
  }
  const v=VISITED[worldName];
  if(v){const [cnt,ctry]=v;if(continentOk(ctry)) return {cnt, displayName:worldName};}
  for(const alias of (CITY_ALIASES[worldName]||[])){
    const va=VISITED[alias];
    if(va){const [cnt,ctry]=va;if(continentOk(ctry)) return {cnt, displayName:alias};}
  }
  return {cnt:0, displayName:worldName};
}
function getVisitCount(worldName,worldCont){return getVisitInfo(worldName,worldCont).cnt;}

let curCont='ALL', visitedOnly=false, searchQ='', showAll=false;
const GRID_FIRST=90;   // the rest behind a button: 985 chips were ~33k px on a phone
function filterCont(c,el){
  curCont=c;
  document.querySelectorAll('.pill').forEach(p=>p.classList.remove('active'));
  el.classList.add('active');
  render();
}
function toggleVisited(el){
  visitedOnly=!visitedOnly;
  el.classList.toggle('on',visitedOnly);
  render();
}
function doSearch(q){searchQ=q.toLowerCase().trim();render();}
function showAllCities(){showAll=true;render();}

function render(){
  let data=WC.filter(c=>{
    if(curCont!=='ALL'&&c[4]!==curCont) return false;
    if(visitedOnly&&!getVisitCount(c[0],c[4])) return false;
    if(searchQ&&!c[0].toLowerCase().includes(searchQ)&&!getVisitInfo(c[0],c[4]).displayName.toLowerCase().includes(searchQ)&&!(CONT_NAMES[c[4]]||c[4]).toLowerCase().includes(searchQ)) return false;
    return true;
  });
  data.sort((a,b)=>b[3]-a[3]);
  const total=data.length, vis=data.filter(c=>getVisitCount(c[0],c[4])).length;
  document.getElementById('countBadge').textContent=`${vis} visited / ${total.toLocaleString()} cities`;

  let html='';
  const cut=showAll||searchQ?data.length:GRID_FIRST;
  data.slice(0,cut).forEach(([name,lat,lng,pop,cont])=>{
    const contTag=curCont==='ALL'?`<span style='font-size:.55rem;color:var(--muted);opacity:.5;margin-left:5px;'>${CONT_NAMES[cont]||cont}</span>`:'';
    const {cnt,displayName}=getVisitInfo(name,cont);
    const popStr=pop>=1?`${pop.toFixed(1)}M`:`${Math.round(pop*1000)}k`;
    html+=`<div class="city-card${cnt?' visited':''}">
      <div class="city-name">${cnt&&CITY_PAGES[displayName]?`<a class="city-link" href="city-${CITY_PAGES[displayName]}.html">${displayName}</a>`:displayName}${contTag}</div>
      ${cnt?`<div class="city-cnt">✓ ${cnt.toLocaleString()} check-ins</div>`:''}
      <div class="city-pop">${popStr} pop</div>
    </div>`;
  });
  if(data.length>cut) html+=`<button class="more-cities" onclick="showAllCities()">SHOW ALL ${data.length.toLocaleString()} CITIES ▾</button>`;
  document.getElementById('grid').innerHTML=html||'<div class="no-results">No cities found</div>';
}
render();
// ── Overview: everything counted with the same getVisitInfo (aliases + continent check) as the grid ──
(function(){
  const ISO2={{CTRY_CODE_JSON}};
  const fl=c=>ISO2[c]?`<span class="fi fi-${ISO2[c]}"></span>`:'';
  const rows=WC.map(c=>{const v=getVisitInfo(c[0],c[4]);return {name:v.displayName,lat:c[1],lng:c[2],pop:c[3],cont:c[4],cnt:v.cnt,ctry:(VISITED[v.displayName]||[])[1]||''};});
  const vis=rows.filter(r=>r.cnt), pct=vis.length/rows.length;
  document.getElementById('wcHero').innerHTML=`${vis.length} of the world’s <em>${rows.length} biggest</em>`;
  const R=96,C=2*Math.PI*R;
  document.getElementById('wcRing').innerHTML=`<svg viewBox="0 0 220 220"><defs><linearGradient id="rg" x1="0" x2="1"><stop offset="0" stop-color="#f6d38b"/><stop offset=".55" stop-color="#ff9a6b"/><stop offset="1" stop-color="#ff6fae"/></linearGradient></defs>
    <circle cx="110" cy="110" r="${R}" fill="none" stroke="rgba(255,255,255,.07)" stroke-width="16"/>
    <circle cx="110" cy="110" r="${R}" fill="none" stroke="url(#rg)" stroke-width="16" stroke-linecap="round" stroke-dasharray="${(C*pct).toFixed(1)} ${C.toFixed(1)}"/></svg>
    <div class="c"><div><b>${Math.round(pct*100)}%</b><span>of the list visited</span></div></div>`;
  const conts=Object.keys(CONT_NAMES).map(k=>{const all=rows.filter(r=>r.cont===k);return [k,all.filter(r=>r.cnt).length,all.length];}).filter(c=>c[2]).sort((a,b)=>b[1]/b[2]-a[1]/a[2]);
  document.getElementById('wcConts').innerHTML=conts.map(([k,v,n])=>`<div class="ct" data-k="${k}"><div class="cth"><b>${CONT_NAMES[k]}</b><span>${v} / ${n}</span></div><div class="cb"><i style="width:${Math.round(100*v/n)}%"></i></div></div>`).join('');
  document.querySelectorAll('#wcConts .ct').forEach(el=>el.onclick=()=>{
    const pill=[...document.querySelectorAll('.controls .pill')].find(p=>(p.getAttribute('onclick')||'').includes("'"+el.dataset.k+"'"));
    if(pill){filterCont(el.dataset.k,pill);document.getElementById('controls').scrollIntoView({behavior:'smooth'});}
  });
  document.getElementById('wcTop').innerHTML=vis.slice().sort((a,b)=>b.cnt-a.cnt).slice(0,12).map(r=>
    `<div class="vc"><div class="n">${fl(r.ctry)} ${r.name}</div><div class="k">${r.cnt.toLocaleString()}</div><div class="p">check-ins · ${r.pop.toFixed(1)}M people</div></div>`).join('');
  document.getElementById('wcNext').innerHTML=rows.filter(r=>!r.cnt).sort((a,b)=>b.pop-a.pop).slice(0,12).map(r=>
    `<div class="nc"><b>${r.name}</b><span>${r.pop.toFixed(1)}M · ${CONT_NAMES[r.cont]||r.cont}</span></div>`).join('');
  if(!window.L) return;
  const map=L.map('wcMap',{scrollWheelZoom:false,worldCopyJump:true,zoomSnap:.5}).setView([30,15],2);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png?key={{CARTO_KEY}}',{attribution:'&copy; OpenStreetMap &copy; CARTO',subdomains:'abcd',maxZoom:10}).addTo(map);
  const pm=Math.max(...rows.map(r=>r.pop));
  rows.filter(r=>!r.cnt).forEach(r=>L.circleMarker([r.lat,r.lng],{radius:1.5+5*Math.sqrt(r.pop/pm),stroke:false,fillColor:'#9b7bff',fillOpacity:.38})
    .bindPopup(`<b>${r.name}</b><br>${r.pop.toFixed(1)}M people · not yet`).addTo(map));
  vis.forEach(r=>L.circleMarker([r.lat,r.lng],{radius:2.5+5*Math.sqrt(r.pop/pm),color:'#ffb36b',weight:1,fillColor:'#ffcf8a',fillOpacity:.95})
    .bindPopup(`<b>${r.name}</b><br>${r.cnt.toLocaleString()} check-ins · ${r.pop.toFixed(1)}M people`).addTo(map));
})();
(function(){const _q=new URLSearchParams(location.search).get('q');if(_q){const _inp=document.getElementById('srch');if(_inp){_inp.value=_q;doSearch(_q);}}})();
</script>
