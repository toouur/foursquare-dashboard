// ── 25. Cohort Retention Heatmap ────────────────────────────────────────────
(function(){
  var cr=S.cohort_retention||[];if(!cr.length)return;
  document.getElementById('cohortCard').style.display='';
  var years=cr.map(function(r){return r.cohort;});
  var html='<table style="border-collapse:collapse;font-family:\'DM Mono\',monospace;font-size:.62rem;width:100%;min-width:'+(140+years.length*52)+'px;">';
  html+='<thead><tr><th style="padding:4px 8px;text-align:left;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;">Cohort</th>';
  for(var c=0;c<years.length;c++){
    html+='<th style="padding:4px 6px;text-align:center;color:var(--muted);font-weight:400;">'+years[c]+'</th>';
  }
  html+='<th style="padding:4px 8px;text-align:right;color:var(--muted);">Size</th></tr></thead><tbody>';
  for(var r=0;r<cr.length;r++){
    html+='<tr><td style="padding:3px 8px;color:var(--gold);font-weight:600;">'+cr[r].cohort+'</td>';
    for(var c=0;c<cr[r].by_year.length;c++){
      var v=cr[r].by_year[c];
      if(v===null){html+='<td style="padding:3px 6px;text-align:center;color:rgba(122,133,168,.15);">·</td>';continue;}
      var alpha=(0.05+0.85*(v/100)).toFixed(3);
      var color=v>0?'var(--text)':'rgba(122,133,168,.25)';
      html+='<td style="padding:3px 6px;text-align:center;background:rgba(78,205,196,'+alpha+');color:'+color+';border-radius:3px;">'+v+'%</td>';
    }
    html+='<td style="padding:3px 8px;text-align:right;color:var(--muted);">'+cr[r].size.toLocaleString()+'</td></tr>';
  }
  html+='</tbody></table>';
  document.getElementById('cohortHeat').innerHTML=html;
})();

