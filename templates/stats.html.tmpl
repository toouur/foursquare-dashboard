    <div id="dormantList"></div>
  </div>

</div><!-- /.grid -->

<script>
const S={{STATS}};

(function(){
  var el = document.getElementById('page-insight');
  if (!el) return;
  var byYear = S.by_year || [];
  var peak = byYear.length ? byYear.reduce(function(a,b){return b[1]>a[1]?b:a;}) : ['?',0];
  var span = byYear.length >= 2 ? (byYear[byYear.length-1][0] - byYear[0][0] + 1) : 0;
  var earthX = Math.round((S.total_km||0)/40075);
  el.textContent = (S.total||0).toLocaleString() + ' check-ins over ' + span + ' years. '
    + 'Peak year: ' + peak[0] + ' (' + (peak[1]||0).toLocaleString() + ' check-ins). '
    + (S.unique_places_count||0).toLocaleString() + ' unique venues, '
    + (S.countries||[]).length + ' countries, '
    + Math.round(S.total_km||0).toLocaleString() + '\u202fkm — ' + earthX + '\u00d7 around Earth.';
})();

// ── XSS-safe string escape ──────────────────────────────────────────────────
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}

// ── Chart.js defaults ───────────────────────────────────────────────────────
Chart.defaults.color='#7a85a8';
Chart.defaults.borderColor='#1e2335';
Chart.defaults.font.family="'DM Mono',monospace";
Chart.defaults.font.size=11;

const PAL=['#e63946','#f4831f','#e8b86d','#f5d48a','#a8d8a8','#4ecdc4','#45b7d1','#96ceb4','#ff6b9d','#c44dff','#4d79ff','#ff4d4d','#ffaa00','#00c9a7'];
const CC=['#e8b86d','#4ecdc4','#e63946','#45b7d1','#a8d8a8','#c44dff','#f4831f','#96ceb4'];

// ── 1. Check-ins by Year ────────────────────────────────────────────────────
new Chart(document.getElementById('yearChart'),{
  type:'bar',
  data:{
    labels:S.by_year.map(x=>x[0]),
    datasets:[{
      data:S.by_year.map(x=>x[1]),
      backgroundColor:S.by_year.map((_,i)=>PAL[i%PAL.length]),
      borderRadius:5,borderWidth:0
    }]
  },
  options:{
    responsive:true,
    plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>' '+ctx.parsed.y.toLocaleString()+' check-ins'}}},
    scales:{x:{grid:{display:false}},y:{grid:{color:'#1a1e2e'}}}
  }
});

// ── YoY delta table ─────────────────────────────────────────────────────────
(function(){
  var d=S.by_year||[];if(d.length<2)return;
  var rows='<table style="width:100%;border-collapse:collapse;font-family:\'DM Mono\',monospace;font-size:.65rem;">'
    +'<thead><tr style="color:var(--muted);text-transform:uppercase;letter-spacing:.08em;">'
    +'<th style="padding:4px 8px;text-align:left;">Year</th>'
    +'<th style="padding:4px 8px;text-align:right;">Check-ins</th>'
    +'<th style="padding:4px 8px;text-align:right;">vs prev</th>'
    +'<th style="padding:4px 8px;text-align:right;">Δ%</th>'
    +'</tr></thead><tbody>';
  for(var i=0;i<d.length;i++){
    var yr=d[i][0],cnt=d[i][1];
    var delta=i>0?cnt-d[i-1][1]:null;
    var pct=i>0&&d[i-1][1]?((delta/d[i-1][1])*100):null;
    var col=delta===null?'var(--muted)':delta>=0?'#4ecdc4':'#e63946';
    var sign=delta===null?'':delta>=0?'+':'';
    var bg=i%2===0?'rgba(255,255,255,.02)':'transparent';
    rows+='<tr style="background:'+bg+';">'
      +'<td style="padding:4px 8px;color:var(--gold);">'+yr+'</td>'
      +'<td style="padding:4px 8px;text-align:right;">'+cnt.toLocaleString()+'</td>'
      +'<td style="padding:4px 8px;text-align:right;color:'+col+';">'+(delta===null?'—':sign+delta.toLocaleString())+'</td>'
      +'<td style="padding:4px 8px;text-align:right;color:'+col+';">'+(pct===null?'—':sign+pct.toFixed(1)+'%')+'</td>'
      +'</tr>';
  }
  rows+='</tbody></table>';
  var el=document.getElementById('yoyTable');if(el)el.innerHTML=rows;
})();

// ── 2. Monthly Trend ────────────────────────────────────────────────────────
new Chart(document.getElementById('monthChart'),{
  type:'line',
  data:{
    labels:S.by_month.map(x=>x[0]),
    datasets:[{
      data:S.by_month.map(x=>x[1]),
      borderColor:'#4ecdc4',
      backgroundColor:'rgba(78,205,196,0.07)',
      borderWidth:2,pointRadius:0,fill:true,tension:0.4
    }]
  },
  options:{
    responsive:true,
    plugins:{legend:{display:false}},
    scales:{x:{grid:{display:false},ticks:{maxTicksLimit:12,maxRotation:0}},y:{grid:{color:'#1a1e2e'}}}
  }
});

// ── 3. Hour of Day ──────────────────────────────────────────────────────────
new Chart(document.getElementById('hourChart'),{
  type:'bar',
  data:{
    labels:S.by_hour.map(x=>x[0]+':00'),
    datasets:[{
