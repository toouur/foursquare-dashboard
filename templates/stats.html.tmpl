      data:S.cat_groups.map(x=>x[1]),
      backgroundColor:S.cat_groups.map((_,i)=>CC[i%CC.length]),
      borderRadius:5,borderWidth:0
    }]
  },
  options:{
    indexAxis:'y',
    responsive:true,
    plugins:{
      legend:{display:false},
      tooltip:{callbacks:{label:ctx=>' '+ctx.parsed.x.toLocaleString()+' check-ins'}}
    },
    scales:{
