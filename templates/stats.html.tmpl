// ── 29. Companion Lifecycle ─────────────────────────────────────────────────
(function(){
  var cl=S.companion_lifecycle||[];if(!cl.length)return;
  document.getElementById('compLifeCard').style.display='';
  // Lifeline-style horizontal bars: x = first_ts → last_ts
  var allFirst=Math.min.apply(null,cl.map(function(c){return c.first_ts;}));
  var allLast =Math.max.apply(null,cl.map(function(c){return c.last_ts;}));
  var span=allLast-allFirst||1;
  function fmt(ts){var d=new Date(ts*1000);return d.toLocaleDateString('en-GB',{month:'short',year:'numeric'});}
  var html='<div style="display:flex;flex-direction:column;gap:5px;font-family:\'DM Mono\',monospace;font-size:.65rem;">';
  // Header timeline (rough years)
  cl.forEach(function(c){
    var a=(c.first_ts-allFirst)/span*100;
    var w=Math.max(0.6,(c.last_ts-c.first_ts)/span*100);
    html+='<div style="display:grid;grid-template-columns:130px 1fr 60px;align-items:center;gap:8px;padding:5px 8px;background:var(--card2);border-radius:6px;">'
      +'<div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--gold);">'+esc(c.name)+'</div>'
      +'<div style="position:relative;height:14px;background:rgba(78,205,196,.06);border-radius:7px;">'
      +'<div style="position:absolute;left:'+a.toFixed(2)+'%;width:'+w.toFixed(2)+'%;height:14px;background:var(--teal);border-radius:7px;opacity:.7;" title="'+fmt(c.first_ts)+' → '+fmt(c.last_ts)+'"></div>'
      +'</div>'
      +'<div style="text-align:right;color:var(--muted);">'+c.n.toLocaleString()+'×</div>'
      +'</div>'
      +'<div style="display:grid;grid-template-columns:130px 1fr 60px;gap:8px;padding:0 8px;font-size:.55rem;color:var(--muted);">'
      +'<div></div>'
      +'<div>'+fmt(c.first_ts)+' → '+fmt(c.last_ts)+(c.top_city?' · '+esc(c.top_city):'')+(c.med_gap?' · median '+c.med_gap+'d gap':'')+'</div>'
      +'<div></div>'
      +'</div>';
  });
  html+='</div>';
  document.getElementById('compLifeList').innerHTML=html;
})();

