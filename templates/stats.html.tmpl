        borderRadius:5,borderWidth:0
      }]
    },
    options:{
      responsive:true,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>' '+(ctx.parsed.y).toLocaleString()+' km'}}},
      scales:{x:{grid:{display:false}},y:{grid:{color:'#1a1e2e'},ticks:{callback:v=>v>=1000?(v/1000).toFixed(0)+'k':v}}}
    }
  });
}

// ── 6. Countries per Year ───────────────────────────────────────────────────
if(S.countries_per_year&&S.countries_per_year.length){
  new Chart(document.getElementById('ctrPerYearChart'),{
    type:'bar',
    data:{
      labels:S.countries_per_year.map(x=>x[0]),
      datasets:[{
        data:S.countries_per_year.map(x=>x[1]),
        backgroundColor:'rgba(78,205,196,0.7)',
        borderRadius:5,borderWidth:0
      }]
    },
    options:{
      responsive:true,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>' '+ctx.parsed.y+' countries'}}},
      scales:{x:{grid:{display:false}},y:{grid:{color:'#1a1e2e'},ticks:{stepSize:1}}}
    }
  });
}

// ── 7. Activity Streaks ─────────────────────────────────────────────────────
if(S.longest_streak!=null){
  document.getElementById('longestStreak').textContent=S.longest_streak;
  document.getElementById('currentStreak').textContent=S.current_streak||0;
  const activeDays=Object.entries(S.heatmap).sort().map(([yr,days])=>[yr,Object.values(days).filter(v=>v>0).length]);
  new Chart(document.getElementById('streakCalChart'),{
    type:'bar',
    data:{
      labels:activeDays.map(x=>x[0]),
      datasets:[{
        data:activeDays.map(x=>x[1]),
        backgroundColor:'rgba(232,184,109,0.55)',
        borderRadius:4,borderWidth:0,label:'Active days'
      }]
    },
    options:{
      responsive:true,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>' '+ctx.parsed.y+' active days'}}},
      scales:{x:{grid:{display:false}},y:{grid:{color:'#1a1e2e'}}}
    }
  });
}

// ── 8. Category Mix by Year (stacked 100% bar) ──────────────────────────────
if(S.cat_drift&&S.cat_drift.length&&S.cat_drift_groups){
  const DRIFT_PAL=['#e8b86d','#4ecdc4','#e63946','#45b7d1','#a8d8a8','#c44dff','#f4831f'];
  const labels=S.cat_drift.map(x=>x[0]);
  const datasets=S.cat_drift_groups.map((grp,gi)=>({
    label:grp,
    data:S.cat_drift.map(([_yr,counts])=>{
      const total=S.cat_drift_groups.reduce((s,g)=>s+(counts[g]||0),0);
      return total?+((counts[grp]||0)/total*100).toFixed(1):0;
    }),
    backgroundColor:DRIFT_PAL[gi%DRIFT_PAL.length],
    borderWidth:0,
  }));
  new Chart(document.getElementById('catDriftChart'),{
    type:'bar',
    data:{labels,datasets},
    options:{
      responsive:true,
      plugins:{
        legend:{position:'bottom',labels:{font:{size:10},boxWidth:10,padding:8}},
        tooltip:{callbacks:{label:ctx=>` ${ctx.dataset.label}: ${ctx.parsed.y}%`}}
      },
      scales:{
        x:{stacked:true,grid:{display:false}},
        y:{stacked:true,grid:{color:'#1a1e2e'},ticks:{callback:v=>v+'%'},max:100}
      }
    }
  });
}

// ── 9. Discovery Rate ───────────────────────────────────────────────────────
new Chart(document.getElementById('discoveryChart'),{
  type:'bar',
  data:{
    labels:S.discovery_rate.map(x=>x[0]),
    datasets:[
      {label:'New venues', data:S.discovery_rate.map(x=>x[1]),backgroundColor:'rgba(78,205,196,0.75)',borderWidth:0,borderRadius:2},
      {label:'Revisits',   data:S.discovery_rate.map(x=>x[2]),backgroundColor:'rgba(232,184,109,0.45)',borderWidth:0,borderRadius:2},
    ]
  },
  options:{
    responsive:true,
    plugins:{
      legend:{display:true,labels:{color:'#7a85a8',font:{family:"'DM Mono',monospace",size:10}}},
      tooltip:{callbacks:{label:ctx=>' '+ctx.dataset.label+': '+ctx.parsed.y.toLocaleString()}}
    },
    scales:{
      x:{stacked:true,grid:{display:false},ticks:{maxTicksLimit:24,maxRotation:0,font:{size:10}}},
      y:{stacked:true,grid:{color:'#1a1e2e'}}
    }
  }
});

// ── 10. Venue Loyalty ───────────────────────────────────────────────────────
(function(){
  const data=S.venue_loyalty;
  document.getElementById('loyaltyGrid').innerHTML=data.map(([name,city,years,total],i)=>
    `<div class="loyalty-row">
      <span class="lr-rank">#${i+1}</span>
