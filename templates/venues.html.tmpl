<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Venues — Check-in Journal</title>
<meta name="description" content="All unique venues from {{CHECKINS_PLUS}} personal Foursquare check-ins, ranked by visit count with links to Foursquare.">
<link rel="canonical" href="https://4sq.pages.dev/venues.html">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Check-in Journal">
<meta property="og:title" content="Venues — Check-in Journal">
<meta property="og:description" content="All unique venues from {{CHECKINS_PLUS}} personal Foursquare check-ins, ranked by visit count with links to Foursquare.">
<meta property="og:url" content="https://4sq.pages.dev/venues.html">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Venues — Check-in Journal">
<meta name="twitter:description" content="All unique venues from {{CHECKINS_PLUS}} personal Foursquare check-ins, ranked by visit count with links to Foursquare.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&family=DM+Sans:wght@400;600&family=DM+Mono&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/6.6.6/css/flag-icons.min.css" integrity="sha512-uvXdJud8WaOlQFjlz9B15Yy2Au/bMAvz79F7Xa6OakCl2jvQPdHD0hb3dEqZRdSwG4/sknePXlE7GiarwA/9Wg==" crossorigin="anonymous">

<link rel="stylesheet" href="{{SITE_CSS_LINK}}">
<style>

:root{--bg:#0c0e14;--card:#12141c;--card2:#181a24;--border:#222738;--text:#e0e2ec;--muted:#8b93a8;--gold:#e8b86d;--teal:#4ec9b0;}
body.light{--bg:#ddd8cf;--card:#f0ece3;--card2:#e5e0d7;--border:#aaa49a;--gold:#7a3e00;--teal:#155c58;--muted:#54576a;--text:#15172a;--text2:#373b58;}
body.light header{background:linear-gradient(160deg,#d6d1c8 0%,#dedad1 70%);}
body.light .side-nav{background:rgba(220,215,208,0.97);}
body.light .side-nav a:hover,body.light .side-nav button:hover{background:rgba(0,0,0,.08);}
body.light .heatmap-tooltip,body.light .map-status{background:rgba(220,215,208,0.97);}
body.light .card{box-shadow:0 2px 8px rgba(0,0,0,.10);}
body.light a{color:var(--teal);}

*{box-sizing:border-box;margin:0;padding:0;}

body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;}

.topnav{display:flex;align-items:center;gap:20px;padding:18px 40px;border-bottom:1px solid var(--border);background:var(--card);}
.topnav-logo{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--gold);text-decoration:none;}
.topnav a{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);text-decoration:none;transition:color .2s;}
.topnav a:hover{color:var(--gold);}
.topnav-current{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--text);}
.gs-btn{font-family:'DM Mono',monospace;font-size:.60rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:7px 14px;cursor:pointer;display:flex;align-items:center;gap:7px;transition:all .2s;white-space:nowrap;}
.gs-btn:hover{border-color:var(--gold);color:var(--gold);}
.gs-btn kbd{font-family:'DM Mono',monospace;font-size:.52rem;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:3px;padding:1px 5px;letter-spacing:0;}
@media(max-width:520px){.gs-btn kbd{display:none;}}
.gs-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10000;backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding-top:16vh;}.gs-overlay.open{display:flex;}
.gs-modal{background:var(--card);border:1px solid var(--border);border-radius:14px;width:min(560px,92vw);overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.7);}
.gs-input-wrap{display:flex;align-items:center;gap:10px;padding:14px 18px;}
.gs-icon{font-size:1rem;color:var(--muted);}
.gs-input{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-family:'DM Sans',sans-serif;font-size:.95rem;}
.gs-input::placeholder{color:var(--muted);}
.gs-esc-hint{font-family:'DM Mono',monospace;font-size:.52rem;color:var(--muted);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:3px;padding:2px 6px;cursor:pointer;flex-shrink:0;}

/* page — the side rail is fixed at the right edge above 900px, so keep clear of it */
.wrap{max-width:1240px;margin:0 auto;padding:34px 40px 80px;}
@media(min-width:901px){.wrap{padding-right:max(40px,calc(72px - (100vw - 1240px) / 2));}}
.eyebrow{font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);}
h1.hero{font-family:'Playfair Display',serif;font-weight:900;font-size:clamp(2.3rem,5.6vw,4.2rem);line-height:1;letter-spacing:-.02em;margin:10px 0 12px;}
h1.hero em{font-style:normal;background:linear-gradient(135deg,#f6d38b,#ff9a6b 55%,#ff6fae);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.page-insight{color:var(--muted);font-size:.9rem;line-height:1.5;max-width:760px;}
.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:24px 0 22px;}
.kpi{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:16px 18px;}
.kpi b{display:block;font-family:'Playfair Display',serif;font-size:2rem;font-weight:900;line-height:1;background:linear-gradient(135deg,#f6d38b,#ff9a6b 55%,#ff6fae);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.kpi:nth-child(2) b{background:linear-gradient(135deg,#4cb8ff,#9b7bff);-webkit-background-clip:text;background-clip:text;}
.kpi:nth-child(3) b{background:linear-gradient(135deg,#2fd6b5,#4cb8ff);-webkit-background-clip:text;background-clip:text;}
.kpi span{display:block;font-family:'DM Mono',monospace;font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:8px;}
.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px;}
.search-box{flex:1;min-width:220px;background:var(--card);border:1px solid var(--border);border-radius:999px;padding:11px 18px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:.86rem;outline:none;transition:border-color .15s;}
.search-box:focus{border-color:var(--gold);}
.pill{background:var(--card2);border:1px solid var(--border);border-radius:999px;padding:7px 13px;font-family:'DM Mono',monospace;font-size:.62rem;cursor:pointer;color:var(--muted);white-space:nowrap;}
.pill.active{background:linear-gradient(135deg,#f6d38b,#ff9a6b);border-color:transparent;color:#1a1206;}
.pill:hover:not(.active){border-color:var(--gold);color:var(--text);}
.count-lbl{font-family:'DM Mono',monospace;font-size:.62rem;color:var(--muted);}
.cats{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding-bottom:4px;margin-bottom:22px;}
.cats::-webkit-scrollbar{display:none;}
.cats .pill b{font-weight:400;opacity:.65;margin-left:4px;}
/* podium */
.podium{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:14px;margin-bottom:18px;}
.pd{position:relative;display:block;border-radius:22px;overflow:hidden;aspect-ratio:4/3;color:#fff;text-decoration:none;isolation:isolate;background:linear-gradient(135deg,#4cb8ff,#9b7bff);transition:transform .25s;}
.pd:hover{transform:translateY(-3px);}
.pd img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .6s;}
.pd:hover img{transform:scale(1.05);}
.pd::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,transparent 30%,rgba(9,11,16,.93));}
.pd .medal{position:absolute;top:12px;left:12px;font-size:1.6rem;}
.pdb{position:absolute;left:0;right:0;bottom:0;padding:16px;}
.pdn{font-family:'Playfair Display',serif;font-weight:900;font-size:1.5rem;line-height:1.1;color:#fff;}
.pd.p1 .pdn{font-size:2rem;}
.pdc{font-size:.74rem;color:#d0d4e0;margin:4px 0 8px;display:flex;align-items:center;gap:6px;}
.pdk{font-family:'Playfair Display',serif;font-weight:900;font-size:1.8rem;line-height:1;color:#ffc27d;}
.pdk small{font-family:'DM Mono',monospace;font-weight:400;font-size:.58rem;color:#d0d4e0;}
/* rows */
.vr{display:grid;grid-template-columns:34px 44px minmax(0,1fr) 170px 160px;gap:14px;align-items:center;padding:8px 12px;border-radius:14px;color:var(--text);text-decoration:none;}
.vr:hover{background:var(--card);}
.vr+.vr{border-top:1px solid var(--border);}
.rk{font-family:'DM Mono',monospace;font-size:.7rem;color:var(--muted);text-align:right;}
.vr img,.vr .ph0{width:44px;height:44px;border-radius:12px;object-fit:cover;background:var(--card2);display:block;}
.vn{min-width:0;}
.vn b{display:block;font-size:.9rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.vr:hover .vn b{color:var(--gold);}
.vn small{display:flex;gap:6px;align-items:center;font-size:.7rem;color:var(--muted);white-space:nowrap;overflow:hidden;}
.vn small .c{color:var(--teal);}
.ys{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:2px;height:16px;}
.ys i{border-radius:2px;background:var(--card2);}
.ys i.on{background:#2fd6b5;}
.vk{display:flex;align-items:center;gap:10px;}
.bar{flex:1;height:6px;border-radius:3px;background:var(--card2);overflow:hidden;}
.bar i{display:block;height:100%;background:linear-gradient(90deg,#f6d38b,#ff9a6b 60%,#ff6fae);}
.vk b{font-family:'DM Mono',monospace;font-size:.78rem;color:var(--gold);min-width:40px;text-align:right;}
.more{display:block;margin:18px auto 0;background:var(--card2);border:1px solid var(--border);border-radius:999px;padding:10px 22px;font-family:'DM Mono',monospace;font-size:.64rem;letter-spacing:.06em;color:var(--text);cursor:pointer;}
.more:hover{border-color:var(--gold);color:var(--gold);}
.empty{text-align:center;padding:50px;color:var(--muted);}
.fi{border-radius:2px;}

@media(max-width:900px){
  .wrap{padding:24px 16px 60px;}
  .topnav{padding:14px 16px;}
  .kpis{grid-template-columns:repeat(2,minmax(0,1fr));}
  .podium{grid-template-columns:1fr;}
  .vr{grid-template-columns:28px 40px minmax(0,1fr) 54px;gap:10px;padding:8px 6px;}
  .vr img,.vr .ph0{width:40px;height:40px;}
  .ys,.bar{display:none;}
  .vk b{min-width:0;}
}
</style>

</head>

<body>

<nav class="topnav">
  <a href="index.html" class="topnav-logo">Check-in Journal</a>
  <span class="topnav-current">Venues</span>
  <button class="gs-btn" style="margin-left:auto" onclick="gsOpen()"><span>⌕</span> Search<kbd>⌘K</kbd></button>
</nav>
<div class="gs-overlay" id="gsOverlay" onclick="if(event.target===this)gsClose()">
  <div class="gs-modal"><div class="gs-input-wrap"><span class="gs-icon">⌕</span><input class="gs-input" id="gsInput" type="text" placeholder="Search venues, cities, trips…" autocomplete="off" spellcheck="false"><span class="gs-esc-hint" onclick="gsClose()">esc</span></div></div>
</div>

<div class="wrap">
  <div class="eyebrow">Places · every venue ever checked into</div>
  <h1 class="hero" id="hero">Places</h1>
  <div class="page-insight" id="page-insight"></div>
  <div class="kpis" id="kpis"></div>
  <div class="controls">
    <input class="search-box" id="srch" type="text" placeholder="Search venues, cities, categories…" oninput="doSearch(this.value)">
    <div class="pill active" id="sort-count" onclick="setSort('count')">Most visited</div>
    <div class="pill" id="sort-years" onclick="setSort('years')">Years loyal</div>
    <div class="pill" id="sort-name" onclick="setSort('name')">A–Z</div>
    <span class="count-lbl" id="countLbl"></span>
  </div>
  <div class="cats" id="cats"></div>
  <div class="podium" id="podium"></div>
  <div id="rows"></div>
  <button class="more" id="more" hidden onclick="more()"></button>
</div>

<script>
// [name, city, country, category, count, [years], vid, photo] — the top venues only;
// the full list (no photo column) is venues_data.json, fetched on first need.
const TOP=VENUES_DATA_PLACEHOLDER;
const META=VENUES_META_PLACEHOLDER;
const VER=VENUES_VER_PLACEHOLDER;
const PIX=PIX_URL_PLACEHOLDER;
const ISO2={{CTRY_CODE_JSON}};
const PAGE=60, Y0=2007, Y1=new Date().getFullYear();
function fi(c){const code=ISO2[c];return code?`<span class="fi fi-${code}"></span>`:'';}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
const fmt=n=>Number(n).toLocaleString('en-US');

document.getElementById('hero').innerHTML=`${fmt(META.total)} places, <em>top ${TOP.length}</em>`;
document.getElementById('page-insight').textContent=`The places that became rituals — “${TOP[0][0]}” leads with ${fmt(TOP[0][4])} check-ins. Every one of the ${fmt(META.total)} venues is a search away.`;
document.getElementById('kpis').innerHTML=[[fmt(META.total),'places'],[fmt(META.ten_plus),'visited 10+ times'],[fmt(META.categories),'categories'],[META.max_years,'years at one place']]
  .map(([a,b])=>`<div class="kpi"><b>${a}</b><span>${b}</span></div>`).join('');
document.getElementById('cats').innerHTML=`<div class="pill active" data-c="">All</div>`+META.cats.map(([c,n])=>`<div class="pill" data-c="${esc(c)}">${esc(c)}<b>${fmt(n)}</b></div>`).join('');
document.querySelectorAll('#cats .pill').forEach(p=>p.onclick=()=>{
  document.querySelectorAll('#cats .pill').forEach(x=>x.classList.toggle('active',x===p));
  cat=p.dataset.c; refresh();
});

let ALL=null, loading=null, sortKey='count', sortDir=-1, searchQ='', cat='', data=TOP, shown=0;
function full(){   // the whole list, fetched once
  if(!loading) loading=fetch('venues_data.json?v='+VER).then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
    .then(j=>{const ph={};TOP.forEach(v=>ph[v[6]]=v[7]);ALL=j.map(v=>v.concat([ph[v[6]]||'']));return ALL;});
  return loading;
}
function setSort(k){
  if(sortKey===k) sortDir*=-1; else {sortKey=k; sortDir=k==='name'?1:-1;}
  document.querySelectorAll('.controls .pill').forEach(p=>p.classList.toggle('active',p.id==='sort-'+k));
  refresh();
}
function doSearch(q){searchQ=q.toLowerCase().trim();refresh();}
function isDefault(){return sortKey==='count'&&sortDir===-1&&!searchQ&&!cat;}
async function refresh(){
  let src=TOP;
  if(!isDefault()){
    document.getElementById('countLbl').textContent='loading all places…';
    try{src=await full();}catch(e){document.getElementById('countLbl').textContent='could not load the full list ('+e.message+')';src=TOP;}
  }
  let d=src;
  if(searchQ) d=d.filter(v=>v[0].toLowerCase().includes(searchQ)||v[1].toLowerCase().includes(searchQ)||v[2].toLowerCase().includes(searchQ)||v[3].toLowerCase().includes(searchQ));
  if(cat) d=d.filter(v=>v[3]===cat);
  d=d.slice().sort((a,b)=>sortKey==='count'?sortDir*(a[4]-b[4]):sortKey==='years'?(sortDir*(a[5].length-b[5].length)||(b[4]-a[4])):sortDir*a[0].localeCompare(b[0]));
  data=d; shown=0;
  document.getElementById('countLbl').textContent=fmt(d.length)+(isDefault()?' of '+fmt(META.total):'')+' places';
  const pod=isDefault()?d.slice(0,3):[];
  document.getElementById('podium').style.display=pod.length?'':'none';
  document.getElementById('podium').innerHTML=pod.map((v,i)=>`<a class="pd p${i+1}" href="/venue.html#${esc(v[6])}">${v[7]&&PIX?`<img loading="lazy" src="${esc(PIX+'/t/'+v[7])}" alt="">`:''}<span class="medal">${['🥇','🥈','🥉'][i]}</span>
    <div class="pdb"><div class="pdn">${esc(v[0])}</div><div class="pdc">${fi(v[2])} ${esc(v[1]||v[2])} · ${esc(v[3])}</div><div class="pdk">${fmt(v[4])}<small> check-ins · ${v[5].length} year${v[5].length===1?'':'s'}</small></div></div></a>`).join('');
  document.getElementById('rows').innerHTML=d.length?'':'<div class="empty">No venues found</div>';
  more();
}
function row(v,i){
  const ys=new Set(v[5]);let strip='';for(let y=Y0;y<=Y1;y++)strip+=`<i class="${ys.has(y)?'on':''}" title="${y}"></i>`;
  const top=data.length?data[0][4]:1;
  return `<a class="vr" href="/venue.html#${esc(v[6])}"><span class="rk">${i+1}</span>${v[7]&&PIX?`<img loading="lazy" src="${esc(PIX+'/t/'+v[7])}" alt="">`:'<span class="ph0"></span>'}
    <div class="vn"><b>${esc(v[0])}</b><small>${fi(v[2])} ${esc(v[1]||v[2])} · <span class="c">${esc(v[3])}</span></small></div>
    <div class="ys" title="years with check-ins">${strip}</div>
    <div class="vk"><span class="bar"><i style="width:${Math.max(2,Math.round(100*v[4]/Math.max(1,top)))}%"></i></span><b>${fmt(v[4])}</b></div></a>`;
}
async function more(){
  const skip=isDefault()&&shown===0?3:0;          // the podium already shows the top three
  if(isDefault()&&shown>=data.length&&data.length<META.total){   // past the inline top: continue in the full list
    try{data=await full();}catch(e){}
  }
  const start=shown+skip, chunk=data.slice(start,start+PAGE);
  document.getElementById('rows').insertAdjacentHTML('beforeend',chunk.map((v,k)=>row(v,start+k)).join(''));
  shown=start+chunk.length;
  const left=(isDefault()?META.total:data.length)-shown, b=document.getElementById('more');
  b.hidden=left<=0; b.textContent='SHOW MORE · '+fmt(left)+' LEFT';
}
refresh();
(function(){const _q=new URLSearchParams(location.search).get('q');if(_q){const _inp=document.getElementById('srch');if(_inp){_inp.value=_q;doSearch(_q);}}})();
</script>

<script>
function gsOpen(){document.getElementById('gsOverlay').classList.add('open');document.getElementById('gsInput').focus();}
function gsClose(){document.getElementById('gsOverlay').classList.remove('open');}
document.getElementById('gsInput').addEventListener('keydown',function(e){if(e.key==='Enter'&&this.value.trim()){location.href='search.html?q='+encodeURIComponent(this.value.trim());}if(e.key==='Escape')gsClose();});
document.addEventListener('keydown',function(e){if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();gsOpen();}if(e.key==='Escape'&&document.getElementById('gsOverlay').classList.contains('open'))gsClose();});
</script>
